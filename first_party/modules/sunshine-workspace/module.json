{
  "schema_version": 2,
  "id": "sunshine.workspace",
  "display_name": "Sunshine Workspaces",
  "description": {
    "ko": "탭을 작업 공간으로 묶고 그 사이를 오갑니다. 크로미움의 탭 모델을 대체하지 않고 그 위에 소속 정보를 얹는 방식이라, 세션 복원과 탭 그룹은 그대로 동작합니다.",
    "en": "Groups tabs into workspaces and moves between them. It does not replace Chromium's tab model — it records membership alongside it — so session restore and tab groups keep working as they did."
  },
  "owner": "sunshine",
  "kind": "service",
  "lifecycle": "profile",
  "status": "prepared",
  "entrypoints": [
    {
      "type": "native_command",
      "target": "workspace.create"
    },
    {
      "type": "native_command",
      "target": "workspace.switch"
    },
    {
      "type": "native_command",
      "target": "workspace.tab.move"
    },
    {
      "type": "native_command",
      "target": "workspace.close"
    }
  ],
  "capabilities": [
    {
      "name": "chromium.tabs.strip_model",
      "access": "read"
    },
    {
      "name": "chromium.sessions.tab_extra_data",
      "access": "write"
    }
  ],
  "data": [
    {
      "owner": "sunshine",
      "scope": "profile",
      "access": "write",
      "retention": "persistent"
    },
    {
      "owner": "chromium",
      "scope": "tab",
      "access": "write",
      "retention": "persistent"
    }
  ],
  "security": {
    "remote_content": false,
    "requires_user_activation": true,
    "profile_modes": [
      "regular",
      "incognito"
    ],
    "network": {
      "access": "deny",
      "allow": []
    },
    "filesystem": {
      "access": "none"
    },
    "credentials": {
      "direct_access": false
    }
  },
  "verification": {
    "native_build": "pending",
    "runtime": "pending",
    "visual": "pending"
  }
}
