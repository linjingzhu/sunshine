{
  "schema_version": 2,
  "id": "sunshine.workspace",
  "display_name": "Sunshine Workspaces",
  "owner": "sunshine",
  "kind": "service",
  "lifecycle": "profile",
  "status": "prepared",
  "entrypoints": [
    {
      "type": "native_command",
      "target": "workspace.create"
    },
    {
      "type": "native_command",
      "target": "workspace.switch"
    },
    {
      "type": "native_command",
      "target": "workspace.tab.move"
    },
    {
      "type": "native_command",
      "target": "workspace.close"
    }
  ],
  "capabilities": [
    {
      "name": "chromium.tabs.strip_model",
      "access": "read"
    },
    {
      "name": "chromium.sessions.tab_extra_data",
      "access": "write"
    }
  ],
  "data": [
    {
      "owner": "sunshine",
      "scope": "profile",
      "access": "write",
      "retention": "persistent"
    },
    {
      "owner": "chromium",
      "scope": "tab",
      "access": "write",
      "retention": "persistent"
    }
  ],
  "security": {
    "remote_content": false,
    "requires_user_activation": true,
    "profile_modes": [
      "regular",
      "incognito"
    ],
    "network": {
      "access": "deny",
      "allow": []
    },
    "filesystem": {
      "access": "none"
    },
    "credentials": {
      "direct_access": false
    }
  },
  "verification": {
    "native_build": "pending",
    "runtime": "pending",
    "visual": "pending"
  }
}
