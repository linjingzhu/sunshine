{
  "schema_version": 2,
  "id": "sunshine.security",
  "display_name": "Sunshine Security Center",
  "description": {
    "ko": "브라우저가 이미 알고 있는 보안 상태를 한 곳에 모아 보여줍니다. 판정은 크로미움의 것이고 이 화면은 그것을 옮겨 적을 뿐입니다 — 스스로 차단하지 않고, 스스로 안전하다고 말하지 않습니다.",
    "en": "Gathers the security state the browser already knows into one place. Every verdict is Chromium's and this surface only reports it: it blocks nothing of its own and calls nothing safe on its own authority."
  },
  "owner": "sunshine",
  "kind": "surface",
  "lifecycle": "profile",
  "status": "prepared",
  "entrypoints": [
    {
      "type": "chromium_webui",
      "target": "chrome://sunshine-security"
    },
    {
      "type": "native_command",
      "target": "security_center.open"
    }
  ],
  "capabilities": [
    {
      "name": "chromium.safe_browsing.state",
      "access": "read"
    }
  ],
  "data": [
    {
      "owner": "chromium",
      "scope": "profile",
      "access": "read",
      "retention": "none"
    }
  ],
  "security": {
    "remote_content": false,
    "requires_user_activation": false,
    "profile_modes": [
      "regular"
    ],
    "network": {
      "access": "deny",
      "allow": []
    },
    "filesystem": {
      "access": "none"
    },
    "credentials": {
      "direct_access": false
    }
  },
  "verification": {
    "native_build": "pending",
    "runtime": "pending",
    "visual": "pending"
  }
}
