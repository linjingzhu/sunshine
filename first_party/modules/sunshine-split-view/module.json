{
  "schema_version": 1,
  "id": "sunshine.split_view",
  "display_name": "Sunshine Split View",
  "owner": "sunshine",
  "kind": "service",
  "lifecycle": "window",
  "status": "prepared",
  "entrypoints": [
    {"type": "native_command", "target": "view.split.open"},
    {"type": "native_command", "target": "view.split.swap"},
    {"type": "native_command", "target": "view.split.close"}
  ],
  "capabilities": [
    {"name": "chromium.tabs.strip_model", "access": "read"},
    {"name": "chromium.sessions.window_extra_data", "access": "write"}
  ],
  "data": [
    {"owner": "sunshine", "scope": "window", "access": "write", "retention": "session"}
  ],
  "security": {
    "remote_content": false,
    "network_access": false,
    "profile_modes": ["regular", "incognito"],
    "requires_user_activation": true
  },
  "verification": {"native_build": "pending", "runtime": "pending", "visual": "pending"}
}
