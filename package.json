{
  "name": "sunshine-os",
  "version": "0.2.0",
  "private": true,
  "description": "Sunshine OS — browser-first Chromium desktop shell",
  "main": "dist/main/bootstrap/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "38.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.9"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  }
}
