#include <windows.h>

#include "resource.h"

// The engine, byte for byte as upstream built it. `mini_installer.exe` is
// staged beside this file by scripts/build_installer_frontend.ps1, which also
// writes the hash the program checks it against.
IDR_ENGINE RCDATA "mini_installer.exe"

// The banner. Compiled in (IU-6); the running program opens no image file.
IDR_BANNER RCDATA "banner.png"

IDI_SETUP ICON "sunshine.ico"

// Exactly one EDITTEXT, and it is the install root.
//
// This file used to carry none, and said so: "the install location is a label
// (IU-4) and the product name has no control at all (IU-5)". The owner reversed
// the first of those, so the blanket rule no longer expresses the surviving
// one. IU-5 stands and is now the reason there is exactly one box rather than
// none -- `scripts/verify_installer_frontend.py` counts them and checks which
// control it is, because "no text box anywhere" was a proxy for two invariants
// and only one of them is left.
//
// The product name still has no control. The executable's name is a different
// question and `docs/INSTALLER_CHOICE_PLAN.md` section 4 is what it costs.
IDD_SETUP DIALOGEX 0, 0, 340, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sunshine"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 340, 56
    LTEXT           "Install Sunshine", IDC_HEADLINE, 16, 68, 308, 12
    AUTORADIOBUTTON "Install for me only", IDC_SCOPE_USER, 16, 88, 150, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Install for all users on this computer", IDC_SCOPE_MACHINE, 16, 102, 200, 10
    EDITTEXT        IDC_LOCATION_EDIT, 28, 118, 236, 13, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Browse...", IDC_BROWSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 270, 118, 54, 13
    LTEXT           "", IDC_LOCATION_NOTE, 28, 136, 296, 10
    AUTOCHECKBOX    "Desktop shortcut", IDC_DESKTOP_SHORTCUT, 16, 158, 150, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Taskbar shortcut", IDC_TASKBAR_SHORTCUT, 16, 172, 150, 10
    AUTOCHECKBOX    "Quick Launch shortcut", IDC_QUICK_LAUNCH_SHORTCUT, 176, 158, 150, 10
    AUTOCHECKBOX    "Make Sunshine my default browser", IDC_MAKE_DEFAULT, 176, 172, 150, 10
    AUTOCHECKBOX    "Open Sunshine when this finishes", IDC_LAUNCH_WHEN_DONE, 16, 188, 200, 10
    LTEXT           "", IDC_STATUS, 16, 208, 308, 10
    // Generic CONTROL rather than DEFPUSHBUTTON/PUSHBUTTON, and the reason is
    // not style. BS_PUSHBUTTON, BS_DEFPUSHBUTTON and BS_OWNERDRAW all occupy
    // the same BS_TYPEMASK nibble -- they are alternatives, not flags -- so
    // `DEFPUSHBUTTON ... BS_OWNERDRAW` silently discarded the default-button
    // half and left the dialog with no default push button at all. Enter then
    // sent IDOK, which nothing handled, and the keyboard could not reach
    // Install. IU-14 requires every control to be operable from the keyboard.
    CONTROL         "Install", IDC_INSTALL, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_GROUP, 200, 226, 60, 16
    CONTROL         "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 268, 226, 56, 16
END
