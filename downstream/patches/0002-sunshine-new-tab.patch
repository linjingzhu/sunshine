+const SUNSHINE_BACKGROUND_PATH =
+    'chrome-untrusted://new-tab-page/custom_background_image?' +
+    'url=chrome-untrusted%3A%2F%2Fnew-tab-page%2Fsunshine-background.png' +
+    '&size=cover&repeatX=no-repeat&repeatY=no-repeat' +
+    '&positionX=center&positionY=center';
+
 const COMPOSEBOX_INERT_ALLOWLIST = [
-  '#logo',
+  '#sunshineWordmark',
   '#searchboxContainer',
 ];
 
