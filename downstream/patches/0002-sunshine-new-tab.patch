+// Sunshine's New Tab background.
+//
+// A fixed address with nothing taken from anywhere: no preference, no query
+// parameter, no user input reaches it. The bytes behind it come from
+// `sunshine::background::ReadInstalledBackground`, which looks only beside
+// chrome.exe and returns nothing unless the file's own first bytes say it is
+// a format docs/NEWTAB_BACKGROUND_CONTRACT.md permits.
+//
+// When no background is installed the source serves nothing, the helper's
+// background-image fails to load, and the iframe is transparent -- which is
+// how the feature is absent by default rather than switched off.
+// NTB-7. The owner's number, and the only place it is written.
+const SUNSHINE_REST_DELAY_MS = 3000;
+
+// NTB-9. The clock's text, in the browser's own locale and the user's own
+// 12/24-hour preference -- `undefined` asks Intl for exactly that rather than
+// hardcoding a format this page has no business choosing.
+function formatSunshineTime(): string {
+  return new Date().toLocaleTimeString(
+      undefined, {hour: 'numeric', minute: '2-digit'});
+}
+
+// Milliseconds until the next minute boundary. PB-5b's second property is one
+// wakeup per displayed change: sleeping a fixed 60000 would drift and would
+// wake at an arbitrary point inside the minute, so each wake is scheduled to
+// land just after the value actually changes.
+function untilNextSunshineMinute(): number {
+  const now = new Date();
+  return 60000 - (now.getSeconds() * 1000 + now.getMilliseconds());
+}
