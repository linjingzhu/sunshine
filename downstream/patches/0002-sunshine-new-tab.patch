diff --git a/chrome/browser/resources/new_tab_page/app.css b/chrome/browser/resources/new_tab_page/app.css
index d9d32b0..6ad1de5 100644
--- a/chrome/browser/resources/new_tab_page/app.css
+++ b/chrome/browser/resources/new_tab_page/app.css
@@ -180,6 +180,105 @@ cr-most-visited {
   z-index: unset;
 }
 
+#sunshineBackground {
+  /* Behind everything the page draws, and out of the way of every pointer.
+     The wordmark, the searchbox and the shortcuts keep their own stacking
+     order; this only has to be under all of them. */
+  border: 0;
+  inset: 0;
+  pointer-events: none;
+  position: fixed;
+  z-index: -2;
+  /* Both dimensions are load-bearing, and `inset: 0` does not replace them.
+     `iframe.css` sizes ntp-iframe's inner frame with `height: inherit` and
+     `width: inherit`, so it takes this host's *computed* width and height
+     rather than filling it. With only `inset: 0` those compute to `auto`,
+     and an iframe is a replaced element: `auto` falls back to the 300x150
+     default. The host stretched to the viewport while the frame inside it
+     stayed a small rectangle in the corner, and the rest of the window was
+     the page's own dark background -- which reads as a broken image rather
+     than a mis-sized one. Upstream's own full-bleed ntp-iframe,
+     `#oneGoogleBar`, states both for the same reason. */
+  height: 100%;
+  width: 100%;
+}
+
+/* Resting -- NTB-6, NTB-7, NTB-8. Three seconds after the window loses focus,
+   the page's own content leaves and the background is what remains.
+
+   By exclusion rather than by list. Naming #content, #customizeButtons and
+   #backgroundImageAttribution would be correct until upstream adds a fourth
+   fixed element to this page, which it does from time to time; naming the one
+   thing that must stay is correct across that.
+
+   pointer-events is the load-bearing half: content faded to nothing still
+   answers a click, and the click that restores focus would otherwise land on
+   an invisible searchbox. One click wakes the page and does nothing else. */
+:host([sunshine-resting]) > *:not(#sunshineBackground):not(#sunshineStatus) {
+  opacity: 0;
+  pointer-events: none;
+}
+
+/* NTB-10. The clock is the reason to look at a resting screen; the button is
+   a control nobody reaches for on one. So the row survives and the button
+   inside it does not. */
+:host([sunshine-resting]) #sunshineStatus > *:not(#sunshineClock) {
+  opacity: 0;
+  pointer-events: none;
+}
+
+#sunshineStatus {
+  align-items: center;
+  bottom: 16px;
+  color: var(--color-new-tab-page-primary-foreground);
+  display: flex;
+  gap: 12px;
+  inset-inline-end: 16px;
+  position: fixed;
+  text-shadow: var(--ntp-theme-text-shadow);
+  z-index: 1;
+}
+
+#sunshineClock {
+  /* The digits are tabular so the row does not shift as the minute changes. */
+  font-size: 1.25rem;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+  user-select: none;
+}
+
+:host > *:not(#sunshineBackground),
+#sunshineStatus > * {
+  transition: opacity 400ms ease;
+}
+
+/* S11. The fade is decoration; the hiding is the feature. A reader who has
+   asked the system for less motion still gets the background alone -- they
+   get it at once instead of over 400ms. */
+@media (prefers-reduced-motion: reduce) {
+  :host > *:not(#sunshineBackground),
+  #sunshineStatus > * {
+    transition: none;
+  }
+}
+
+#sunshineWordmark {
+  color: var(--color-new-tab-page-primary-foreground);
+  /* The wordmark is a Latin lockup and stays LTR in RTL UI locales. This also
+     keeps padding-inline-start on the left, where it cancels the trailing
+     letter-space; letting it flip leaves the wordmark a full letter-space
+     off-centre. */
+  direction: ltr;
+  font-size: clamp(2rem, 6vw, 3.5rem); /* fluid 533px-933px at a 16px root */
+  font-weight: 600;
+  letter-spacing: 0.18em;
+  line-height: 1;
+  margin-bottom: var(--ntp-logo-margin-bottom, 38px);
+  padding-inline-start: 0.18em;
+  text-shadow: var(--ntp-theme-text-shadow);
+  user-select: none;
+}
+
 #logo {
   margin-bottom: var(--ntp-logo-margin-bottom, 38px);
 }
