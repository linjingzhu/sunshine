+// Sunshine's New Tab background.
+//
+// A fixed address with nothing taken from anywhere: no preference, no query
+// parameter, no user input reaches it. The bytes behind it come from
+// `sunshine::background::ReadInstalledBackground`, which looks only beside
+// chrome.exe and returns nothing unless the file's own first bytes say it is
+// a format docs/NEWTAB_BACKGROUND_CONTRACT.md permits.
+//
+// When no background is installed the source serves nothing, the helper's
+// background-image fails to load, and the iframe is transparent -- which is
+// how the feature is absent by default rather than switched off.
+const SUNSHINE_BACKGROUND_PATH =
+    'chrome-untrusted://new-tab-page/custom_background_image?' +
+    'url=chrome-untrusted%3A%2F%2Fnew-tab-page%2Fsunshine-background.png' +
+    '&size=cover&repeatX=no-repeat&repeatY=no-repeat' +
+    '&positionX=center&positionY=center';
+
 const COMPOSEBOX_INERT_ALLOWLIST = [
-  '#logo',
+  '#sunshineWordmark',
   '#searchboxContainer',
 ];
 
