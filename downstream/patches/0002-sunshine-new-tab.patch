diff --git a/chrome/browser/resources/new_tab_page/app.css b/chrome/browser/resources/new_tab_page/app.css
index d9d32b0..355c621 100644
--- a/chrome/browser/resources/new_tab_page/app.css
+++ b/chrome/browser/resources/new_tab_page/app.css
@@ -180,6 +180,23 @@ cr-most-visited {
   z-index: unset;
 }
 
+#sunshineWordmark {
+  color: var(--color-new-tab-page-primary-foreground);
+  /* The wordmark is a Latin lockup and stays LTR in RTL UI locales. This also
+     keeps padding-inline-start on the left, where it cancels the trailing
+     letter-space; letting it flip leaves the wordmark a full letter-space
+     off-centre. */
+  direction: ltr;
+  font-size: clamp(2rem, 6vw, 3.5rem); /* fluid 533px-933px at a 16px root */
+  font-weight: 600;
+  letter-spacing: 0.18em;
+  line-height: 1;
+  margin-bottom: var(--ntp-logo-margin-bottom, 38px);
+  padding-inline-start: 0.18em;
+  text-shadow: var(--ntp-theme-text-shadow);
+  user-select: none;
+}
+
 #logo {
   margin-bottom: var(--ntp-logo-margin-bottom, 38px);
 }
