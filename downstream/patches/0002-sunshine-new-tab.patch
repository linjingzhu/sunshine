@@ -3,6 +3,42 @@ import {SubmitButtonIconType} from '//resources/cr_components/composebox/compose
 #html_wrapper_imports_end -->
+<!-- Sunshine's New Tab background.
+       An iframe rather than an <img> or a CSS background, because the New Tab
+       page overrides child-src to admit chrome-untrusted://new-tab-page and
+       does not override img-src. That is also why upstream's own custom
+       background is an iframe, and this reuses that helper rather than
+       inventing a second way in.
+       Not rendered at all unless a background is installed. The browser
+       answers that from a cache it filled once per process, so a build with
+       no asset creates no frame and opens no file per tab - which is what
+       PB-4 requires and what an earlier version of this got wrong by
+       creating the frame unconditionally and letting the request fail.
+       The hidden attribute goes on whenever the document is not visible.
+       PB-5a permits this animation only while it is being looked at, and a
+       hidden subtree renders nothing, so an animated asset inside it decodes
+       nothing. Hidden rather than removed on purpose: removing it would
+       re-read the file from disk on every return to the tab, and
+       UntrustedSource does not cache.
+       No backticks anywhere in this file. It is preprocessed into a
+       TypeScript template literal, where a backtick ends the string and
+       dollar-brace starts an expression - which is why the upstream comment
+       this replaced wrote its binding as a backslash-escaped dollar.
+       A sibling of #content, not a child. Resting fades #content, and opacity
+       applies to the whole subtree beneath it - so a background inside it
+       would fade with the page instead of being what remains. That was a real
+       defect in the first version of resting, and this position is the fix. -->
+${this.sunshineBackgroundAvailable_ ? html`
+  <ntp-iframe id="sunshineBackground" src="${this.sunshineBackgroundPath_}"
+      ?hidden="${!this.sunshineBackgroundVisible_}"></ntp-iframe>
+` : ''}
+<!-- The status row. A sibling of #content rather than a child, for the same
+     reason as the background above: resting fades #content, and opacity
+     applies to a whole subtree. Anything that must survive resting has to be
+     outside the element that fades. NTB-10. -->
+<div id="sunshineStatus">
+  <span id="sunshineClock">${this.sunshineTime_}</span>
+</div>
 <div id="content"
   ?ntp-threads-rail-open="${this.showComposebox_ && this.enableThreadsRail_}">
   ${this.lazyRender_ && this.microsoftModuleEnabled_ ? html`
     <iframe id="microsoftAuth" src="${this.microsoftAuthIframePath_}"></iframe>
   ` : ''}
@@ -28,13 +53,9 @@ import {SubmitButtonIconType} from '//resources/cr_components/composebox/compose
         </ntp-iframe>
         `
     ) : ''}
-  <!-- TODO(crbug.com/40743294): Instead of ?hidden="\${!this.logoEnabled_}" it would
-       be nicer to use Lit's conditional rendering. However, that breaks
-       StartupBrowserCreatorPickerNoParamsTest.ShowPickerWhenAlreadyLaunched on
-       the msan builder. See crbug.com/40743659. -->
-  <ntp-logo id="logo" ?single-colored="${this.singleColoredLogo_}"
-      .theme="${this.theme_}" ?hidden="${!this.logoEnabled_}">
-  </ntp-logo>
+  <div id="sunshineWordmark" role="heading" aria-level="1"
+      aria-label="Sunshine OS"
+      ?hidden="${!this.logoEnabled_}">SUNSHINE</div>
   ${this.ntpRealboxNextEnabled_ ? html`
     <div id="scrim"
         @click="${this.onScrimClick_}"
