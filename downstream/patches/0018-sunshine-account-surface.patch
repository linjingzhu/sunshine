+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_ACCOUNT_SUNSHINE_ACCOUNT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_ACCOUNT_SUNSHINE_ACCOUNT_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineAccountUI;
+
+// The Google account link, at chrome://sunshine-account. Reached from a row on
+// the module home; docs/ACCOUNT_LINK_PLAN.md section 11 records why it is not
+// a row in Chromium's own settings.
+class SunshineAccountUIConfig
+    : public content::DefaultWebUIConfig<SunshineAccountUI> {
+ public:
+  SunshineAccountUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineAccountHost) {}
+};
+
+// Says what the link is, what it is not, and whether this build can offer it.
+//
+// A plain content::WebUIController, not ui::MojoWebUIController, and the reason
+// is the same one the module home gives: the page needs facts that are known
+// before it loads, so they arrive through the data source and no interface is
+// granted. **The page has nothing to ask the browser to do yet.** Starting an
+// authorization is the next patch's, and it is what will make an interface
+// necessary; granting one now would be machinery for an operation that does not
+// exist.
+class SunshineAccountUI : public content::WebUIController {
+ public:
+  explicit SunshineAccountUI(content::WebUI* web_ui);
+
+  SunshineAccountUI(const SunshineAccountUI&) = delete;
+  SunshineAccountUI& operator=(const SunshineAccountUI&) = delete;
+
+  ~SunshineAccountUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_ACCOUNT_SUNSHINE_ACCOUNT_UI_H_
