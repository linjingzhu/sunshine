+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/account/sunshine_account_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/sunshine/account_link.h"
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+SunshineAccountUI::SunshineAccountUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineAccountHost);
+
+  // One fact, known before the page loads, and false in every build made from
+  // this repository: the OAuth client arrives at build time and this tree
+  // carries no credential. The page renders that as a plain statement rather
+  // than as a disabled control -- PO-6 forbids presenting local-only operation
+  // as an incomplete setup, and a greyed-out Connect button is exactly that.
+  source->AddBoolean("accountLinkAvailable", sunshine::account::LinkAvailable());
+
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("account"),
+                              IDR_SUNSHINE_ACCOUNT_APP_HTML);
+}
+
+SunshineAccountUI::~SunshineAccountUI() = default;
