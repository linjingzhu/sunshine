+++ b/chrome/browser/ui/sunshine/account_link.h
@@ -0,0 +1,27 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SUNSHINE_ACCOUNT_LINK_H_
+#define CHROME_BROWSER_UI_SUNSHINE_ACCOUNT_LINK_H_
+
+namespace sunshine::account {
+
+// Whether this build can offer an account link at all.
+//
+// **False in every build made from this repository, and that is the design.**
+// `scripts/verify_account_freedom.py` refuses every credential in the tree, so
+// the OAuth client arrives at build time from the release pipeline and a
+// community build simply has none. Section 5 of `docs/ACCOUNT_LINK_PLAN.md`
+// calls that state *absent*, not broken: the surface says so plainly and
+// offers nothing, rather than offering a control that cannot work.
+//
+// This is the whole of the account link's browser-side state today. There is
+// deliberately no preference for the linked address yet: nothing can set one
+// until the authorization round trip exists, and a preference for a value that
+// can never be written is a preference for nothing.
+bool LinkAvailable();
+
+}  // namespace sunshine::account
+
+#endif  // CHROME_BROWSER_UI_SUNSHINE_ACCOUNT_LINK_H_
