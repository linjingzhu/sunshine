new file mode 100644
index 0000000..a684659
--- /dev/null
+++ b/chrome/browser/ui/sunshine/account_link.cc
@@ -0,0 +1,32 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/sunshine/account_link.h"
+
+namespace sunshine::account {
+
+namespace {
+
+// The OAuth client this build was given, or the empty string.
+//
+// It is a build-time define and never a literal in this repository. The name is
+// Sunshine's own and deliberately not one of Chrome's three -- setting
+// `google_default_client_id` is what re-enables Desktop Identity Consistency,
+// and ADR 0018 section 4 traces that chain from `HasAPIKeyConfigured()` through
+// the signin-allowed preference to the suppressed first run. A Sunshine client
+// id is invisible to that chain, which is the whole reason this feature is safe
+// in a way that configuring an API key would not be.
+#if defined(SUNSHINE_ACCOUNT_CLIENT_ID)
+constexpr char kClientId[] = SUNSHINE_ACCOUNT_CLIENT_ID;
+#else
+constexpr char kClientId[] = "";
+#endif
+
+}  // namespace
+
+bool LinkAvailable() {
+  return kClientId[0] != '\0';
+}
+
+}  // namespace sunshine::account
