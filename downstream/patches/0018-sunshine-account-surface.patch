diff --git a/chrome/browser/resources/sunshine/account/app.html b/chrome/browser/resources/sunshine/account/app.html
new file mode 100644
index 0000000..65f9db7
--- /dev/null
+++ b/chrome/browser/resources/sunshine/account/app.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine Account</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <!-- Written out rather than built by app.ts, and deliberately.
+       docs/ACCOUNT_LINK_PLAN.md section 4 step 2 requires Sunshine's own
+       consent screen to say what the link will not do, *before* Google's
+       screen says what it will. That text is the product of a decision, not of
+       data: it is the same in every build and for every user, so it belongs in
+       the document where it can be read and reviewed, not assembled at run
+       time from strings a reader has to reconstruct. -->
+  <main id="page">
+    <h1>Google account</h1>
+
+    <p id="state" class="state"></p>
+
+    <section class="panel">
+      <h2>What connecting does</h2>
+      <ul>
+        <li>Sunshine learns the address of the Google account you choose.</li>
+        <li>That is the whole of it.</li>
+      </ul>
+    </section>
+
+    <section class="panel">
+      <h2>What it does not do</h2>
+      <!-- The load-bearing half. A person who reads "connect a Google account"
+           in a browser reasonably expects browser sign-in, and this page has to
+           say plainly that it is not that. PO-R7 and PO-R10 are the rules; this
+           is the sentence a user actually meets. -->
+      <ul>
+        <li>It does not sign the browser in. Sunshine still has no browser
+            account, and nothing about the pages you visit changes.</li>
+        <li>It does not sync anything &mdash; not bookmarks, not history, not
+            passwords, not open tabs. Sunshine has no sync and will not gain
+            one this way.</li>
+        <li>It does not give Sunshine your Google password.</li>
+        <li>Nothing in Sunshine reads the connected account to change how it
+            behaves.</li>
+      </ul>
+    </section>
+
+    <section class="panel">
+      <h2>Where it is kept</h2>
+      <!-- Deliberately not overclaimed. Microsoft documents that generic
+           credentials "can be read and written by user processes", so the
+           store protects the token from other Windows users and from offline
+           inspection of the disk -- not from another program running as you.
+           Saying the smaller true thing is the point. -->
+      <p>In Windows' credential store, for this profile only. It is protected
+         from other Windows users and from anyone reading the disk; it is not
+         protected from another program running as you.</p>
+      <p>Disconnecting removes it, whether or not you are online.</p>
+    </section>
+  </main>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/sunshine/account/app.ts b/chrome/browser/resources/sunshine/account/app.ts
new file mode 100644
index 0000000..4370bfd
--- /dev/null
+++ b/chrome/browser/resources/sunshine/account/app.ts
@@ -0,0 +1,44 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {loadTimeData} from '//resources/js/load_time_data.js';
+
+/**
+ * The Google account link.
+ *
+ * This file writes exactly one sentence, and everything else on the page is in
+ * app.html where it can be reviewed. That split is deliberate: the consent text
+ * is a decision and does not vary, while the state does.
+ *
+ * `textContent`, never markup. Nothing here needs it today, and the moment the
+ * connected address arrives from Google's token response this file becomes the
+ * one place on the page where a privileged surface handles a string it did not
+ * write. Doing it the safe way before that is free; retrofitting it is an
+ * audit.
+ */
+
+function stateSentence(available: boolean): string {
+  if (!available) {
+    // Absent, not broken -- and phrased so that it reads as a fact about this
+    // build rather than as something the reader failed to set up. PO-6 forbids
+    // presenting local-only operation as an incomplete setup, and this is the
+    // sentence that rule is about.
+    return 'This build of Sunshine does not offer a Google account connection.';
+  }
+  return 'No Google account is connected. Sunshine works exactly the same ' +
+      'either way.';
+}
+
+function render(): void {
+  const state = document.querySelector<HTMLElement>('#state');
+  if (!state) {
+    return;
+  }
+  state.textContent =
+      stateSentence(loadTimeData.getBoolean('accountLinkAvailable'));
+}
+
+render();
