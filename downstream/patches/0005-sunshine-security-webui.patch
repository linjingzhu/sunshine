+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine Security</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <main id="page">
+    <h1>Sunshine Security</h1>
+
+    <h2>Safe Browsing</h2>
+
+    <!-- Exactly one of these is revealed by app.js from state the browser
+         reported. They are written out rather than assembled, so nothing on
+         this page is built from a string at runtime (SEC-14), and so each one
+         is a single unit for a later translation pass. -->
+    <p class="verdict" id="verdictAbsent" hidden>
+      Safe Browsing is not part of this build. Sunshine is not checking the
+      pages you visit or the files you download against any malware or phishing
+      list, and nothing else here is doing that job in its place.
+    </p>
+    <p class="verdict" id="verdictOff" hidden>
+      Safe Browsing is part of this build but is switched off for this profile.
+      Sunshine is not checking the pages you visit or the files you download
+      against any malware or phishing list.
+    </p>
+    <p class="verdict" id="verdictUnreachable" hidden>
+      Safe Browsing is part of this build and is switched on for this profile,
+      but this build carries no Google API key, so its lookups cannot reach the
+      service they depend on. Treat this browser as unprotected against malware
+      and phishing.
+    </p>
+    <p class="verdict" id="verdictOn" hidden>
+      Safe Browsing is part of this build, is switched on for this profile, and
+      has the API key its lookups need.
+    </p>
+
+    <h3>What that is read from</h3>
+    <dl id="facts">
+      <div class="fact">
+        <dt>Compiled into this build</dt>
+        <dd><span id="buildYes" hidden>Yes</span><span id="buildNo" hidden>No</span></dd>
+      </div>
+      <div class="fact">
+        <dt>Switched on for this profile</dt>
+        <dd><span id="profileYes" hidden>Yes</span><span id="profileNo" hidden>No</span></dd>
+      </div>
+      <div class="fact">
+        <dt>Google API key configured</dt>
+        <dd><span id="keyYes" hidden>Yes</span><span id="keyNo" hidden>No</span></dd>
+      </div>
+    </dl>
+
+    <p class="note">
+      This page reads Chromium's state and states it. It turns nothing on or
+      off; Safe Browsing is changed in Settings, and the API key is a property
+      of how this browser was built.
+    </p>
+  </main>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/sunshine_security/app.ts b/chrome/browser/resources/sunshine_security/app.ts
new file mode 100644
index 0000000..7879061
--- /dev/null
+++ b/chrome/browser/resources/sunshine_security/app.ts
@@ -0,0 +1,41 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+/**
+ * Reveals or hides one element that is already in the document. Nothing on
+ * this page is constructed from a string: no markup is parsed at runtime and
+ * no text is assembled, which is what keeps a privileged surface within
+ * SEC-14 and within Chromium's Trusted Types policy for WebUI.
+ */
+function reveal(elementId: string, visible: boolean) {
+  const element = document.body.querySelector<HTMLElement>('#' + elementId);
+  if (element) {
+    element.toggleAttribute('hidden', !visible);
+  }
+}
+
+document.addEventListener('DOMContentLoaded', function() {
+  const compiledIn = loadTimeData.getBoolean('safeBrowsingCompiledIn');
+  const switchedOn = loadTimeData.getBoolean('safeBrowsingPrefEnabled');
+  const keyConfigured = loadTimeData.getBoolean('googleApiKeyConfigured');
+
+  reveal('buildYes', compiledIn);
+  reveal('buildNo', !compiledIn);
+  reveal('profileYes', switchedOn);
+  reveal('profileNo', !switchedOn);
+  reveal('keyYes', keyConfigured);
+  reveal('keyNo', !keyConfigured);
+
+  // The absent build is reported before the switched-off profile, and the
+  // unreachable service before the working one, so that the page can never
+  // claim a protection that a later condition takes away. SC-11.
+  reveal('verdictAbsent', !compiledIn);
+  reveal('verdictOff', compiledIn && !switchedOn);
+  reveal('verdictUnreachable', compiledIn && switchedOn && !keyConfigured);
+  reveal('verdictOn', compiledIn && switchedOn && keyConfigured);
+});
