+/* Copyright 2026 The Sunshine OS contributors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ *
+ * Every colour here is read from Chromium's colour pipeline through
+ * chrome://theme/colors.css. Sunshine declares no colour of its own and no
+ * fallback, per docs/DESIGN_SYSTEM_CONTRACT.md sections 2.1 and 2.3: a missing
+ * token must fail visibly rather than silently escape the theme. The role
+ * bindings used here were read at 152.0.7977.42 in ui/color/color_id.h. */
+
+body {
+  background-color: var(--color-dialog-background);
+  color: var(--color-primary-foreground);
+  margin: 0;
+}
+
+#page {
+  margin: 0 auto;
+  max-width: 46rem;
+  padding: 2rem 1.5rem;
+}
+
+h1 {
+  font-size: 1.5rem;
+  font-weight: 500;
+  margin: 0 0 1.5rem;
+}
+
+h2 {
+  font-size: 1.25rem;
+  font-weight: 500;
+  margin: 0 0 1rem;
+}
+
+h3 {
+  font-size: 1rem;
+  font-weight: 600;
+  margin: 2rem 0 0.5rem;
+}
+
+.verdict {
+  font-size: 1rem;
+  line-height: 1.6;
+  margin: 0;
+}
+
+#verdictAbsent,
+#verdictOff,
+#verdictUnreachable {
+  border-inline-start: 4px solid var(--color-alert-high-severity);
+  padding-inline-start: 1rem;
+}
+
+#facts {
+  margin: 0;
+}
+
+.fact {
+  border-top: 1px solid var(--color-midground);
+  display: flex;
+  gap: 1rem;
+  justify-content: space-between;
+  padding: 0.75rem 0;
+}
+
+.fact dt {
+  font-size: 0.875rem;
+}
+
+.fact dd {
+  font-size: 0.875rem;
+  font-weight: 500;
+  margin: 0;
+}
+
+.note {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.6;
+  margin: 2rem 0 0;
+}
