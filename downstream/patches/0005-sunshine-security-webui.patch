--- a/chrome/common/sunshine/sunshine_webui_hosts.h
+++ b/chrome/common/sunshine/sunshine_webui_hosts.h
@@ -20,10 +20,19 @@
 
 namespace chrome {
 
+// The Sunshine Security Center. Sunshine registers no URL scheme of its
+// own; see docs/decisions/0003-internal-scheme.md. The host is prefixed so
+// that it cannot be mistaken for kSecuritySubPage in
+// chrome/common/webui_url_constants.h, which is Settings' own.
+inline constexpr char kChromeUISunshineSecurityHost[] = "sunshine-security";
+inline constexpr char kChromeUISunshineSecurityURL[] =
+    "chrome://sunshine-security/";
+
 // Every Sunshine WebUI host, offered to the omnibox's built-in provider
 // through the loop in ChromeURLHosts(). Empty until the first surface patch
 // appends to it.
 inline constexpr auto kSunshineWebUIHosts = std::to_array<base::cstring_view>({
+      kChromeUISunshineSecurityHost,
 });
 
 }  // namespace chrome
