@@ -0,0 +1,45 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_SECURITY_SUNSHINE_SECURITY_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_SECURITY_SUNSHINE_SECURITY_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineSecurityUI;
+
+// The Sunshine Security Center, at chrome://sunshine-security.
+//
+// Registered through content's WebUI config map rather than through a Sunshine
+// URL scheme; docs/decisions/0003-internal-scheme.md records why Sunshine
+// registers no scheme of its own, and content/public/browser/webui_config_map.h
+// CHECKs that an AddWebUIConfig() argument is a chrome:// config.
+class SunshineSecurityUIConfig
+    : public content::DefaultWebUIConfig<SunshineSecurityUI> {
+ public:
+  SunshineSecurityUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineSecurityHost) {}
+};
+
+// Reads Chromium's Safe Browsing state and states it. It decides nothing and
+// changes nothing: docs/SECURITY_CENTER_CONTRACT.md SC-9 and SC-11.
+class SunshineSecurityUI : public content::WebUIController {
+ public:
+  explicit SunshineSecurityUI(content::WebUI* web_ui);
+
+  SunshineSecurityUI(const SunshineSecurityUI&) = delete;
+  SunshineSecurityUI& operator=(const SunshineSecurityUI&) = delete;
+
+  ~SunshineSecurityUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_SECURITY_SUNSHINE_SECURITY_UI_H_
diff --git a/chrome/common/sunshine/sunshine_webui_hosts.h b/chrome/common/sunshine/sunshine_webui_hosts.h
