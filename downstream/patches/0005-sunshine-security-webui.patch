diff --git a/chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.cc b/chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.cc
new file mode 100644
index 0000000..77c5a44
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.cc
@@ -0,0 +1,56 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/sunshine_security_resources.h"
+#include "chrome/grit/sunshine_security_resources_map.h"
+#include "components/prefs/pref_service.h"
+#include "components/safe_browsing/buildflags.h"
+#include "components/safe_browsing/core/common/safe_browsing_prefs.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "google_apis/google_api_keys.h"
+#include "ui/webui/webui_util.h"
+
+SunshineSecurityUI::SunshineSecurityUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineSecurityHost);
+
+  // Three separate questions, published separately because the page must never
+  // let one of them stand in for another (SC-11).
+  //
+  // 1. Is the Safe Browsing implementation in this binary at all? The build
+  //    flag is defined by components/safe_browsing/BUILD.gn from
+  //    `safe_browsing_mode` in components/safe_browsing/buildflags.gni, which
+  //    is 1 on desktop, so this is expected to be true in a Sunshine build.
+  source->AddBoolean("safeBrowsingCompiledIn",
+                     BUILDFLAG(SAFE_BROWSING_AVAILABLE));
+
+  // 2. Has the user, or policy, left it on for this profile? This is the
+  //    `safebrowsing.enabled` preference, read through the accessor that owns
+  //    it in components/safe_browsing/core/common/safe_browsing_prefs.h.
+  source->AddBoolean(
+      "safeBrowsingPrefEnabled",
+      safe_browsing::IsSafeBrowsingEnabled(*profile->GetPrefs()));
+
+  // 3. Can it reach the service it depends on? Safe Browsing is one of the
+  //    keyed Google services named by google_apis/google_api_keys.h, whose own
+  //    header states that without a key such services "may fail to work
+  //    without warning ... similar to what would happen when a network
+  //    connection is unavailable". docs/decisions/0005-google-api-keys.md
+  //    records the decision not to configure one. This is the question whose
+  //    answer makes the honest verdict "not protected" today, and it is read
+  //    from the browser rather than assumed.
+  source->AddBoolean("googleApiKeyConfigured",
+                     google_apis::HasAPIKeyConfigured());
+
+  webui::SetupWebUIDataSource(source, kSunshineSecurityResources,
+                              IDR_SUNSHINE_SECURITY_APP_HTML);
+}
+
+SunshineSecurityUI::~SunshineSecurityUI() = default;
diff --git a/chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.h b/chrome/browser/ui/webui/sunshine_security/sunshine_security_ui.h
