diff --git a/chrome/chrome_repack_locales.gni b/chrome/chrome_repack_locales.gni
index 19be586..27a7554 100644
--- a/chrome/chrome_repack_locales.gni
+++ b/chrome/chrome_repack_locales.gni
@@ -24,6 +24,20 @@ template("chrome_repack_locales") {
     source_patterns = [
       "${root_gen_dir}/chrome/branded_strings_",
       "${root_gen_dir}/chrome/generated_resources_",
+
+    # Sunshine's command titles. docs/COMMAND_PALETTE_CONTRACT.md section 5(1)
+    # requires every registered command to carry a localised title, and a title
+    # has to reach the toolbar and the menus as well as the palette -- so it is
+    # a strings grd packed per locale, not an entry in the WebUI bundle.
+    #
+    # **This is the twenty-seventh upstream file the patch stack owns, and it
+    # was chosen over the alternative by measurement rather than by reflex.**
+    # The zero-file route was to put the titles in chromium_strings.grd, which
+    # patch 0010 already owns; that file is the branded product-name file, it is
+    # the wrong home, and it moves by 64 lines at the next milestone and 250 at
+    # trunk where this one moves by two at both.
+    # `scripts/measure_file_churn.py command-titles` re-runs the comparison.
+    "${root_gen_dir}/chrome/sunshine_command_strings_",
       "${root_gen_dir}/chrome/locale_settings_",
       "${root_gen_dir}/chrome/platform_locale_settings_",
       "${root_gen_dir}/components/omnibox/resources/omnibox_pedal_synonyms_",
@@ -50,6 +64,7 @@ template("chrome_repack_locales") {
     deps += [
       "//chrome/app:branded_strings",
       "//chrome/app:generated_resources",
+    "//chrome/app/sunshine:sunshine_command_strings",
       "//chrome/app/resources:locale_settings",
       "//chrome/app/resources:platform_locale_settings",
       "//components/omnibox/resources:omnibox_pedal_synonyms",
