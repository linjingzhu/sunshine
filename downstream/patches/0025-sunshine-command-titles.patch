+++ b/chrome/app/sunshine/BUILD.gn
@@ -0,0 +1,25 @@
+# Copyright 2026 The Sunshine OS contributors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# The command titles, as a strings grd of Sunshine's own.
+#
+# **This target is here rather than in `chrome/app/BUILD.gn`, and that is the
+# whole reason this directory exists.** `grit_strings` is a public template in
+# `//tools/grit/grit_rule.gni`, so a strings target may be declared from any
+# BUILD.gn; declaring it beside Chromium's own would have made
+# `chrome/app/BUILD.gn` the twenty-eighth upstream file this stack owns, for a
+# target that has nothing to do with anything else in it.
+#
+# `output_dir` is Chromium's own gen directory rather than this one, because
+# `chrome/chrome_repack_locales.gni` names sources by path and every string set
+# it packs is under `$root_gen_dir/chrome`. Putting the output somewhere tidier
+# would mean the repack naming a second directory.
+
+import("//tools/grit/grit_rule.gni")
+
+grit_strings("sunshine_command_strings") {
+  source = "sunshine_command_strings.grd"
+  output_dir = "$root_gen_dir/chrome"
+  outputs = [ "grit/sunshine_command_strings.h" ]
+}
