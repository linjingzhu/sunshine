+void MultiContentsView::OnSunshineSplitterHoverChanged() {
+  // The resize area reports hover from the `SetVisible(false)` this view's
+  // own constructor makes on it, which runs before the widget exists.
+  if (!sunshine_hover_widget_) {
+    return;
+  }
+  if (!IsInSplitView()) {
+    SetSunshineHoverWidgetVisible(false);
+    return;
+  }
+  if (resize_area_->IsMouseHovered() ||
+      sunshine_hover_widget_->IsMouseHovered()) {
+    sunshine_hover_widget_hide_timer_.Stop();
+    SetSunshineHoverWidgetVisible(true);
+    return;
+  }
+  // **Deferred, and it has to be.** The widget is wider than the splitter, so
+  // moving the pointer from the splitter onto the widget leaves the splitter
+  // and is reported here before the widget is entered. Hiding on that report
+  // would make the widget unreachable -- it would vanish as the user reached
+  // for it. Both report, and the answer is only acted on once neither is
+  // under the pointer.
+  sunshine_hover_widget_hide_timer_.Start(
+      FROM_HERE, kSunshineHoverWidgetHideDelay,
+      base::BindOnce(&MultiContentsView::OnSunshineHoverWidgetHideTimer,
+                     base::Unretained(this)));
+}
+
+void MultiContentsView::OnSunshineHoverWidgetHideTimer() {
+  if (resize_area_->IsMouseHovered() ||
+      sunshine_hover_widget_->IsMouseHovered()) {
+    return;
+  }
+  SetSunshineHoverWidgetVisible(false);
+}
+
+void MultiContentsView::SetSunshineHoverWidgetVisible(bool visible) {
+  if (sunshine_hover_widget_->GetVisible() == visible) {
+    return;
+  }
+  if (visible) {
+    UpdateSunshineHoverWidget();
+  }
+  // `View::SetVisible()` invalidates this view's layout, which is what puts
+  // the widget on the splitter; nothing here needs to ask for that again.
+  sunshine_hover_widget_->SetVisible(visible);
+  // The dot and the widget are one control in two states: a mark that says
+  // there is something here, and the something. Leaving the dot up would draw
+  // it underneath the widget.
+  resize_area_->SetSunshineSwapDotVisible(!visible);
+}
+
+void MultiContentsView::UpdateSunshineHoverWidget() {
+  sunshine_hover_widget_->UpdateForSplit(GetSplitLayout(), active_index_,
+                                         SunshineLinkModeEnabled());
+}
+
+bool MultiContentsView::SunshineLinkModeEnabled() const {
+  content::WebContents* const anchor = GetActiveContentsView()->web_contents();
+  return anchor && sunshine::SplitLinkMode::IsEnabledFor(anchor);
+}
+
+void MultiContentsView::SunshineReverseViews() {
+  // `OnSwap()` CHECKs that a split is open. The widget only exists inside
+  // one, but a button pressed a frame after the split closed is not worth
+  // arguing with an upstream CHECK about.
+  if (IsInSplitView()) {
+    OnSwap();
+  }
+}
+
+void MultiContentsView::SunshineToggleLinkMode() {
+  if (!IsInSplitView()) {
+    return;
+  }
+  content::WebContents* const anchor = GetActiveContentsView()->web_contents();
+  content::WebContents* const destination =
+      GetInactiveContentsView()->web_contents();
+  if (!anchor || !destination) {
+    return;
+  }
+  if (sunshine::SplitLinkMode::IsEnabledFor(anchor)) {
+    sunshine::SplitLinkMode::Disable(anchor);
+  } else {
+    // **One anchor per split.** Both halves pointing at each other would send
+    // a link clicked on either side to the other, so the first click on a
+    // depth page would turn the depth page into the list. The mode is
+    // asymmetric because the arrangement it serves is: one side is what you
+    // are working through, the other is what it opens.
+    sunshine::SplitLinkMode::Disable(destination);
+    sunshine::SplitLinkMode::Enable(anchor, destination);
+  }
+  UpdateSunshineHoverWidget();
+}
+
+void MultiContentsView::SunshineSeparateViews() {
+  TabStripModel* const tab_strip_model =
+      browser_view_->browser()->tab_strip_model();
+  const std::optional<split_tabs::SplitTabId> split_id =
+      tab_strip_model->GetSplitForTab(tab_strip_model->active_index());
+  if (split_id.has_value()) {
+    // The same call the split menu's "Separate views" makes. Two ways in, one
+    // behaviour -- and the tabs survive, which is what "개별 탭으로 분리"
+    // asked for and what closing a pane would not have done.
+    tab_strip_model->RemoveSplit(split_id.value());
+  }
+}
