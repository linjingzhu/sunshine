+// Sunshine's splitter widget: the three things a split can be asked for,
+// shown while the pointer is on the splitter or on the widget itself.
+//
+// **A child of MultiContentsView rather than of the resize area, and that is
+// load-bearing.** `MultiContentsView::GetViewSizes()` reads the splitter's
+// thickness from `resize_area_->GetPreferredSize()`, so anything laid out
+// inside the resize area that is wider than the drag handle widens the
+// splitter and the panes give up the difference -- the defect the swap dot
+// was rewritten to avoid. This floats over the panes instead, positioned in
+// `CalculateProposedLayout()` from its own preferred size, and the splitter
+// never hears about it.
+class SunshineSplitHoverWidget : public views::View {
+  METADATA_HEADER(SunshineSplitHoverWidget, views::View)
+
+ public:
+  SunshineSplitHoverWidget(base::RepeatingClosure on_hover_changed,
+                           views::Button::PressedCallback on_reverse,
+                           views::Button::PressedCallback on_link,
+                           views::Button::PressedCallback on_separate);
+  SunshineSplitHoverWidget(const SunshineSplitHoverWidget&) = delete;
+  SunshineSplitHoverWidget& operator=(const SunshineSplitHoverWidget&) = delete;
+  ~SunshineSplitHoverWidget() override;
+
+  // Rebuilds the icons, the tooltips and the link button's on/off look for
+  // the split as it is now.
+  void UpdateForSplit(split_tabs::SplitTabLayout layout,
+                      int active_index,
+                      bool link_mode_enabled);
+
+  // views::View:
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+
+ private:
+  base::RepeatingClosure on_hover_changed_;
+
+  raw_ptr<views::ImageButton> reverse_button_ = nullptr;
+  raw_ptr<views::ImageButton> link_button_ = nullptr;
+  raw_ptr<views::ImageButton> separate_button_ = nullptr;
+  raw_ptr<views::FlexLayout> layout_manager_ = nullptr;
+};
+
+SunshineSplitHoverWidget::SunshineSplitHoverWidget(
+    base::RepeatingClosure on_hover_changed,
+    views::Button::PressedCallback on_reverse,
+    views::Button::PressedCallback on_link,
+    views::Button::PressedCallback on_separate)
+    : on_hover_changed_(std::move(on_hover_changed)) {
+  // **Its own layer, or it takes clicks and draws nothing.** The panes on
+  // either side are layer-backed, so a sibling that paints into the parent's
+  // layer is composited underneath them while still being hit-tested by its
+  // own bounds. That is exactly how the swap dot shipped invisible and
+  // clickable in build #61, and the fix was these two lines.
+  SetPaintToLayer(ui::LAYER_TEXTURED);
+  layer()->SetFillsBoundsOpaquely(false);
+  SetBackground(views::CreateRoundedRectBackground(
+      kColorToolbar, kSunshineHoverWidgetCornerRadius));
+  SetBorder(views::CreateRoundedRectBorder(1, kSunshineHoverWidgetCornerRadius,
+                                           kColorToolbarContentAreaSeparator));
+  SetVisible(false);
+
+  layout_manager_ = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout_manager_->SetMainAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetInteriorMargin(gfx::Insets(kSunshineHoverWidgetPadding))
+      .SetDefault(views::kMarginsKey,
+                  gfx::Insets(kSunshineHoverWidgetSpacing));
+
+  reverse_button_ =
+      AddChildView(MakeSunshineHoverWidgetButton(std::move(on_reverse)));
+  link_button_ =
+      AddChildView(MakeSunshineHoverWidgetButton(std::move(on_link)));
+  separate_button_ =
+      AddChildView(MakeSunshineHoverWidgetButton(std::move(on_separate)));
+}
