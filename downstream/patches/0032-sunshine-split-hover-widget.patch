+void SunshineSplitHoverWidget::UpdateForSplit(split_tabs::SplitTabLayout layout,
+                                              int active_index,
+                                              bool link_mode_enabled) {
+  const bool side_by_side = layout == split_tabs::SplitTabLayout::kSideBySide;
+  // Along the splitter rather than across it. The widget is wider than the
+  // splitter either way; stacking the buttons the long way keeps the stretch
+  // of splitter that cannot be grabbed as short as it can be.
+  layout_manager_->SetOrientation(side_by_side
+                                      ? views::LayoutOrientation::kVertical
+                                      : views::LayoutOrientation::kHorizontal);
+
+  // Which way "the other side" points is decided the way
+  // `SplitTabMenuModel::GetReversePositionIcon()` and
+  // `GetOpenLinkInSplitStringAndIcon()` decide it for the two menus that
+  // already offer these actions, including the right-to-left case: the pane
+  // holding the active tab is the one being pointed away from. Two controls
+  // for one action must not disagree about its direction.
+  const gfx::VectorIcon* direction_icon = nullptr;
+  int link_string_id = IDS_CONTENT_CONTEXT_OPENLINKSPLITVIEW;
+  if (side_by_side) {
+    const bool active_on_left = (active_index == 0) != base::i18n::IsRTL();
+    direction_icon = active_on_left ? &(features::IsRoundedIconsEnabled()
+                                            ? kSplitSceneRightIcon
+                                            : kSplitSceneRightOldIcon)
+                                    : &(features::IsRoundedIconsEnabled()
+                                            ? kSplitSceneLeftIcon
+                                            : kSplitSceneLeftOldIcon);
+    link_string_id = active_on_left ? IDS_CONTENT_CONTEXT_OPENLINKRIGHTVIEW
+                                    : IDS_CONTENT_CONTEXT_OPENLINKLEFTVIEW;
+  } else {
+    const bool active_on_top = active_index == 0;
+    direction_icon = active_on_top ? &(features::IsRoundedIconsEnabled()
+                                           ? kSplitSceneDownIcon
+                                           : kSplitSceneDownOldIcon)
+                                   : &(features::IsRoundedIconsEnabled()
+                                           ? kSplitSceneUpIcon
+                                           : kSplitSceneUpOldIcon);
+    link_string_id = active_on_top ? IDS_CONTENT_CONTEXT_OPENLINKBOTTOMVIEW
+                                   : IDS_CONTENT_CONTEXT_OPENLINKTOPVIEW;
+  }
+
+  const std::u16string reverse_label =
+      l10n_util::GetStringUTF16(IDS_SPLIT_TAB_REVERSE_VIEWS);
+  reverse_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(*direction_icon, kColorToolbarButtonIcon,
+                                     kSunshineHoverWidgetIconSize));
+  reverse_button_->SetTooltipText(reverse_label);
+  reverse_button_->GetViewAccessibility().SetName(reverse_label);
+
+  // **On is drawn, not described.** The tooltip names the action in both
+  // states, because upstream has a string for "open link in the right view"
+  // and none for stopping, and Sunshine's own strings file is the command
+  // registry's and may not carry a label that names no command. A filled
+  // button is what says the mode is on, and it says it without being hovered
+  // -- which matters for a control that only exists while hovered.
+  const std::u16string link_label = l10n_util::GetStringUTF16(link_string_id);
+  link_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          features::IsRoundedIconsEnabled() ? vector_icons::kLinkIcon
+                                            : vector_icons::kLinkOldIcon,
+          link_mode_enabled ? kColorToolbar : kColorToolbarButtonIcon,
+          kSunshineHoverWidgetIconSize));
+  if (link_mode_enabled) {
+    link_button_->SetBackground(views::CreateRoundedRectBackground(
+        kColorSidePanelHoverResizeAreaHandle,
+        kSunshineHoverWidgetButtonSize / 2));
+  } else {
+    link_button_->SetBackground(nullptr);
+  }
+  link_button_->SetTooltipText(link_label);
+  link_button_->GetViewAccessibility().SetName(link_label);
+
+  const std::u16string separate_label =
+      l10n_util::GetStringUTF16(IDS_SPLIT_TAB_SEPARATE_VIEWS);
+  separate_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(features::IsRoundedIconsEnabled()
+                                         ? kOpenInFullIcon
+                                         : kOpenInFullOldIcon,
+                                     kColorToolbarButtonIcon,
+                                     kSunshineHoverWidgetIconSize));
+  separate_button_->SetTooltipText(separate_label);
+  separate_button_->GetViewAccessibility().SetName(separate_label);
+}
