@@ -0,0 +1,258 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import * as geometry from './geometry.js';
+import * as port from './mount_port.js';
+
+/**
+ * The shell's half of the module mount port.
+ *
+ * `mount_port.ts` says what may cross; this file is what crosses it in
+ * Sunshine, and it is the only file in the shell that touches a frame or a
+ * message. app.ts asks a `Mount` to open a module and is handed validated data
+ * -- it never sees a `MessageEvent`, never sees an origin, and never sees a
+ * URL. That separation is the point: everything that could go wrong about
+ * receiving from an unprivileged frame is in one file, of one page, and it is
+ * this one.
+ *
+ * **A module's content never enters the shell's document.** MS-3. It is
+ * rendered in an iframe at a `chrome-untrusted://` origin the module supplies
+ * through the registry, and the only things that come back out are the strings
+ * `mount_port.ts` validates. What the shell then draws from those strings, it
+ * draws with `createElement` and `textContent`, in app.ts.
+ *
+ * **Three independent checks stand between a frame and the shell.** The
+ * listener compares `event.source` against this frame's own `contentWindow`,
+ * so a message from any other frame or window is not this mount's; it compares
+ * `event.origin` against the origin the frame was opened at, so a frame that
+ * navigated elsewhere stops being heard; and it validates the payload, so a
+ * message from the right frame at the right origin still has to be a message.
+ * Any one of the three would catch the ordinary mistake. The other two are for
+ * the case where the first was wrong.
+ */
+
+/** What a mounted module has told the shell about itself. */
+export interface MountView {
+  title: string;
+  path: string;
+  icon: port.IconName|null;
+  dirty: boolean;
+  tabs: port.MountTab[];
+  activeTab: string;
+  actions: port.MountAction[];
+}
+
+/** The registry's description of something mountable. */
+export interface Mountable {
+  id: string;
+  displayName: string;
+  contentUrl: string;
+}
+
+export interface MountCallbacks {
+  /** The module described itself, or changed its description. */
+  describe(view: MountView): void;
+  /** The module moved its own selection. C follows; it does not argue. */
+  select(tab: string): void;
+  /** The module asked for a panel role. E's container is the shell's. */
+  requestPanel(role: string): void;
+}
+
+/** The empty description, which is also what a mount reverts to when closed. */
+export function emptyView(): MountView {
+  return {
+    title: '',
+    path: '',
+    icon: null,
+    dirty: false,
+    tabs: [],
+    activeTab: '',
+    actions: [],
+  };
+}
+
+/**
+ * Reads a module's mount declaration out of a registry entry.
+ *
+ * Returns null for a module that declares none, which is not an error: most
+ * modules are not mountable, and `docs/MODULE_SHELL_CONTRACT.md` section 1
+ * requires the dock to list every module regardless. A module in the dock with
+ * nothing to mount shows the shell's empty state, which is state 09 and a
+ * legitimate thing for the shell to be in.
+ */
+export function mountable(entry: unknown): Mountable|null {
+  if (typeof entry !== 'object' || entry === null) {
+    return null;
+  }
+  const fields = entry as Record<string, unknown>;
+  const id = port.identifier(fields['id']);
+  const displayName = port.label(fields['display_name']);
+  const mount = fields['mount'];
+  if (id === null || displayName === null || typeof mount !== 'object' ||
+      mount === null) {
+    return null;
+  }
+  const url =
+      port.contentUrl((mount as Record<string, unknown>)['content_url']);
+  return url === null ? null : {id, displayName, contentUrl: url};
+}
+
+/**
+ * One mount point: one region, at most one frame, at most one module.
+ *
+ * A `Mount` is created once per region and reused. Opening a different module
+ * replaces the frame rather than reusing it -- a frame that had navigated
+ * would keep its old document's state, and there is no message in the port
+ * that means "forget everything", because a new frame is a better way to say
+ * it than a message a module could ignore.
+ */
+export class Mount {
+  private readonly container: HTMLElement;
+  private readonly region: port.Region;
+  private readonly callbacks: MountCallbacks;
+  private frame: HTMLIFrameElement|null = null;
+  private origin = '';
+  private open_: Mountable|null = null;
+  private ready = false;
+  private pending: port.HostMessage[] = [];
+
+  constructor(
+      container: HTMLElement, region: port.Region, callbacks: MountCallbacks) {
+    this.container = container;
+    this.region = region;
+    this.callbacks = callbacks;
+    window.addEventListener('message', (event) => this.receive(event));
+  }
+
+  get module(): Mountable|null {
+    return this.open_;
+  }
+
+  /**
+   * Puts `target` in this region, or clears it when `target` is null.
+   *
+   * Opening the module already open is a no-op rather than a reload: the dock
+   * is clicked to switch modules, and switching to the one you are in should
+   * not throw away what you were doing in it.
+   */
+  openModule(
+      target: Mountable|null, activeTab: string, panelRole: string): void {
+    if (target !== null && this.open_?.id === target.id) {
+      return;
+    }
+    this.close();
+    if (target === null) {
+      return;
+    }
+
+    const frame = document.createElement('iframe');
+    frame.className = 'module-frame';
+    frame.title = target.displayName;
+    // The one navigation the shell performs, to a URL the registry compiled
+    // into the binary supplied and mount_port.contentUrl() accepted.
+    frame.src = target.contentUrl;
+    frame.addEventListener('load', () => this.introduce(activeTab, panelRole));
+
+    this.open_ = target;
+    this.origin = port.originOf(target.contentUrl);
+    this.frame = frame;
+    this.container.append(frame);
+  }
+
+  close(): void {
+    this.frame?.remove();
+    this.frame = null;
+    this.open_ = null;
+    this.origin = '';
+    this.ready = false;
+    this.pending = [];
+  }
+
+  activate(tab: string): void {
+    this.post({type: 'activate', tab});
+  }
+
+  invoke(action: string): void {
+    this.post({type: 'action', action});
+  }
+
+  setPanelRole(role: string): void {
+    this.post({type: 'panel', role});
+  }
+
+  // -- the wire -------------------------------------------------------------
+
+  /**
+   * The first message, sent on the frame's own `load` event.
+   *
+   * Readiness comes from `load` rather than from a message the module sends,
+   * for the reason `docs/DOCUMENT_SURFACE_CONTRACT.md` gives about its own
+   * frame: `load` is the browser's fact about the frame, and a readiness
+   * message would be the frame's claim about itself. A module that never
+   * claims to be ready would then never be mounted.
+   */
+  private introduce(activeTab: string, panelRole: string): void {
+    this.ready = true;
+    this.send({
+      type: 'mount',
+      module: this.open_?.id ?? '',
+      region: this.region,
+      activeTab,
+      panelRole,
+    });
+    for (const message of this.pending) {
+      this.send(message);
+    }
+    this.pending = [];
+  }
+
+  /** Queued until the frame has loaded, because postMessage before it is lost. */
+  private post(message: port.HostMessage): void {
+    if (this.ready) {
+      this.send(message);
+    } else if (this.frame !== null) {
+      this.pending.push(message);
+    }
+  }
+
+  private send(message: port.HostMessage): void {
+    // The target origin is stated rather than '*': a frame that navigated away
+    // must not be handed the shell's messages on its way out.
+    this.frame?.contentWindow?.postMessage(message, this.origin);
+  }
+
+  private receive(event: MessageEvent): void {
+    if (this.frame === null || event.source !== this.frame.contentWindow ||
+        event.origin !== this.origin) {
+      return;
+    }
+    const message = port.moduleMessage(event.data);
+    if (message === null) {
+      return;
+    }
+
+    if (message.type === 'select') {
+      this.callbacks.select(message.tab);
+      return;
+    }
+    if (message.type === 'request-panel') {
+      this.callbacks.requestPanel(message.role);
+      return;
+    }
+
+    // The header holds HEADER_ACTIONS_MAX of them and no more. Truncating
+    // rather than refusing the message: a module that offered four actions has
+    // said something true about three of them, and dropping the description
+    // whole would cost the title and the tabs as well.
+    this.callbacks.describe({
+      title: message.title,
+      path: message.path,
+      icon: message.icon,
+      dirty: message.dirty,
+      tabs: message.tabs,
+      activeTab: message.activeTab,
+      actions: message.actions.slice(0, geometry.HEADER_ACTIONS_MAX),
+    });
+  }
+}
diff --git a/chrome/browser/resources/sunshine/shell/mount_port.ts b/chrome/browser/resources/sunshine/shell/mount_port.ts
