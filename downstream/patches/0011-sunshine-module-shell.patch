+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/shell/sunshine_shell_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/sunshine/modules/sunshine_module_registry.h"
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+SunshineShellUI::SunshineShellUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineShellHost);
+
+  // The same registry the module home is served, from the same constant.
+  // The dock lists every module, so it needs exactly what
+  // chrome://sunshine-modules needs, and a second copy of it would be a second
+  // thing for scripts/verify_module_registry_sync.py to have to know about.
+  source->AddString("moduleRegistry", sunshine::kSunshineModuleRegistryJson);
+
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("shell"),
+                              IDR_SUNSHINE_SHELL_APP_HTML);
+}
+
+SunshineShellUI::~SunshineShellUI() = default;
