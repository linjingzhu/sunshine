+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_SHELL_SUNSHINE_SHELL_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_SHELL_SUNSHINE_SHELL_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineShellUI;
+
+// The module shell, at chrome://sunshine-shell.
+class SunshineShellUIConfig
+    : public content::DefaultWebUIConfig<SunshineShellUI> {
+ public:
+  SunshineShellUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineShellHost) {}
+};
+
+// The browser's half of the five-region shell every module app is mounted
+// into: the module bar, the dock, the tab list's frame, the body header and
+// the aux panel's container. docs/MODULE_SHELL_CONTRACT.md section 1 draws the
+// line and says why it is there -- the short form is that these regions carry
+// every way out of a module, so a module that drew them could omit them.
+//
+// A plain content::WebUIController, not ui::MojoWebUIController. The shell
+// needs the module registry, which is known before the page loads, so it
+// arrives through the data source and there is no interface to grant. Mounting
+// an actual module will need one; granting it before there is something to
+// grant it to would be machinery with no user.
+class SunshineShellUI : public content::WebUIController {
+ public:
+  explicit SunshineShellUI(content::WebUI* web_ui);
+
+  SunshineShellUI(const SunshineShellUI&) = delete;
+  SunshineShellUI& operator=(const SunshineShellUI&) = delete;
+
+  ~SunshineShellUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_SHELL_SUNSHINE_SHELL_UI_H_
