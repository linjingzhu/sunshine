@@ -0,0 +1,153 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * The shell's measurements and the arithmetic over them.
+ *
+ * Every number the layout uses is declared here once and nowhere else.
+ * `docs/MODULE_SHELL_CONTRACT.md` section 2 carries the same table, and
+ * `scripts/verify_shell_geometry.py` fails the build when the two disagree --
+ * so a width changed in a stylesheet and not in the contract is a failure
+ * rather than a drift. MS-4.
+ *
+ * This file is deliberately free of the DOM. Its functions take numbers and
+ * return numbers, which is what lets the collapse order be reasoned about at
+ * all: it is the one part of the shell where being wrong is invisible until a
+ * window is the wrong size.
+ */
+
+// -- Region A, the module bar -------------------------------------------------
+export const BAR_HEIGHT = 32;
+
+// -- Region B, the module dock ------------------------------------------------
+// Two widths and no others. The dock has no splitter, so there is no third.
+export const DOCK_ICONS = 56;
+export const DOCK_EXPANDED = 224;
+
+// -- Region C, the tab list ---------------------------------------------------
+export const TABS_DEFAULT = 232;
+export const TABS_MIN = 180;
+export const TABS_MAX = 360;
+
+// -- Region D, the body -------------------------------------------------------
+// D is flex:1 and absorbs whatever the others leave. BODY_MIN is the floor it
+// never goes below while visible; the others yield instead.
+export const BODY_MIN = 480;
+export const HEADER_HEIGHT = 40;
+export const HEADER_PAD_LEFT = 16;
+export const HEADER_PAD_RIGHT = 12;
+export const HEADER_ACTIONS_MAX = 3;
+
+// -- Region E, the aux panel --------------------------------------------------
+export const PANEL_DEFAULT = 320;
+export const PANEL_MIN = 280;
+export const PANEL_MAX = 520;
+export const PANEL_ROLES = 6;
+
+// -- Splitters ----------------------------------------------------------------
+// Drawn narrow, targeted wide. A 4px pointer target is a 4px pointer target
+// however carefully it is drawn.
+export const SPLITTER_VISUAL = 4;
+export const SPLITTER_HIT = 8;
+
+// -- Density ------------------------------------------------------------------
+export const DENSE_MIN_WIDTH = 1440;
+
+export interface ShellState {
+  /** A's toggle. False hides B and C together -- state 04. */
+  leftVisible: boolean;
+  /** B: icons only, or icons with names. Shell-global, not per module. */
+  dockExpanded: boolean;
+  /** C. Hidden alone is state 03. */
+  tabsVisible: boolean;
+  tabsWidth: number;
+  /** E. */
+  panelOpen: boolean;
+  panelWidth: number;
+}
+
+export interface Layout {
+  dock: number;
+  tabs: number;
+  body: number;
+  panel: number;
+  /** Regions the viewport forced away, in the order they were given up. */
+  collapsed: string[];
+}
+
+export function clamp(value: number, low: number, high: number): number {
+  return Math.min(high, Math.max(low, value));
+}
+
+export function clampTabs(width: number): number {
+  return clamp(width, TABS_MIN, TABS_MAX);
+}
+
+export function clampPanel(width: number): number {
+  return clamp(width, PANEL_MIN, PANEL_MAX);
+}
+
+/**
+ * The widths for a state at a viewport width.
+ *
+ * Under pressure regions yield in one order -- **E first, then C** -- and D
+ * never yields below BODY_MIN while it is visible. That order is not a
+ * preference: E is supplementary, C is navigation, D is the work, so giving up
+ * the work to keep an inspector would be the wrong trade every time.
+ *
+ * B never yields. It is how the user reaches another module, including when
+ * this one is the reason the window is uncomfortable.
+ */
+export function layout(state: ShellState, viewport: number): Layout {
+  const collapsed: string[] = [];
+  const dock = state.leftVisible ? (state.dockExpanded ? DOCK_EXPANDED : DOCK_ICONS) : 0;
+
+  let tabs = state.leftVisible && state.tabsVisible ? clampTabs(state.tabsWidth) : 0;
+  let panel = state.panelOpen ? clampPanel(state.panelWidth) : 0;
+
+  const fits = () => viewport - dock - tabs - panel >= BODY_MIN;
+
+  // 1. Squeeze what can be squeezed, in yield order, before dropping anything.
+  if (!fits() && panel > 0) {
+    panel = Math.max(PANEL_MIN, viewport - dock - tabs - BODY_MIN);
+    panel = panel < PANEL_MIN ? PANEL_MIN : panel;
+  }
+  if (!fits() && tabs > 0) {
+    tabs = Math.max(TABS_MIN, viewport - dock - panel - BODY_MIN);
+    tabs = tabs < TABS_MIN ? TABS_MIN : tabs;
+  }
+
+  // 2. Still short: drop them, same order. A region at its minimum that still
+  //    does not fit is a region that has to go, not one that shrinks further.
+  if (!fits() && panel > 0) {
+    panel = 0;
+    collapsed.push('panel');
+  }
+  if (!fits() && tabs > 0) {
+    tabs = 0;
+    collapsed.push('tabs');
+  }
+
+  // 3. D takes the rest, and is never reported below its floor -- if the window
+  //    is smaller than that, the window is what is wrong, and the shell says so
+  //    by overflowing rather than by lying about the width.
+  const body = Math.max(BODY_MIN, viewport - dock - tabs - panel);
+  return {dock, tabs, body, panel, collapsed};
+}
+
+/** Whether the four-region arrangement is worth offering at this width. */
+export function densityAllows(viewport: number): boolean {
+  return viewport >= DENSE_MIN_WIDTH;
+}
+
+export function defaultState(): ShellState {
+  return {
+    leftVisible: true,
+    dockExpanded: false,
+    tabsVisible: true,
+    tabsWidth: TABS_DEFAULT,
+    panelOpen: false,
+    panelWidth: PANEL_DEFAULT,
+  };
+}
