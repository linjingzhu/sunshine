+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <!-- The five regions of docs/MODULE_SHELL_CONTRACT.md, in the order they are
+       drawn and therefore in the order they are reached by the keyboard.
+
+       A, B, the D header and the E container are the browser's and are written
+       out here. The three content areas are not: they are mount points, and
+       they hold the shell's own empty state until a module is mounted. Markup
+       supplied by a module never enters this document -- MS-3. -->
+
+  <!-- A · module bar -->
+  <header id="bar">
+    <button id="leftToggle" class="bar-button" type="button"
+        aria-expanded="true" aria-controls="left"
+        title="Show or hide the module panel">
+      <span class="glyph" aria-hidden="true"></span>
+      <span class="visually-hidden">Module panel</span>
+    </button>
+    <span id="barTitle">Sunshine</span>
+    <span class="bar-spacer"></span>
+    <button id="densityNote" class="bar-button bar-note" type="button" hidden
+        title="Four regions at once is recommended above 1440px">narrow</button>
+  </header>
+
+  <div id="page">
+    <!-- B · module dock, and C · tab list. A's toggle collapses both. -->
+    <div id="left">
+      <nav id="dock" aria-label="Modules">
+        <ul id="dockList"></ul>
+        <button id="dockToggle" class="dock-button dock-foot" type="button"
+            aria-expanded="false" title="Show module names">
+          <span class="glyph" aria-hidden="true"></span>
+          <span class="dock-label">Names</span>
+        </button>
+      </nav>
+
+      <section id="tabs" aria-label="Tabs">
+        <div id="tabsHead">
+          <span id="tabsTitle"></span>
+          <span id="tabsCount"></span>
+        </div>
+        <ul id="tabsList"></ul>
+        <p id="tabsEmpty" class="empty" hidden></p>
+      </section>
+
+      <div id="tabsSplitter" class="splitter" role="separator"
+          aria-orientation="vertical" tabindex="0"
+          aria-label="Resize the tab list"></div>
+    </div>
+
+    <!-- D · body. The header is the shell's; everything under it is not. -->
+    <main id="body">
+      <div id="header">
+        <button id="restore" class="header-button" type="button" hidden
+            title="Show the module panel">
+          <span class="glyph" aria-hidden="true"></span>
+        </button>
+        <span id="headerIcon" class="tile" aria-hidden="true"></span>
+        <span id="headerTitle"></span>
+        <span id="headerPath" class="path"></span>
+        <span id="headerDirty" class="dirty" hidden
+            title="Unsaved changes"></span>
+        <span class="header-spacer"></span>
+        <span id="headerActions"></span>
+        <button id="panelToggle" class="header-button" type="button"
+            aria-expanded="false" title="Show or hide the side panel">
+          <span class="glyph" aria-hidden="true"></span>
+        </button>
+      </div>
+      <div id="bodyMount" class="mount">
+        <p class="empty" id="bodyEmpty"></p>
+      </div>
+    </main>
+
+    <!-- E · aux panel. One container, six roles. -->
+    <div id="panelSplitter" class="splitter" role="separator"
+        aria-orientation="vertical" tabindex="0"
+        aria-label="Resize the side panel" hidden></div>
+    <aside id="panel" aria-label="Side panel" hidden>
+      <div id="panelHead">
+        <span id="panelRoles" role="tablist" aria-label="Panel role"></span>
+      </div>
+      <div id="panelMount" class="mount">
+        <p class="empty" id="panelEmpty"></p>
+      </div>
+    </aside>
+  </div>
+
+  <script type="module" src="app.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/sunshine/shell/app.ts b/chrome/browser/resources/sunshine/shell/app.ts
new file mode 100644
index 0000000..bb135bb
--- /dev/null
+++ b/chrome/browser/resources/sunshine/shell/app.ts
@@ -0,0 +1,438 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {loadTimeData} from '//resources/js/load_time_data.js';
+
+import * as geometry from './geometry.js';
+
+/**
+ * The browser's half of the module shell.
+ *
+ * What this file draws is everything a module cannot be trusted to draw: the
+ * bar, the dock, the tab list's frame, the body header, and the panel
+ * container. docs/MODULE_SHELL_CONTRACT.md section 1 gives the reasoning; the
+ * short form is that these regions carry every way out of a module, so a
+ * module that drew them could omit them.
+ *
+ * The three content areas are mount points. They hold the shell's own empty
+ * state today because the host port has no implementation yet, and when they
+ * hold a module they will hold a frame -- module markup does not enter this
+ * document. MS-3.
+ */
+
+interface ModuleEntry {
+  id: string;
+  display_name: string;
+  kind: string;
+}
+
+interface Registry {
+  modules: ModuleEntry[];
+}
+
+/** E's six roles, in the order the drawing lists them. */
+const ROLES = ['inspector', 'preview', 'console', 'docs', 'assistant', 'tasks'];
+
+/** Per-module keys, exactly the set the contract names. */
+interface Stored {
+  tabsVisible: boolean;
+  tabsWidth: number;
+  panelOpen: boolean;
+  panelRole: string;
+  panelWidth: number;
+  activeTab: string;
+}
+
+function element<T extends HTMLElement>(id: string): T {
+  const found = document.getElementById(id);
+  if (!found) {
+    throw new Error(`sunshine-shell: #${id} is missing from app.html`);
+  }
+  return found as T;
+}
+
+function text(tag: string, value: string, className?: string): HTMLElement {
+  const node = document.createElement(tag);
+  node.textContent = value;
+  if (className) {
+    node.className = className;
+  }
+  return node;
+}
+
+/**
+ * Layout state that belongs to the shell rather than to any module: A's toggle
+ * and the dock's width. The contract makes these global on purpose -- the bar
+ * and the dock are the browser's furniture, and furniture that rearranged
+ * itself as the user moved between modules would be worse than furniture that
+ * did not.
+ */
+class GlobalState {
+  private static readonly KEY = 'sunshine.shell.global';
+
+  leftVisible = true;
+  dockExpanded = false;
+
+  load(): void {
+    const raw = window.localStorage.getItem(GlobalState.KEY);
+    if (!raw) {
+      return;
+    }
+    try {
+      const parsed = JSON.parse(raw) as Partial<GlobalState>;
+      this.leftVisible = parsed.leftVisible ?? true;
+      this.dockExpanded = parsed.dockExpanded ?? false;
+    } catch {
+      // Unreadable state is not a reason to refuse to start. Defaults are a
+      // correct shell; a thrown exception here would be a blank window.
+    }
+  }
+
+  save(): void {
+    window.localStorage.setItem(
+        GlobalState.KEY,
+        JSON.stringify(
+            {leftVisible: this.leftVisible, dockExpanded: this.dockExpanded}));
+  }
+}
+
+/** Everything else, remembered per module. */
+class ModuleState {
+  private static key(id: string): string {
+    return `sunshine.shell.module.${id}`;
+  }
+
+  static load(id: string): Stored {
+    const fallback: Stored = {
+      tabsVisible: true,
+      tabsWidth: geometry.TABS_DEFAULT,
+      panelOpen: false,
+      panelRole: ROLES[0]!,
+      panelWidth: geometry.PANEL_DEFAULT,
+      activeTab: '',
+    };
+    const raw = window.localStorage.getItem(ModuleState.key(id));
+    if (!raw) {
+      return fallback;
+    }
+    try {
+      const parsed = JSON.parse(raw) as Partial<Stored>;
+      return {
+        tabsVisible: parsed.tabsVisible ?? fallback.tabsVisible,
+        tabsWidth: geometry.clampTabs(parsed.tabsWidth ?? fallback.tabsWidth),
+        panelOpen: parsed.panelOpen ?? fallback.panelOpen,
+        panelRole: ROLES.includes(parsed.panelRole ?? '') ? parsed.panelRole! :
+                                                            fallback.panelRole,
+        panelWidth:
+            geometry.clampPanel(parsed.panelWidth ?? fallback.panelWidth),
+        activeTab: parsed.activeTab ?? fallback.activeTab,
+      };
+    } catch {
+      return fallback;
+    }
+  }
+
+  static save(id: string, state: Stored): void {
+    window.localStorage.setItem(ModuleState.key(id), JSON.stringify(state));
+  }
+
+  static clear(id: string): void {
+    window.localStorage.removeItem(ModuleState.key(id));
+  }
+}
+
+class Shell {
+  private readonly modules: ModuleEntry[];
+  private readonly global = new GlobalState();
+  private current: ModuleEntry|null = null;
+  private stored: Stored;
+
+  constructor(registry: Registry) {
+    this.modules = registry.modules;
+    this.global.load();
+    this.stored = ModuleState.load(this.modules[0]?.id ?? '');
+
+    this.buildDock();
+    this.buildRoles();
+    this.wireBar();
+    this.wireHeader();
+    this.wireSplitter(
+        element('tabsSplitter'), () => this.stored.tabsWidth,
+        (width) => {
+          this.stored.tabsWidth = geometry.clampTabs(width);
+        },
+        geometry.TABS_DEFAULT, 1);
+    this.wireSplitter(
+        element('panelSplitter'), () => this.stored.panelWidth,
+        (width) => {
+          this.stored.panelWidth = geometry.clampPanel(width);
+        },
+        geometry.PANEL_DEFAULT, -1);
+
+    window.addEventListener('resize', () => this.apply());
+    this.select(this.modules[0] ?? null);
+  }
+
+  // -- construction ---------------------------------------------------------
+
+  private buildDock(): void {
+    const list = element<HTMLUListElement>('dockList');
+    for (const module of this.modules) {
+      const item = document.createElement('li');
+      const button = document.createElement('button');
+      button.className = 'dock-button';
+      button.type = 'button';
+      button.dataset['id'] = module.id;
+      button.title = `${module.display_name} — ${module.id}`;
+
+      const tile = document.createElement('span');
+      tile.className = 'tile';
+      button.append(tile, text('span', module.display_name, 'dock-label'));
+
+      button.addEventListener('click', () => this.select(module));
+      // Right-click resets this module's layout. The contract puts the reset
+      // here rather than in a settings page because it is the only control
+      // whose target is the thing being right-clicked.
+      button.addEventListener('contextmenu', (event) => {
+        event.preventDefault();
+        ModuleState.clear(module.id);
+        if (this.current?.id === module.id) {
+          this.stored = ModuleState.load(module.id);
+          this.apply();
+        }
+      });
+      item.append(button);
+      list.append(item);
+    }
+  }
+
+  private buildRoles(): void {
+    const host = element('panelRoles');
+    for (const role of ROLES) {
+      const button = document.createElement('button');
+      button.className = 'role-button';
+      button.type = 'button';
+      button.role = 'tab';
+      button.dataset['role'] = role;
+      button.textContent = role;
+      button.addEventListener('click', () => {
+        this.stored.panelRole = role;
+        this.persist();
+        this.apply();
+      });
+      host.append(button);
+    }
+  }
+
+  private wireBar(): void {
+    element('leftToggle').addEventListener('click', () => {
+      this.global.leftVisible = !this.global.leftVisible;
+      this.global.save();
+      this.apply();
+    });
+    element('dockToggle').addEventListener('click', () => {
+      this.global.dockExpanded = !this.global.dockExpanded;
+      this.global.save();
+      this.apply();
+    });
+  }
+
+  private wireHeader(): void {
+    // The restore control appears only in state 04, and only in the header,
+    // because that is the only chrome still on screen when B and C are gone.
+    element('restore').addEventListener('click', () => {
+      this.global.leftVisible = true;
+      this.global.save();
+      this.apply();
+    });
+    element('panelToggle').addEventListener('click', () => {
+      this.stored.panelOpen = !this.stored.panelOpen;
+      this.persist();
+      this.apply();
+    });
+  }
+
+  /**
+   * One splitter. `direction` is +1 when dragging right grows the region and
+   * -1 when it shrinks it, which is the only difference between the two.
+   *
+   * Live resize, no ghost line, and the value is written on release rather
+   * than during the drag -- a drag that ends outside the window should leave
+   * the width where the pointer left it, not where it started.
+   */
+  private wireSplitter(
+      handle: HTMLElement, read: () => number, write: (width: number) => void,
+      fallback: number, direction: number): void {
+    let origin = 0;
+    let start = 0;
+
+    const move = (event: PointerEvent) => {
+      write(start + direction * (event.clientX - origin));
+      this.apply();
+    };
+
+    const release = () => {
+      handle.removeAttribute('data-dragging');
+      window.removeEventListener('pointermove', move);
+      window.removeEventListener('pointerup', release);
+      this.persist();
+    };
+
+    handle.addEventListener('pointerdown', (event: PointerEvent) => {
+      origin = event.clientX;
+      start = read();
+      handle.dataset['dragging'] = 'true';
+      window.addEventListener('pointermove', move);
+      window.addEventListener('pointerup', release);
+      event.preventDefault();
+    });
+
+    handle.addEventListener('dblclick', () => {
+      write(fallback);
+      this.persist();
+      this.apply();
+    });
+
+    // The same handle from the keyboard. A pointer-only splitter is a width
+    // that keyboard users cannot change at all.
+    handle.addEventListener('keydown', (event: KeyboardEvent) => {
+      const step = event.shiftKey ? 32 : 8;
+      if (event.key === 'ArrowLeft') {
+        write(read() - direction * step);
+      } else if (event.key === 'ArrowRight') {
+        write(read() + direction * step);
+      } else if (event.key === 'Home') {
+        write(fallback);
+      } else {
+        return;
+      }
+      event.preventDefault();
+      this.persist();
+      this.apply();
+    });
+  }
+
+  // -- state ----------------------------------------------------------------
+
+  private persist(): void {
+    if (this.current) {
+      ModuleState.save(this.current.id, this.stored);
+    }
+  }
+
+  private select(module: ModuleEntry|null): void {
+    this.current = module;
+    if (module) {
+      this.stored = ModuleState.load(module.id);
+    }
+    this.apply();
+  }
+
+  private apply(): void {
+    const state: geometry.ShellState = {
+      leftVisible: this.global.leftVisible,
+      dockExpanded: this.global.dockExpanded,
+      tabsVisible: this.stored.tabsVisible,
+      tabsWidth: this.stored.tabsWidth,
+      panelOpen: this.stored.panelOpen,
+      panelWidth: this.stored.panelWidth,
+    };
+    const computed = geometry.layout(state, window.innerWidth);
+    const page = element('page');
+    const root = document.documentElement;
+
+    root.style.setProperty('--sunshine-dock-width', `${computed.dock}px`);
+    root.style.setProperty('--sunshine-tabs-width', `${computed.tabs}px`);
+    root.style.setProperty('--sunshine-panel-width', `${computed.panel}px`);
+
+    page.dataset['dock'] = this.global.dockExpanded ? 'names' : 'icons';
+    element('left').hidden = !this.global.leftVisible;
+    element('tabs').hidden = computed.tabs === 0;
+    element('tabsSplitter').hidden = computed.tabs === 0;
+    element('panel').hidden = computed.panel === 0;
+    element('panelSplitter').hidden = computed.panel === 0;
+    element('restore').hidden = this.global.leftVisible;
+    element('densityNote').hidden = geometry.densityAllows(window.innerWidth);
+
+    element('leftToggle')
+        .setAttribute('aria-expanded', String(this.global.leftVisible));
+    element('dockToggle')
+        .setAttribute('aria-expanded', String(this.global.dockExpanded));
+    element('panelToggle')
+        .setAttribute('aria-expanded', String(this.stored.panelOpen));
+
+    for (const button of element('dockList')
+             .querySelectorAll<HTMLElement>('button.dock-button')) {
+      button.setAttribute(
+          'aria-current',
+          String(button.dataset['id'] === this.current?.id));
+    }
+    for (const button of element('panelRoles')
+             .querySelectorAll<HTMLElement>('button.role-button')) {
+      button.setAttribute(
+          'aria-selected',
+          String(button.dataset['role'] === this.stored.panelRole));
+    }
+
+    this.applyContent();
+  }
+
+  /**
+   * What the shell shows where a module would be.
+   *
+   * State 09: the skeleton does not change when there is nothing to show. The
+   * empty text goes in the mount points, and every width above is computed the
+   * same way it would be with a module present.
+   */
+  private applyContent(): void {
+    const name = this.current?.display_name ?? 'No module';
+    element('tabsTitle').textContent = name;
+    element('tabsCount').textContent = '0';
+    element('headerTitle').textContent = name;
+    element('headerPath').textContent = this.current?.id ?? '';
+
+    const tabsEmpty = element('tabsEmpty');
+    tabsEmpty.hidden = false;
+    tabsEmpty.textContent =
+        'This module contributes no tabs yet. The list is the module\'s to ' +
+        'fill; its width, its collapse and its selection are not.';
+
+    element('bodyEmpty').textContent = this.current ?
+        `${name} is declared in the registry and has no body to mount yet. ` +
+            'The header above belongs to the shell and does not change when ' +
+            'one arrives.' :
+        'No modules are registered.';
+
+    element('panelEmpty').textContent = `Nothing is mounted in the ${
+        this.stored.panelRole} role. One container, ${
+        geometry.PANEL_ROLES} roles; the shell switches between them and the ` +
+        'module fills them.';
+  }
+}
+
+document.addEventListener('DOMContentLoaded', function() {
+  const root = document.documentElement;
+  // Every measurement reaches CSS from geometry.ts, so the stylesheet names no
+  // number of its own and there is one place to change a width. MS-4.
+  root.style.setProperty('--sunshine-bar-height', `${geometry.BAR_HEIGHT}px`);
+  root.style.setProperty(
+      '--sunshine-header-height', `${geometry.HEADER_HEIGHT}px`);
+  root.style.setProperty(
+      '--sunshine-header-pad-left', `${geometry.HEADER_PAD_LEFT}px`);
+  root.style.setProperty(
+      '--sunshine-header-pad-right', `${geometry.HEADER_PAD_RIGHT}px`);
+  root.style.setProperty('--sunshine-body-min', `${geometry.BODY_MIN}px`);
+  root.style.setProperty(
+      '--sunshine-splitter-visual', `${geometry.SPLITTER_VISUAL}px`);
+  root.style.setProperty(
+      '--sunshine-splitter-hit', `${geometry.SPLITTER_HIT}px`);
+  root.style.setProperty('--sunshine-marker', '2px');
+  root.style.setProperty('--sunshine-dirty', '6px');
+
+  const registry =
+      JSON.parse(loadTimeData.getString('moduleRegistry')) as Registry;
+  new Shell(registry);
+});
