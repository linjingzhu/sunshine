diff --git a/chrome/browser/resources/sunshine/shell/app.css b/chrome/browser/resources/sunshine/shell/app.css
new file mode 100644
index 0000000..9445254
--- /dev/null
+++ b/chrome/browser/resources/sunshine/shell/app.css
@@ -0,0 +1,378 @@
+/* Copyright 2026 The Sunshine OS contributors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ *
+ * Colour comes from Chromium's pipeline through chrome://theme/colors.css and
+ * from nowhere else -- docs/DESIGN_SYSTEM_CONTRACT.md sections 2.1 and 2.3, no
+ * literal and no fallback. docs/MODULE_SHELL_CONTRACT.md section 7 records
+ * that the source drawing names Carbon hex values instead, and what settling
+ * that would cost.
+ *
+ * Widths are declared once as custom properties and then only referenced. The
+ * numbers themselves live in geometry.ts and are checked against the contract
+ * by scripts/verify_shell_geometry.py -- the properties below are set from
+ * that module at startup, so this file names no measurement it invents. MS-4.
+ */
+
+body {
+  background-color: var(--color-dialog-background);
+  color: var(--color-primary-foreground);
+  display: flex;
+  flex-direction: column;
+  height: 100vh;
+  margin: 0;
+  overflow: hidden;
+}
+
+.visually-hidden {
+  clip-path: inset(50%);
+  height: 1px;
+  overflow: hidden;
+  position: absolute;
+  white-space: nowrap;
+  width: 1px;
+}
+
+/* A -- the module bar ------------------------------------------------------ */
+
+#bar {
+  align-items: center;
+  block-size: var(--sunshine-bar-height);
+  border-bottom: 1px solid var(--color-midground);
+  display: flex;
+  flex: 0 0 auto;
+  gap: 0.5rem;
+  padding: 0 0.5rem;
+}
+
+.bar-button {
+  background: none;
+  border: 0;
+  border-radius: 0.25rem;
+  color: inherit;
+  cursor: pointer;
+  display: inline-flex;
+  font: inherit;
+  padding: 0.125rem 0.375rem;
+}
+
+.bar-button:hover {
+  background-color: var(--color-midground);
+}
+
+#barTitle {
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+}
+
+.bar-spacer {
+  flex: 1 1 auto;
+}
+
+.bar-note {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+}
+
+/* The five regions --------------------------------------------------------- */
+
+#page {
+  display: flex;
+  flex: 1 1 auto;
+  min-height: 0;
+}
+
+#left {
+  display: flex;
+  flex: 0 0 auto;
+  min-height: 0;
+}
+
+/* B -- the dock ------------------------------------------------------------ */
+
+#dock {
+  border-inline-end: 1px solid var(--color-midground);
+  display: flex;
+  flex-direction: column;
+  inline-size: var(--sunshine-dock-width);
+  overflow: hidden;
+  padding: 0.5rem 0;
+}
+
+#dockList {
+  flex: 1 1 auto;
+  list-style: none;
+  margin: 0;
+  overflow-y: auto;
+  padding: 0;
+}
+
+.dock-button {
+  align-items: center;
+  background: none;
+  border: 0;
+  border-inline-start: var(--sunshine-marker) solid transparent;
+  color: var(--color-secondary-foreground);
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  gap: 0.625rem;
+  inline-size: 100%;
+  padding: 0.5rem 0.75rem;
+  text-align: start;
+}
+
+.dock-button:hover {
+  background-color: var(--color-midground);
+}
+
+/* Selection is a marker plus a background, never a colour the theme did not
+ * provide. The label brightening is what tells icons-only mode apart from
+ * expanded mode without moving anything. */
+.dock-button[aria-current='true'] {
+  background-color: var(--color-midground);
+  border-inline-start-color: var(--color-primary-foreground);
+  color: var(--color-primary-foreground);
+}
+
+.dock-foot {
+  border-top: 1px solid var(--color-midground);
+  flex: 0 0 auto;
+}
+
+.tile {
+  block-size: 1.25rem;
+  border: 1px solid currentcolor;
+  border-radius: 0.25rem;
+  flex: 0 0 auto;
+  inline-size: 1.25rem;
+}
+
+.dock-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Icons-only hides the labels rather than unmounting them, so switching width
+ * cannot change what the keyboard reaches. */
+#page[data-dock='icons'] .dock-label {
+  clip-path: inset(50%);
+  inline-size: 1px;
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+/* C -- the tab list -------------------------------------------------------- */
+
+#tabs {
+  display: flex;
+  flex-direction: column;
+  inline-size: var(--sunshine-tabs-width);
+  min-height: 0;
+  overflow: hidden;
+}
+
+#tabsHead {
+  align-items: baseline;
+  color: var(--color-secondary-foreground);
+  display: flex;
+  font-size: 0.75rem;
+  font-weight: 600;
+  gap: 0.5rem;
+  letter-spacing: 0.04em;
+  padding: 0.75rem 1rem 0.5rem;
+  text-transform: uppercase;
+}
+
+#tabsList {
+  flex: 1 1 auto;
+  list-style: none;
+  margin: 0;
+  overflow-y: auto;
+  padding: 0;
+}
+
+.tab-button {
+  background: none;
+  border: 0;
+  border-inline-start: var(--sunshine-marker) solid transparent;
+  color: inherit;
+  cursor: pointer;
+  display: block;
+  font: inherit;
+  inline-size: 100%;
+  padding: 0.375rem 1rem;
+  text-align: start;
+}
+
+.tab-button:hover {
+  background-color: var(--color-midground);
+}
+
+.tab-button[aria-current='true'] {
+  background-color: var(--color-midground);
+  border-inline-start-color: var(--color-primary-foreground);
+}
+
+/* D -- the body ------------------------------------------------------------ */
+
+#body {
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-inline-size: var(--sunshine-body-min);
+  min-height: 0;
+}
+
+#header {
+  align-items: center;
+  block-size: var(--sunshine-header-height);
+  border-bottom: 1px solid var(--color-midground);
+  display: flex;
+  flex: 0 0 auto;
+  gap: 0.5rem;
+  padding-inline: var(--sunshine-header-pad-left) var(--sunshine-header-pad-right);
+}
+
+#headerTitle {
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+
+.path {
+  color: var(--color-secondary-foreground);
+  font-family: monospace;
+  font-size: 0.75rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* A square, not a recoloured icon: the drawing forbids deforming the icon to
+ * show unsaved state, so the marker is its own thing. */
+.dirty {
+  background-color: var(--color-primary-foreground);
+  block-size: var(--sunshine-dirty);
+  flex: 0 0 auto;
+  inline-size: var(--sunshine-dirty);
+}
+
+.header-spacer {
+  flex: 1 1 auto;
+}
+
+.header-button {
+  background: none;
+  border: 0;
+  border-radius: 0.25rem;
+  color: inherit;
+  cursor: pointer;
+  font: inherit;
+  padding: 0.25rem 0.5rem;
+}
+
+.header-button:hover {
+  background-color: var(--color-midground);
+}
+
+.mount {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow: auto;
+  padding: 1rem var(--sunshine-header-pad-left);
+}
+
+/* E -- the aux panel ------------------------------------------------------- */
+
+#panel {
+  border-inline-start: 1px solid var(--color-midground);
+  display: flex;
+  flex-direction: column;
+  flex: 0 0 auto;
+  inline-size: var(--sunshine-panel-width);
+  min-height: 0;
+}
+
+#panelHead {
+  border-bottom: 1px solid var(--color-midground);
+  display: flex;
+  flex: 0 0 auto;
+  gap: 0.25rem;
+  overflow-x: auto;
+  padding: 0.375rem 0.5rem;
+}
+
+.role-button {
+  background: none;
+  border: 0;
+  border-radius: 0.25rem;
+  color: var(--color-secondary-foreground);
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.75rem;
+  padding: 0.25rem 0.5rem;
+  white-space: nowrap;
+}
+
+.role-button[aria-selected='true'] {
+  background-color: var(--color-midground);
+  color: var(--color-primary-foreground);
+}
+
+/* Splitters ---------------------------------------------------------------- */
+
+/* Drawn narrow, targeted wide: the visual band is centred inside a hit area
+ * twice its width, because a 4px pointer target is a 4px pointer target
+ * however carefully it is drawn. */
+.splitter {
+  background: none;
+  border: 0;
+  cursor: col-resize;
+  flex: 0 0 auto;
+  inline-size: var(--sunshine-splitter-hit);
+  padding: 0;
+  position: relative;
+  touch-action: none;
+}
+
+.splitter::after {
+  background-color: var(--color-midground);
+  content: '';
+  inset-block: 0;
+  inline-size: var(--sunshine-splitter-visual);
+  inset-inline-start: calc(
+      (var(--sunshine-splitter-hit) - var(--sunshine-splitter-visual)) / 2);
+  position: absolute;
+  transition: background-color 100ms linear;
+}
+
+.splitter:hover::after,
+.splitter[data-dragging='true']::after {
+  background-color: var(--color-primary-foreground);
+}
+
+/* The drawing asks for a 100ms highlight with no easing. Someone who has asked
+ * the system for less motion has asked for this too -- the highlight still
+ * happens, it just arrives at once. */
+@media (prefers-reduced-motion: reduce) {
+  .splitter::after {
+    transition: none;
+  }
+}
+
+/* Focus and empty states --------------------------------------------------- */
+
+:focus-visible {
+  outline: 2px solid var(--color-primary-foreground);
+  outline-offset: 1px;
+}
+
+.empty {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.6;
+  margin: 0;
+  max-width: 34rem;
+}
