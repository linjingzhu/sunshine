+++ b/components/sunshine/document/order_key.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
+#define COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
+
+#include <string>
+#include <string_view>
+
+namespace sunshine::document {
+
+// An explicit order key for one node among its siblings.
+//
+// docs/decisions/0013-module-data-portability.md section 2.3 rules out
+// "ordering that depends on insertion sequence alone": a dense 0, 1, 2 index
+// has to renumber every later sibling on each insert, which turns one user
+// action into an edit of every neighbour and a merge into a conflict on nodes
+// nobody touched. A key that can be assigned *between* two existing
+// neighbours without disturbing either is the alternative, and the ADR is
+// explicit that it is "a choice about the field's type, made once".
+//
+// The type is a string ordered lexicographically over the 62 characters
+// '0'-'9', 'A'-'Z', 'a'-'z', in that order -- which is plain ASCII order, so
+// std::string's own comparison is the ordering and no comparator has to
+// travel with the data.
+//
+// One invariant makes the type dense: a key returned here never ends in the
+// lowest digit '0'. Without it there is no key between "V" and "V0", because
+// anything between must begin "V" and continue with a digit below '0'. With
+// it, a key strictly between any two keys this function produced always
+// exists. `ProjectStore` re-keys any stored value that violates the invariant
+// when it loads, so a hand-edited file cannot get the tree stuck.
+//
+// `before` empty means "before every sibling"; `after` empty means "after
+// every sibling". Both empty asks for the first key in an empty list.
+std::string OrderKeyBetween(std::string_view before, std::string_view after);
+
+// Whether `key` is one this file could have produced: non-empty, drawn from
+// the 62 digits, and not ending in the lowest one.
+bool IsWellFormedOrderKey(std::string_view key);
+
+}  // namespace sunshine::document
+
+#endif  // COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
