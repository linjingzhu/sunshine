+# Copyright 2026 The Sunshine OS contributors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# The document module's data layer, and the whole of it.
+# docs/decisions/0013-module-data-portability.md section 2.1 places a module's
+# model here rather than in the surface that displays it, and the reason is
+# stated in Chromium's own terms: components/ is where non-UI logic lives so
+# that ports whose UI and web engine have nothing in common can share it. The
+# dependency below is the rule in mechanical form -- //base and nothing else.
+# There is no //chrome dependency, no //content dependency, and no UI.
+#
+# There is also no network dependency, per section 2.4: a later, separately
+# reviewed component may read this data layer, but the data layer itself has
+# no client, no endpoint, and no knowledge that a second device could exist.
+#
+# This target is new. chrome/browser/ui/webui/sunshine/BUILD.gn -- a file the
+# seam patch created -- depends on it, so no upstream BUILD.gn is touched.
+
+source_set("document") {
+  sources = [
+    "document_model.cc",
+    "document_model.h",
+    "order_key.cc",
+    "order_key.h",
+    "project_store.cc",
+    "project_store.h",
+  ]
+
+  public_deps = [ "//base" ]
+}
diff --git a/components/sunshine/document/document_model.cc b/components/sunshine/document/document_model.cc
new file mode 100644
index 0000000..bbde38b
--- /dev/null
+++ b/components/sunshine/document/document_model.cc
@@ -0,0 +1,263 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sunshine/document/document_model.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+#include "base/json/values_util.h"
+#include "components/sunshine/document/order_key.h"
+
+namespace sunshine::document {
+
+namespace {
+
+// Field names of the stored form. They are the model's names, not a path, a
+// filename, or anything else that could reintroduce the filesystem as the
+// model (DOC-6).
+constexpr char kId[] = "id";
+constexpr char kTitle[] = "title";
+constexpr char kTitleModified[] = "title_modified";
+constexpr char kNodes[] = "nodes";
+constexpr char kDocuments[] = "documents";
+constexpr char kParent[] = "parent";
+constexpr char kDocument[] = "document";
+constexpr char kOrderKey[] = "order_key";
+constexpr char kOrderModified[] = "order_modified";
+constexpr char kBody[] = "body";
+constexpr char kBodyModified[] = "body_modified";
+
+base::Uuid ReadUuid(const base::DictValue& value, const char* key) {
+  const std::string* text = value.FindString(key);
+  return text ? base::Uuid::ParseLowercase(*text) : base::Uuid();
+}
+
+base::Time ReadTime(const base::DictValue& value, const char* key) {
+  const base::Value* stored = value.Find(key);
+  if (!stored) {
+    return base::Time();
+  }
+  return base::ValueToTime(*stored).value_or(base::Time());
+}
+
+void WriteUuid(base::DictValue& value, const char* key, const base::Uuid& id) {
+  if (id.is_valid()) {
+    value.Set(key, id.AsLowercaseString());
+  }
+}
+
+}  // namespace
+
+Document::Document() = default;
+Document::Document(const Document&) = default;
+Document& Document::operator=(const Document&) = default;
+Document::Document(Document&&) = default;
+Document& Document::operator=(Document&&) = default;
+Document::~Document() = default;
+
+Node::Node() = default;
+Node::Node(const Node&) = default;
+Node& Node::operator=(const Node&) = default;
+Node::Node(Node&&) = default;
+Node& Node::operator=(Node&&) = default;
+Node::~Node() = default;
+
+Project::Project() = default;
+Project::Project(const Project&) = default;
+Project& Project::operator=(const Project&) = default;
+Project::Project(Project&&) = default;
+Project& Project::operator=(Project&&) = default;
+Project::~Project() = default;
+
+std::vector<const Node*> ReadingOrder(const Project& project) {
+  // Children keyed by parent. The empty string keys the roots, because an
+  // invalid Uuid has no lowercase form and a project's roots are exactly the
+  // nodes whose parent is invalid.
+  std::map<std::string, std::vector<const Node*>> children;
+  for (const Node& node : project.nodes) {
+    children[node.parent.is_valid() ? node.parent.AsLowercaseString()
+                                    : std::string()]
+        .push_back(&node);
+  }
+
+  for (auto& [parent, siblings] : children) {
+    // Order key first, identity second. The tie-break is on the stable
+    // identifier rather than on position in the vector, so two devices that
+    // somehow assigned the same key still agree on the order they display.
+    std::sort(siblings.begin(), siblings.end(),
+              [](const Node* left, const Node* right) {
+                if (left->order_key != right->order_key) {
+                  return left->order_key < right->order_key;
+                }
+                return left->id.AsLowercaseString() <
+                       right->id.AsLowercaseString();
+              });
+  }
+
+  std::vector<const Node*> order;
+  // An explicit stack rather than recursion: the hierarchy comes from stored
+  // data, and a deep or cyclic file must not be able to exhaust the stack.
+  // `seen` also makes a cycle terminate instead of looping.
+  std::vector<const Node*> pending;
+  std::map<std::string, bool> seen;
+  const auto roots = children.find(std::string());
+  if (roots != children.end()) {
+    for (auto sibling = roots->second.rbegin(); sibling != roots->second.rend();
+         ++sibling) {
+      pending.push_back(*sibling);
+    }
+  }
+  while (!pending.empty()) {
+    const Node* node = pending.back();
+    pending.pop_back();
+    const std::string key = node->id.AsLowercaseString();
+    if (seen[key]) {
+      continue;
+    }
+    seen[key] = true;
+    order.push_back(node);
+    const auto found = children.find(key);
+    if (found == children.end()) {
+      continue;
+    }
+    for (auto child = found->second.rbegin(); child != found->second.rend();
+         ++child) {
+      pending.push_back(*child);
+    }
+  }
+  return order;
+}
+
+const Node* FindNode(const Project& project, const base::Uuid& id) {
+  for (const Node& node : project.nodes) {
+    if (node.id == id) {
+      return &node;
+    }
+  }
+  return nullptr;
+}
+
+const Document* FindDocumentFor(const Project& project, const Node& node) {
+  if (!node.document.is_valid()) {
+    return nullptr;
+  }
+  for (const Document& document : project.documents) {
+    if (document.id == node.document) {
+      return &document;
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue ToValue(const Project& project) {
+  base::ListValue nodes;
+  for (const Node& node : project.nodes) {
+    base::DictValue stored;
+    WriteUuid(stored, kId, node.id);
+    WriteUuid(stored, kParent, node.parent);
+    WriteUuid(stored, kDocument, node.document);
+    stored.Set(kTitle, node.title);
+    stored.Set(kOrderKey, node.order_key);
+    stored.Set(kTitleModified, base::TimeToValue(node.title_modified));
+    stored.Set(kOrderModified, base::TimeToValue(node.order_modified));
+    nodes.Append(std::move(stored));
+  }
+
+  base::ListValue documents;
+  for (const Document& document : project.documents) {
+    base::DictValue stored;
+    WriteUuid(stored, kId, document.id);
+    // Stored and returned unchanged; see DOC-4 and the Document comment.
+    stored.Set(kBody, document.body);
+    stored.Set(kBodyModified, base::TimeToValue(document.body_modified));
+    documents.Append(std::move(stored));
+  }
+
+  base::DictValue value;
+  WriteUuid(value, kId, project.id);
+  value.Set(kTitle, project.title);
+  value.Set(kTitleModified, base::TimeToValue(project.title_modified));
+  value.Set(kNodes, std::move(nodes));
+  value.Set(kDocuments, std::move(documents));
+  return value;
+}
+
+std::optional<Project> FromValue(const base::DictValue& value) {
+  Project project;
+  project.id = ReadUuid(value, kId);
+  if (!project.id.is_valid()) {
+    // A project with no identity is not a project this layer can talk about:
+    // nothing could name it, and a later merge could not match it. Dropping it
+    // is the only honest reading, because inventing an identifier here is the
+    // retrofit section 2.2 describes, one file at a time.
+    return std::nullopt;
+  }
+  const std::string* title = value.FindString(kTitle);
+  project.title = title ? *title : std::string();
+  project.title_modified = ReadTime(value, kTitleModified);
+
+  if (const base::ListValue* nodes = value.FindList(kNodes)) {
+    for (const base::Value& entry : *nodes) {
+      const base::DictValue* stored = entry.GetIfDict();
+      if (!stored) {
+        continue;
+      }
+      Node node;
+      node.id = ReadUuid(*stored, kId);
+      if (!node.id.is_valid()) {
+        continue;
+      }
+      node.parent = ReadUuid(*stored, kParent);
+      node.document = ReadUuid(*stored, kDocument);
+      const std::string* node_title = stored->FindString(kTitle);
+      node.title = node_title ? *node_title : std::string();
+      const std::string* order_key = stored->FindString(kOrderKey);
+      node.order_key = order_key ? *order_key : std::string();
+      node.title_modified = ReadTime(*stored, kTitleModified);
+      node.order_modified = ReadTime(*stored, kOrderModified);
+      project.nodes.push_back(std::move(node));
+    }
+  }
+
+  if (const base::ListValue* documents = value.FindList(kDocuments)) {
+    for (const base::Value& entry : *documents) {
+      const base::DictValue* stored = entry.GetIfDict();
+      if (!stored) {
+        continue;
+      }
+      Document document;
+      document.id = ReadUuid(*stored, kId);
+      if (!document.id.is_valid()) {
+        continue;
+      }
+      const std::string* body = stored->FindString(kBody);
+      document.body = body ? *body : std::string();
+      document.body_modified = ReadTime(*stored, kBodyModified);
+      project.documents.push_back(std::move(document));
+    }
+  }
+
+  // Re-key anything the order-key type cannot use. A stored key that violates
+  // order_key.h's invariant would leave a gap nothing can be inserted into, so
+  // it is repaired on the way in rather than allowed to wedge the tree. The
+  // repair preserves the order the file already expressed: the keys are
+  // rebuilt in the order the malformed values sorted in.
+  std::vector<Node*> unusable;
+  for (Node& node : project.nodes) {
+    if (!IsWellFormedOrderKey(node.order_key)) {
+      unusable.push_back(&node);
+    }
+  }
+  std::string previous;
+  for (Node* node : unusable) {
+    node->order_key = OrderKeyBetween(previous, std::string_view());
+    previous = node->order_key;
+  }
+
+  return project;
+}
+
+}  // namespace sunshine::document
diff --git a/components/sunshine/document/document_model.h b/components/sunshine/document/document_model.h
new file mode 100644
index 0000000..3cadbbc
--- /dev/null
+++ b/components/sunshine/document/document_model.h
@@ -0,0 +1,128 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SUNSHINE_DOCUMENT_DOCUMENT_MODEL_H_
+#define COMPONENTS_SUNSHINE_DOCUMENT_DOCUMENT_MODEL_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "base/values.h"
+
+namespace sunshine::document {
+
+// A project of documents, arranged in a hierarchy.
+//
+// Two rules shape every type below and are worth stating once here rather than
+// on each field.
+//
+// **Identity is not position** --
+// docs/decisions/0013-module-data-portability.md section 2.2. Every project,
+// node and document carries a `base::Uuid` that survives being moved in the
+// hierarchy, renamed, or edited on another device. The shape is Chromium's
+// own: components/bookmarks/browser/bookmark_node.h at 152.0.7977.42 carries
+// an `int64_t id_` that is local to one device beside a UUID whose header says
+// it "is consistent across different clients". A model with only the first
+// kind of identifier cannot say "this is the same node you have". Sunshine
+// keeps only the second kind, because it has no session-restore mapping that
+// needs a small integer and a second identifier nothing reads is a second
+// identifier that can drift.
+//
+// **A node names a document; it never names a location on disk** -- DOC-6.
+// `Node::document` is a `base::Uuid`, and no type here has a path field. How
+// the bytes reach the disk is `ProjectStore`'s business and appears nowhere in
+// the model, which is what makes DOCA-2 decidable by reading this header.
+
+// One stored document body.
+//
+// The body is opaque to this layer. DOC-4 fixes that "the stored document is
+// never rewritten to paginate, so what is read back is what was stored", so
+// nothing here parses, normalises, or re-serialises it -- pagination is the
+// shell's presentation problem and never reaches storage.
+struct Document {
+  Document();
+  Document(const Document&);
+  Document& operator=(const Document&);
+  Document(Document&&);
+  Document& operator=(Document&&);
+  ~Document();
+
+  base::Uuid id;
+  std::string body;
+  base::Time body_modified;
+};
+
+// One node of the hierarchy: a title, an order among its siblings, and either
+// children or a document.
+struct Node {
+  Node();
+  Node(const Node&);
+  Node& operator=(const Node&);
+  Node(Node&&);
+  Node& operator=(Node&&);
+  ~Node();
+
+  base::Uuid id;
+  // Invalid for a node at the root of its project.
+  base::Uuid parent;
+  // Invalid for a node that carries children rather than a body.
+  base::Uuid document;
+  std::string title;
+  // See components/sunshine/document/order_key.h.
+  std::string order_key;
+
+  // Section 2.3 rules out "last-write-wins over a whole record where a
+  // field-level merge was possible": a title edit on one device and a reorder
+  // on the other are independent changes, and collapsing them into one
+  // last-modified stamp destroys one of them for no reason but the storage
+  // shape. These two fields do not decide a conflict policy -- the ADR leaves
+  // that open -- they preserve the possibility of deciding it well.
+  base::Time title_modified;
+  base::Time order_modified;
+};
+
+// A named hierarchy of documents.
+struct Project {
+  Project();
+  Project(const Project&);
+  Project& operator=(const Project&);
+  Project(Project&&);
+  Project& operator=(Project&&);
+  ~Project();
+
+  base::Uuid id;
+  std::string title;
+  base::Time title_modified;
+  std::vector<Node> nodes;
+  std::vector<Document> documents;
+};
+
+// The reading order: the depth-first traversal of the hierarchy, siblings in
+// order key order. docs/DOCUMENT_SURFACE_CONTRACT.md section 3 fixes this and
+// says why -- it makes the structure the table of contents rather than
+// something separate to maintain, and a node moved in the tree moves in the
+// reading order too. Nothing else in Sunshine may define a second order.
+//
+// Nodes whose parent is missing are unreachable rather than silently promoted
+// to the root: promoting them would invent an order the author never gave.
+std::vector<const Node*> ReadingOrder(const Project& project);
+
+// The node with `id`, or null.
+const Node* FindNode(const Project& project, const base::Uuid& id);
+
+// The document body `node` names, or null when it names none.
+const Document* FindDocumentFor(const Project& project, const Node& node);
+
+// Serialisation. The on-disk representation is an implementation detail of
+// this layer: it is a `base::DictValue` here and JSON on disk, and no caller
+// above this layer sees either.
+base::DictValue ToValue(const Project& project);
+std::optional<Project> FromValue(const base::DictValue& value);
+
+}  // namespace sunshine::document
+
+#endif  // COMPONENTS_SUNSHINE_DOCUMENT_DOCUMENT_MODEL_H_
diff --git a/components/sunshine/document/order_key.cc b/components/sunshine/document/order_key.cc
