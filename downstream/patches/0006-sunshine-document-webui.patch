+/* Copyright 2026 The Sunshine OS contributors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ *
+ * Every colour here is read from Chromium's colour pipeline through
+ * chrome://theme/colors.css. Sunshine declares no colour of its own and no
+ * fallback, per docs/DESIGN_SYSTEM_CONTRACT.md sections 2.1 and 2.3: a missing
+ * token must fail visibly rather than silently escape the theme. The roles
+ * used here are the ones section 3 already binds -- surface background,
+ * primary and secondary foreground, outline -- and no new binding is invented
+ * for this surface.
+ *
+ * Sizes come from the section 6.2 scale and are declared in rem, so they track
+ * the user's browser font-size setting. */
+
+body {
+  background-color: var(--color-dialog-background);
+  color: var(--color-primary-foreground);
+  margin: 0;
+}
+
+#page {
+  margin: 0 auto;
+  max-width: 60rem;
+  padding: 2rem 1.5rem;
+}
+
+h1 {
+  font-size: 1.5rem;
+  font-weight: 500;
+  line-height: 1.25;
+  margin: 0 0 0.5rem;
+}
+
+h2 {
+  font-size: 1.25rem;
+  font-weight: 500;
+  line-height: 1.3;
+  margin: 2rem 0 0.75rem;
+}
+
+.note {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.43;
+  margin: 0 0 1rem;
+}
+
+.row {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  margin: 0 0 0.75rem;
+}
+
+label {
+  font-size: 0.875rem;
+  line-height: 1.43;
+}
+
+input,
+select,
+textarea,
+button {
+  background-color: var(--color-dialog-background);
+  border: 1px solid var(--color-midground);
+  border-radius: 0.25rem;
+  color: var(--color-primary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.43;
+  padding: 0.375rem 0.5rem;
+}
+
+textarea {
+  /* Alignment carries meaning in markup, which section 6.1 names as the one
+   * case where the bare generic keyword is permitted. */
+  font-family: monospace;
+  min-height: 12rem;
+  resize: vertical;
+  width: 100%;
+}
+
+button {
+  cursor: pointer;
+  font-weight: 500;
+}
+
+:focus-visible {
+  outline: 2px solid var(--color-primary-foreground);
+  outline-offset: 2px;
+}
+
+#contents {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+#contents li {
+  border-top: 1px solid var(--color-midground);
+}
+
+.entry {
+  background-color: var(--color-dialog-background);
+  border: 0;
+  border-radius: 0;
+  display: block;
+  font-size: 0.875rem;
+  font-weight: 400;
+  line-height: 1.43;
+  padding: 0.5rem;
+  text-align: start;
+  width: 100%;
+}
+
+.entry[aria-current='true'] {
+  font-weight: 600;
+}
+
+.entry .marker {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+  line-height: 1.33;
+}
+
+#reader {
+  border: 1px solid var(--color-midground);
+  border-radius: 0.25rem;
+  display: block;
+  height: 28rem;
+  width: 100%;
+}
+
+.empty {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.43;
+  margin: 0;
+}
+
+/* Depth is expressed as a declared attribute and matched here, rather than as
+ * an inline style built from a number at runtime. Six steps is what the rules
+ * cover; a deeper node keeps the sixth indent rather than growing without
+ * bound, which is a presentation decision and touches nothing stored. */
+.entry[data-depth='1'] {
+  padding-inline-start: 1.5rem;
+}
+
+.entry[data-depth='2'] {
+  padding-inline-start: 2.5rem;
+}
+
+.entry[data-depth='3'] {
+  padding-inline-start: 3.5rem;
+}
+
+.entry[data-depth='4'] {
+  padding-inline-start: 4.5rem;
+}
+
+.entry[data-depth='5'] {
+  padding-inline-start: 5.5rem;
+}
diff --git a/chrome/browser/resources/sunshine/document/app.html b/chrome/browser/resources/sunshine/document/app.html
new file mode 100644
index 0000000..1108c01
--- /dev/null
+++ b/chrome/browser/resources/sunshine/document/app.html
@@ -0,0 +1,77 @@
+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine Documents</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <main id="page">
+    <h1>Sunshine Documents</h1>
+    <p class="note">
+      A project is a hierarchy of documents. The table of contents below is the
+      reading order: the depth-first traversal of that hierarchy, so a node
+      moved in the tree moves in the reading order with it.
+    </p>
+
+    <h2>Projects</h2>
+    <div class="row">
+      <label for="projectList">Project</label>
+      <select id="projectList"></select>
+      <button id="deleteProject" type="button">Delete project</button>
+    </div>
+    <div class="row">
+      <label for="projectTitle">New project</label>
+      <input id="projectTitle" type="text" autocomplete="off">
+      <button id="createProject" type="button">Create project</button>
+    </div>
+    <p class="empty" id="noProjects" hidden>
+      There are no projects yet. Create one to begin.
+    </p>
+
+    <h2>Table of contents</h2>
+    <div class="row">
+      <label for="nodeParent">Inside</label>
+      <select id="nodeParent"></select>
+      <label for="nodeTitle">New section</label>
+      <input id="nodeTitle" type="text" autocomplete="off">
+      <button id="createNode" type="button">Add section</button>
+    </div>
+    <!-- Every entry here is created by app.js as an element whose text is
+         assigned with textContent. No project string is ever parsed as markup
+         in this document: DOC-1 and DOCA-1. -->
+    <ol id="contents"></ol>
+    <p class="empty" id="noNodes" hidden>
+      This project has no sections yet.
+    </p>
+
+    <h2>Document</h2>
+    <p class="note">
+      What you write here is stored exactly as typed and is never rendered on
+      this page. It is shown in the reading frame below, which runs at no
+      privilege and can reach no network.
+    </p>
+    <label for="editor">HTML for the selected section</label>
+    <textarea id="editor" spellcheck="false"></textarea>
+    <div class="row">
+      <button id="saveDocument" type="button">Save document</button>
+      <span class="note" id="saveState" role="status"></span>
+    </div>
+
+    <h2>Reading</h2>
+    <div class="row">
+      <button id="previous" type="button">Previous</button>
+      <button id="next" type="button">Next</button>
+      <span class="note" id="position" role="status"></span>
+    </div>
+    <!-- The one place project content is rendered. The frame is Chromium's own
+         untrusted scheme; Sunshine registers no scheme (SEC-13, ADR 0003). -->
+    <iframe id="reader" title="Document content"
+            src="chrome-untrusted://sunshine-document-content/"></iframe>
+  </main>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/sunshine/document/app.ts b/chrome/browser/resources/sunshine/document/app.ts
new file mode 100644
index 0000000..6576656
--- /dev/null
+++ b/chrome/browser/resources/sunshine/document/app.ts
@@ -0,0 +1,288 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import type {DocumentNode, DocumentProject, DocumentStructure} from './host.js';
+import {documentHost} from './host.js';
+
+/**
+ * The privileged shell: project list, table of contents, controls.
+ *
+ * Two rules govern everything below, and both are absences rather than
+ * filters.
+ *
+ * **No project content is rendered here** (DOC-1, DOCA-1). Titles reach the
+ * document through `textContent` on elements this file created; nothing is
+ * ever assigned to `innerHTML`, no markup is parsed, and no template is filled
+ * with project strings. A document body passes through this file as a string
+ * on its way to the frame and is never put into this document at all -- not
+ * even into the textarea's markup, which is set through `value`.
+ *
+ * **The frame is sent content, never capability** (DOC-2). The only thing this
+ * file posts to the frame is the document body: one string, whole, with no
+ * field beside it. There is no identifier, no name and no verb in the message,
+ * so there is nothing in it the frame could use to ask for something else. In
+ * the other direction this file registers no message listener at all, which is
+ * the strongest available reading of "the frame sends back nothing that can
+ * name a resource, a path, or an operation" -- it can send nothing that is
+ * listened to. Readiness comes from the iframe's own `load` event, which is a
+ * fact about the element rather than a claim by its content.
+ *
+ * Everything it asks of its host goes through `documentHost` (./host.ts), per
+ * section 2.5 of docs/decisions/0013-module-data-portability.md.
+ */
+
+/** The origin of the reading frame. Chromium's scheme, not Sunshine's. */
+const READER_ORIGIN = 'chrome-untrusted://sunshine-document-content';
+
+interface State {
+  structure: DocumentStructure;
+  projectId: string;
+  nodeId: string;
+  readerReady: boolean;
+  pending: string|null;
+}
+
+const state: State = {
+  structure: {projects: []},
+  projectId: '',
+  nodeId: '',
+  readerReady: false,
+  pending: null,
+};
+
+function required<T extends HTMLElement>(id: string): T {
+  const element = document.body.querySelector<T>('#' + id);
+  if (!element) {
+    throw new Error('missing element: ' + id);
+  }
+  return element;
+}
+
+function currentProject(): DocumentProject|null {
+  for (const project of state.structure.projects) {
+    if (project.id === state.projectId) {
+      return project;
+    }
+  }
+  return null;
+}
+
+function reveal(id: string, visible: boolean) {
+  required(id).toggleAttribute('hidden', !visible);
+}
+
+/**
+ * Sends one document body to the frame. The message is the body and nothing
+ * else; see the DOC-2 note above.
+ */
+function showInReader(body: string) {
+  const frame = required<HTMLIFrameElement>('reader');
+  if (!state.readerReady || !frame.contentWindow) {
+    state.pending = body;
+    return;
+  }
+  state.pending = null;
+  frame.contentWindow.postMessage(body, READER_ORIGIN);
+}
+
+function renderProjects() {
+  const list = required<HTMLSelectElement>('projectList');
+  list.replaceChildren();
+  for (const project of state.structure.projects) {
+    const option = document.createElement('option');
+    option.value = project.id;
+    // Assigned as text. A project title is data and is never markup here.
+    option.textContent = project.title;
+    option.selected = project.id === state.projectId;
+    list.appendChild(option);
+  }
+  reveal('noProjects', state.structure.projects.length === 0);
+}
+
+function renderContents() {
+  const project = currentProject();
+  const nodes: DocumentNode[] = project ? project.nodes : [];
+
+  const parents = required<HTMLSelectElement>('nodeParent');
+  parents.replaceChildren();
+  const top = document.createElement('option');
+  top.value = '';
+  top.textContent = 'Top level';
+  parents.appendChild(top);
+
+  const contents = required<HTMLOListElement>('contents');
+  contents.replaceChildren();
+
+  nodes.forEach((node) => {
+    const parentOption = document.createElement('option');
+    parentOption.value = node.id;
+    parentOption.textContent = node.title;
+    parents.appendChild(parentOption);
+
+    const item = document.createElement('li');
+    const entry = document.createElement('button');
+    entry.type = 'button';
+    entry.className = 'entry';
+    // Six indents are declared in app.css; deeper nodes keep the last one.
+    entry.dataset['depth'] = String(Math.min(node.depth, 5));
+    entry.setAttribute('aria-current', String(node.id === state.nodeId));
+
+    const title = document.createElement('span');
+    title.textContent = node.title;
+    entry.appendChild(title);
+
+    const marker = document.createElement('span');
+    marker.className = 'marker';
+    marker.textContent =
+        node.hasDocument ? ' · has a document' : ' · empty';
+    entry.appendChild(marker);
+
+    entry.addEventListener('click', () => {
+      void selectNode(node.id);
+    });
+    item.appendChild(entry);
+    contents.appendChild(item);
+  });
+
+  reveal('noNodes', nodes.length === 0);
+
+  // Where the selected section sits in the reading order. This is a count of
+  // positions in the depth-first traversal, not a page count: nothing here
+  // divides a document into pages, and nothing stored is rewritten to produce
+  // it (DOC-4).
+  const position = nodes.findIndex((node) => node.id === state.nodeId);
+  if (nodes.length === 0) {
+    required('position').textContent = '';
+  } else if (position < 0) {
+    required('position').textContent = 'Nothing selected';
+  } else {
+    required('position').textContent = 'Reading ' + String(position + 1) +
+        ' of ' + String(nodes.length) + ' in reading order';
+  }
+}
+
+function render() {
+  renderProjects();
+  renderContents();
+}
+
+async function selectNode(nodeId: string) {
+  state.nodeId = nodeId;
+  const body = await documentHost.readDocument(state.projectId, nodeId);
+  // `value`, not markup: the body is never parsed by this document.
+  required<HTMLTextAreaElement>('editor').value = body;
+  required('saveState').textContent = '';
+  showInReader(body);
+  renderContents();
+}
+
+function step(offset: number) {
+  const project = currentProject();
+  if (!project || project.nodes.length === 0) {
+    return;
+  }
+  let index = project.nodes.findIndex((node) => node.id === state.nodeId);
+  if (index < 0) {
+    index = offset > 0 ? -1 : project.nodes.length;
+  }
+  const next = index + offset;
+  if (next < 0 || next >= project.nodes.length) {
+    return;
+  }
+  // Moving through the reading order is presentation. Nothing stored changes,
+  // and no document is rewritten to make it possible (DOC-4).
+  void selectNode(project.nodes[next]!.id);
+}
+
+function adopt(structure: DocumentStructure) {
+  state.structure = structure;
+  const project = currentProject();
+  if (!project) {
+    const first = structure.projects[0];
+    state.projectId = first ? first.id : '';
+    state.nodeId = '';
+    required<HTMLTextAreaElement>('editor').value = '';
+    showInReader('');
+  }
+  render();
+}
+
+function attach() {
+  const frame = required<HTMLIFrameElement>('reader');
+  frame.addEventListener('load', () => {
+    state.readerReady = true;
+    if (state.pending !== null) {
+      showInReader(state.pending);
+    }
+  });
+
+  required('projectList').addEventListener('change', () => {
+    state.projectId = required<HTMLSelectElement>('projectList').value;
+    state.nodeId = '';
+    required<HTMLTextAreaElement>('editor').value = '';
+    showInReader('');
+    render();
+  });
+
+  required('createProject').addEventListener('click', () => {
+    const title = required<HTMLInputElement>('projectTitle');
+    if (title.value.trim() === '') {
+      return;
+    }
+    void documentHost.createProject(title.value.trim()).then((structure) => {
+      title.value = '';
+      adopt(structure);
+    });
+  });
+
+  required('deleteProject').addEventListener('click', () => {
+    if (state.projectId === '') {
+      return;
+    }
+    // DOC-7: the documents go with the project. Nothing here has to sweep for
+    // them, because the store keeps them inside it.
+    void documentHost.deleteProject(state.projectId).then((structure) => {
+      state.projectId = '';
+      state.nodeId = '';
+      adopt(structure);
+    });
+  });
+
+  required('createNode').addEventListener('click', () => {
+    const title = required<HTMLInputElement>('nodeTitle');
+    if (state.projectId === '' || title.value.trim() === '') {
+      return;
+    }
+    const parent = required<HTMLSelectElement>('nodeParent').value;
+    void documentHost.createNode(state.projectId, parent, title.value.trim())
+        .then((structure) => {
+          title.value = '';
+          adopt(structure);
+        });
+  });
+
+  required('saveDocument').addEventListener('click', () => {
+    if (state.projectId === '' || state.nodeId === '') {
+      return;
+    }
+    const body = required<HTMLTextAreaElement>('editor').value;
+    void documentHost.writeDocument(state.projectId, state.nodeId, body)
+        .then((stored) => {
+          required('saveState').textContent =
+              stored ? 'Saved.' : 'Not saved.';
+          if (stored) {
+            showInReader(body);
+            void documentHost.load().then(adopt);
+          }
+        });
+  });
+
+  required('previous').addEventListener('click', () => step(-1));
+  required('next').addEventListener('click', () => step(1));
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  attach();
+  void documentHost.load().then(adopt);
+});
diff --git a/chrome/browser/resources/sunshine/document/host.ts b/chrome/browser/resources/sunshine/document/host.ts
new file mode 100644
index 0000000..a9cc900
--- /dev/null
+++ b/chrome/browser/resources/sunshine/document/host.ts
@@ -0,0 +1,133 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {DocumentHost as DocumentHostMojo} from './sunshine_document.mojom-webui.js';
+import type {DocumentHostRemote, DocumentStructure} from './sunshine_document.mojom-webui.js';
+
+/**
+ * The document surface's one interface to whatever hosts it.
+ *
+ * docs/decisions/0013-module-data-portability.md section 2.5: "A module's web
+ * assets communicate with whatever hosts them through a single, named,
+ * explicitly-declared interface, and through nothing else. No scattered calls
+ * to Chromium-specific globals, no assumption about which object delivers a
+ * message, no reaching past the interface because a browser API happens to be
+ * in scope. The interface is the module's whole contract with its container."
+ *
+ * This file is that interface's page half, and it is the only file in
+ * chrome/browser/resources/sunshine/document/ that names anything
+ * Chromium-specific. app.ts imports `documentHost` and knows nothing else about
+ * its container: it never calls chrome.send, never reads loadTimeData, never
+ * touches a chrome:// URL, and it does not name Mojo either. A second host --
+ * the WKWebView shell that section 2.5 exists for -- replaces this file and
+ * nothing else.
+ *
+ * **Mojo made section 2.5 stronger, not weaker, and the reason is where the
+ * interface is declared.** It used to be declared twice: as six message-name
+ * strings here and as six matching RegisterMessageCallback() calls in the
+ * browser, with nothing but a comment holding the two lists in agreement, and
+ * nothing at all checking that a request carried the arguments its handler
+ * expected. It is now declared once, in
+ * chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom, and both
+ * halves are generated from that one file. The six requests below are the six
+ * methods of `DocumentHost` in that .mojom; a seventh is added there and
+ * appears on both sides, or the build fails. "A single, named,
+ * explicitly-declared interface" is now a declaration rather than a
+ * convention.
+ *
+ * Nothing crossing this boundary names a file, a directory, or any other
+ * location. Identifiers are opaque strings, a node names a document Sunshine
+ * stores and never a location on disk (DOC-6), and this is the boundary at
+ * which that could otherwise be quietly reintroduced.
+ *
+ * The untrusted frame is not a party to any of this. It is given no Mojo
+ * interface at all; it receives one document body by postMessage and nothing
+ * else, which is DOC-2 as an absence rather than as a filter.
+ *
+ * **About the two import specifiers above.** The generated bindings are served
+ * out of this surface's own directory of Sunshine's one resource bundle, beside
+ * this file, so naming them is an ordinary relative import. The bindings' own
+ * import of the Mojo library is the scheme-relative
+ * "//resources/mojo/mojo/public/js/bindings.js" that
+ * mojo/public/tools/bindings/generators/mojom_ts_generator.py emits
+ * unconditionally -- `_GetBindingsLibraryPath()` returns that literal string --
+ * which is exactly the form tools/typescript/path_mappings.py provides a
+ * mapping for under the webui_context_type = "relative" that
+ * chrome/browser/resources/sunshine/BUILD.gn sets, and which resolves against
+ * the page's own scheme at runtime rather than pinning the bundle to one.
+ */
+
+/**
+ * The table of contents, its entries in reading order, and the projects they
+ * belong to.
+ *
+ * These are the mojom's structs, re-exported rather than restated. A
+ * hand-written copy of a generated shape is a copy that can disagree with the
+ * generator, and app.ts imports them from here so that it still has no reason
+ * to name the bindings.
+ */
+export type {
+  DocumentNode,
+  DocumentProject,
+  DocumentStructure,
+} from './sunshine_document.mojom-webui.js';
+
+/**
+ * What the surface may ask of its host. Structure-returning requests answer
+ * with the whole structure rather than a delta, so the page never has to keep
+ * a second copy of the model in agreement with the first.
+ */
+export interface DocumentHost {
+  load(): Promise<DocumentStructure>;
+  createProject(title: string): Promise<DocumentStructure>;
+  createNode(projectId: string, parentId: string, title: string):
+      Promise<DocumentStructure>;
+  deleteProject(projectId: string): Promise<DocumentStructure>;
+  /** The stored bytes of the document a node names, or the empty string. */
+  readDocument(projectId: string, nodeId: string): Promise<string>;
+  writeDocument(projectId: string, nodeId: string, body: string):
+      Promise<boolean>;
+}
+
+// Bound on first use rather than at import time, so nothing here reaches for a
+// pipe before the page has decided it needs its host.
+let remote: DocumentHostRemote|null = null;
+
+function host(): DocumentHostRemote {
+  if (remote === null) {
+    remote = DocumentHostMojo.getRemote();
+  }
+  return remote;
+}
+
+// The six requests, written out rather than assembled, so that a search for one
+// of them finds this file and the .mojom at once. Each unwraps the one named
+// response field the generated bindings deliver; that unwrapping is the whole
+// of the difference between this file and the interface above it.
+export const documentHost: DocumentHost = {
+  load() {
+    return host().load().then((response) => response.structure);
+  },
+  createProject(title: string) {
+    return host().createProject(title).then((response) => response.structure);
+  },
+  createNode(projectId: string, parentId: string, title: string) {
+    return host()
+        .createNode(projectId, parentId, title)
+        .then((response) => response.structure);
+  },
+  deleteProject(projectId: string) {
+    return host().deleteProject(projectId).then(
+        (response) => response.structure);
+  },
+  readDocument(projectId: string, nodeId: string) {
+    return host().readDocument(projectId, nodeId).then(
+        (response) => response.body);
+  },
+  writeDocument(projectId: string, nodeId: string, body: string) {
+    return host()
+        .writeDocument(projectId, nodeId, body)
+        .then((response) => response.stored);
+  },
+};
