diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom b/chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom
new file mode 100644
index 0000000..147f90d
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom
@@ -0,0 +1,99 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The document surface's one interface to whatever hosts it.
+//
+// docs/decisions/0013-module-data-portability.md section 2.5: "A module's web
+// assets communicate with whatever hosts them through a single, named,
+// explicitly-declared interface, and through nothing else. No scattered calls
+// to Chromium-specific globals, no assumption about which object delivers a
+// message, no reaching past the interface because a browser API happens to be
+// in scope. The interface is the module's whole contract with its container."
+//
+// **Mojo makes that rule stronger, not weaker, and this file is why.** Under
+// the chrome.send arrangement this replaced, the interface existed twice: once
+// as a list of string message names in host.ts and once as the matching list of
+// RegisterMessageCallback() calls in the browser. Nothing but a comment tied
+// the two lists together, nothing checked that a request carried the arguments
+// the handler expected, and a seventh request could be added to one list alone
+// and fail only at runtime. Here the interface is declared once, in this file,
+// and both halves are generated from it: the page's DocumentHostRemote and the
+// browser's DocumentHost base class are the same six methods with the same six
+// signatures, and a seventh added here appears on both sides or the build
+// fails. "A single, named, explicitly-declared interface" is now a file rather
+// than a convention.
+//
+// **Nothing here names a location.** Identifiers cross this boundary as opaque
+// strings -- the UUIDs components/sunshine/document/document_model.h already
+// carries -- and no method below takes or returns a path, a filename, or a
+// directory. DOC-6 keeps paths out of the model, and this interface is the
+// boundary at which they could otherwise be quietly reintroduced.
+//
+// **The untrusted frame is not a party to this.** DOC-2 says the frame
+// "receives content, never capability". The frame at
+// chrome-untrusted://sunshine-document-content is given no Mojo interface at
+// all: it is not registered in
+// chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h, its controller
+// declares no BindInterface, and the only thing that reaches it is one document
+// body by postMessage. A pipe to the frame would be the one thing this design
+// forbids.
+
+module sunshine.document.mojom;
+
+// One entry of the table of contents, in reading order.
+struct DocumentNode {
+  // Opaque. A node identifier, never a location (DOC-6).
+  string id;
+  string title;
+  // How deep in the hierarchy, for presentation only. Derived by the browser
+  // from the hierarchy rather than stored, so a move cannot leave it stale.
+  int32 depth;
+  bool has_document;
+};
+
+struct DocumentProject {
+  // Opaque. A project identifier, never a location (DOC-6).
+  string id;
+  string title;
+  // Depth-first traversal of the hierarchy: the reading order fixed by
+  // docs/DOCUMENT_SURFACE_CONTRACT.md section 3.
+  array<DocumentNode> nodes;
+};
+
+struct DocumentStructure {
+  array<DocumentProject> projects;
+};
+
+// What the surface may ask of its host, and the whole of it.
+//
+// Structure-returning requests answer with the whole structure rather than a
+// delta, so the page never has to keep a second copy of the model in agreement
+// with the first. No document body is ever part of a DocumentStructure: DOC-1
+// forbids project content in the privileged document, so the shell is told what
+// exists and never what it says. A body travels only through ReadDocument and
+// WriteDocument, and the shell's only use for one is to hand it to the frame.
+interface DocumentHost {
+  // Every project's structure. The store is read from disk on the first call.
+  Load() => (DocumentStructure structure);
+
+  CreateProject(string title) => (DocumentStructure structure);
+
+  // `parent_id` is the empty string for a node at the top level. An unknown or
+  // unparsable parent is a root node, which is what the page means when it asks
+  // for a top-level entry.
+  CreateNode(string project_id, string parent_id, string title)
+      => (DocumentStructure structure);
+
+  // DOC-7: the documents go with the project. Nothing above the data layer has
+  // to sweep for them, because the store keeps them inside it.
+  DeleteProject(string project_id) => (DocumentStructure structure);
+
+  // The stored bytes of the document `node_id` names, or the empty string.
+  // Returned byte for byte as they were stored; nothing here paginates them
+  // (DOC-4).
+  ReadDocument(string project_id, string node_id) => (string body);
+
+  WriteDocument(string project_id, string node_id, string body)
+      => (bool stored);
+};
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.cc b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.cc
new file mode 100644
index 0000000..4a5a4a7
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.cc
@@ -0,0 +1,62 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h"
+
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+SunshineDocumentContentUI::SunshineDocumentContentUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // A chrome-untrusted:// data source is named by its whole URL rather than by
+  // a bare host; content/public/browser/web_ui_data_source.h states the two
+  // forms and the origin each produces.
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(),
+      chrome::kChromeUISunshineDocumentContentURL);
+
+  webui::SetupWebUIDataSource(
+      source, sunshine::SurfaceResources("document_content"),
+      IDR_SUNSHINE_DOCUMENT_CONTENT_APP_HTML);
+
+  // Embeddable by the shell and by nothing else. Without this the default
+  // "frame-ancestors 'none';" would refuse the iframe outright;
+  // content::WebUIDataSourceImpl::AddFrameAncestor() CHECKs that the argument
+  // is a chrome:// or chrome-untrusted:// origin, so this cannot be widened to
+  // a website by mistake.
+  source->AddFrameAncestor(GURL(chrome::kChromeUISunshineDocumentURL));
+
+  // DOC-5, stated rather than inherited. "default-src 'self';" already blocks
+  // each of these, but a directive that is only implied is a directive the
+  // next edit can lose without anyone noticing.
+  //
+  // 'self' rather than 'none' for images and media: a document may reference
+  // its own origin, and a data: URL is inline content, not a fetch. Anything
+  // remote is refused, which is what DOCA-4 asks for -- the image shows as
+  // absent and no request leaves the browser.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc, "connect-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc, "img-src 'self' data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::MediaSrc, "media-src 'self' data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FontSrc, "font-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ObjectSrc, "object-src 'none';");
+  // The frame embeds nothing of its own, so a document carrying an iframe gets
+  // an empty box rather than a second renderer with a different policy.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ChildSrc, "child-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FormAction, "form-action 'none';");
+}
+
+SunshineDocumentContentUI::~SunshineDocumentContentUI() = default;
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h
new file mode 100644
index 0000000..5db43a7
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h
@@ -0,0 +1,82 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineDocumentContentUI;
+
+// The unprivileged half of the document surface, at
+// chrome-untrusted://sunshine-document-content.
+//
+// `chrome-untrusted` is **Chromium's** scheme, not one Sunshine registers, so
+// SEC-13 and docs/decisions/0003-internal-scheme.md are untouched; the scheme
+// is already in ALLOWED_SCHEMES in scripts/verify_first_party_surfaces.py for
+// that reason. content/public/browser/webui_config_map.h distinguishes the two
+// schemes explicitly -- AddWebUIConfig() CHECKs that its argument is a
+// chrome:// config and AddUntrustedWebUIConfig() CHECKs the opposite -- which
+// is what makes this a supported arrangement rather than a workaround, and
+// what lets both registrations sit in the seam's existing
+// RegisterWebUIConfigs() with no upstream file touched.
+//
+// content::DefaultWebUIConfig, not DefaultTopChromeWebUIConfig: the latter is
+// the helper for bubble-hosted surfaces, and this frame is hosted in an iframe
+// inside an ordinary tab.
+class SunshineDocumentContentUIConfig
+    : public content::DefaultWebUIConfig<SunshineDocumentContentUI> {
+ public:
+  SunshineDocumentContentUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIUntrustedScheme,
+                           chrome::kChromeUISunshineDocumentContentHost) {}
+};
+
+// Renders one document, and can reach nothing.
+//
+// It receives that document from chrome://sunshine-document by postMessage and
+// has no other way to obtain one: it holds no reference to the store, is given
+// no identifier it could ask about, and cannot name a project, a node, or a
+// document at all. That is DOC-2 -- "the frame receives content, never
+// capability" -- expressed as an absence rather than as a filter.
+//
+// **It is given no Mojo interface either, and the absence is mechanical.** The
+// privileged shell speaks to the browser through the interface declared in
+// sunshine_document.mojom; this class does not. It is a plain
+// content::WebUIController rather than a ui::MojoWebUIController, so it is
+// never granted the kMojoWebUi binding; it declares no BindInterface overload
+// and carries no WEB_UI_CONTROLLER_TYPE_DECL, so there is no type a binder
+// could be registered against; and it is absent from
+// sunshine::RegisterWebUIInterfaceBrokers() in
+// chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h, so
+// WebUIBrowserInterfaceBrokerRegistry::CreateInterfaceBroker() finds nothing
+// for it, returns nullptr, and content/browser/webui/web_ui_impl.cc never
+// reaches the EnableMojoJsBindingsWithBroker() call that would hand this
+// renderer a pipe. Four independent absences, any one of which would be enough.
+//
+// DOC-5 says the frame reaches no network. The policy below states it
+// directly, on top of the "default-src 'self';" that
+// content::URLDataSource::GetContentSecurityPolicy() already returns for every
+// chrome-untrusted:// data source: a document referencing a remote image shows
+// it as absent because the load is refused, not because anything here
+// rewrote the document.
+class SunshineDocumentContentUI : public content::WebUIController {
+ public:
+  explicit SunshineDocumentContentUI(content::WebUI* web_ui);
+
+  SunshineDocumentContentUI(const SunshineDocumentContentUI&) = delete;
+  SunshineDocumentContentUI& operator=(const SunshineDocumentContentUI&) =
+      delete;
+
+  ~SunshineDocumentContentUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc
new file mode 100644
index 0000000..4676cbe
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+#include "components/sunshine/document/document_model.h"
+
+// The generated interface's own namespace, spelled once. `sunshine::document`
+// (the data layer, components/sunshine/document/) and
+// `sunshine::document::mojom` (this surface's declared interface) are
+// deliberately neighbours: the second is how the first reaches the page, and
+// nothing else in Sunshine may reach it at all.
+namespace document_mojom = sunshine::document::mojom;
+
+namespace {
+
+// An identifier crosses the interface as an opaque string and becomes a
+// base::Uuid here. Nothing else is done with it: it is never joined to a path,
+// never used as a filename, and never interpreted as anything but a name the
+// store may or may not know (DOC-6). A string that is not a UUID parses to an
+// invalid one, which matches nothing, which is the behaviour the page already
+// relies on when it asks for a top-level node with an empty parent.
+base::Uuid ParseId(const std::string& text) {
+  return base::Uuid::ParseLowercase(text);
+}
+
+}  // namespace
+
+SunshineDocumentHandler::SunshineDocumentHandler(
+    const base::FilePath& profile_path)
+    : store_(std::make_unique<sunshine::document::ProjectStore>(profile_path)) {
+}
+
+SunshineDocumentHandler::~SunshineDocumentHandler() = default;
+
+void SunshineDocumentHandler::Bind(
+    mojo::PendingReceiver<sunshine::document::mojom::DocumentHost> receiver) {
+  receiver_.reset();
+  receiver_.Bind(std::move(receiver));
+}
+
+void SunshineDocumentHandler::Load(LoadCallback callback) {
+  if (store_->loaded()) {
+    OnStoreLoaded(std::move(callback));
+    return;
+  }
+  // base::Unretained is safe because the store is owned by this handler and
+  // cannot outlive it, so a callback the store still holds is a callback this
+  // handler is still alive to run.
+  store_->Load(base::BindOnce(&SunshineDocumentHandler::OnStoreLoaded,
+                              base::Unretained(this), std::move(callback)));
+}
+
+void SunshineDocumentHandler::OnStoreLoaded(LoadCallback callback) {
+  std::move(callback).Run(Structure());
+}
+
+void SunshineDocumentHandler::CreateProject(const std::string& title,
+                                            CreateProjectCallback callback) {
+  store_->CreateProject(title);
+  std::move(callback).Run(Structure());
+}
+
+void SunshineDocumentHandler::CreateNode(const std::string& project_id,
+                                         const std::string& parent_id,
+                                         const std::string& title,
+                                         CreateNodeCallback callback) {
+  // An absent or unparsable parent is a root node, which is what the page
+  // means when it asks for a top-level entry.
+  store_->CreateNode(ParseId(project_id), ParseId(parent_id), title);
+  std::move(callback).Run(Structure());
+}
+
+void SunshineDocumentHandler::DeleteProject(const std::string& project_id,
+                                            DeleteProjectCallback callback) {
+  store_->DeleteProject(ParseId(project_id));
+  std::move(callback).Run(Structure());
+}
+
+void SunshineDocumentHandler::ReadDocument(const std::string& project_id,
+                                           const std::string& node_id,
+                                           ReadDocumentCallback callback) {
+  const std::optional<std::string> body =
+      store_->GetDocumentBody(ParseId(project_id), ParseId(node_id));
+  // The body travels to the page so the page can hand it to the untrusted
+  // frame, which is the only place it is ever rendered (DOC-1). It is returned
+  // byte for byte as it was stored; nothing here paginates it (DOC-4).
+  std::move(callback).Run(body.value_or(std::string()));
+}
+
+void SunshineDocumentHandler::WriteDocument(const std::string& project_id,
+                                            const std::string& node_id,
+                                            const std::string& body,
+                                            WriteDocumentCallback callback) {
+  std::move(callback).Run(
+      store_->SetDocumentBody(ParseId(project_id), ParseId(node_id), body));
+}
+
+document_mojom::DocumentStructurePtr SunshineDocumentHandler::Structure()
+    const {
+  document_mojom::DocumentStructurePtr structure =
+      document_mojom::DocumentStructure::New();
+  for (const sunshine::document::Project& project : store_->projects()) {
+    // Depth is derived here rather than stored, because a stored depth is a
+    // second statement of the same fact that a move has to remember to update.
+    std::map<std::string, std::string> parents;
+    for (const sunshine::document::Node& node : project.nodes) {
+      parents[node.id.AsLowercaseString()] =
+          node.parent.is_valid() ? node.parent.AsLowercaseString()
+                                 : std::string();
+    }
+
+    document_mojom::DocumentProjectPtr stored =
+        document_mojom::DocumentProject::New();
+    stored->id = project.id.AsLowercaseString();
+    stored->title = project.title;
+
+    // Depth-first, siblings in order key order: the reading order the contract
+    // fixes in section 3, computed once in the data layer so the shell cannot
+    // invent a different one.
+    for (const sunshine::document::Node* node :
+         sunshine::document::ReadingOrder(project)) {
+      int depth = 0;
+      std::string walk = node->parent.is_valid()
+                             ? node->parent.AsLowercaseString()
+                             : std::string();
+      while (!walk.empty() && depth < static_cast<int>(project.nodes.size())) {
+        ++depth;
+        const auto found = parents.find(walk);
+        walk = found == parents.end() ? std::string() : found->second;
+      }
+
+      document_mojom::DocumentNodePtr entry =
+          document_mojom::DocumentNode::New();
+      entry->id = node->id.AsLowercaseString();
+      entry->title = node->title;
+      entry->depth = depth;
+      entry->has_document = node->document.is_valid();
+      stored->nodes.push_back(std::move(entry));
+    }
+
+    structure->projects.push_back(std::move(stored));
+  }
+
+  return structure;
+}
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h
new file mode 100644
index 0000000..6afec05
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h
@@ -0,0 +1,96 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom.h"
+#include "components/sunshine/document/project_store.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+// The browser half of the document shell's one host interface.
+//
+// docs/decisions/0013-module-data-portability.md section 2.5 requires that a
+// module's web assets talk to whatever hosts them "through a single, named,
+// explicitly-declared interface, and through nothing else". That interface is
+// chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom, and this
+// class is the browser's implementation of it. The page half is
+// chrome/browser/resources/sunshine/document/host.ts.
+//
+// **What Mojo changed, and why it tightened section 2.5 rather than relaxing
+// it.** This class used to be a content::WebUIMessageHandler that registered
+// six string message names, unpacked positional base::Value arguments by index,
+// and resolved a callback id. The interface therefore existed twice -- once
+// here and once in host.ts -- with nothing but a comment holding the two copies
+// in agreement, and nothing at all checking that a request carried the
+// arguments its handler expected. Both halves are now generated from the one
+// .mojom: the six methods below are overrides, so a name, an argument or a
+// return type that drifts from the declaration does not compile. There is no
+// longer anywhere to add a seventh request to one side alone.
+//
+// The requests carry identifiers and text. None of them names a file, a
+// directory, or anything else the page could turn into a location: DOC-6 keeps
+// paths out of the model, and this interface is where that would otherwise leak
+// back in. Identifiers arrive as opaque strings and are parsed into
+// base::Uuid here; an unparsable one is simply an identifier that matches
+// nothing.
+//
+// This class holds no project state of its own. The model lives in
+// components/sunshine/document/, per section 2.1, and this handler translates
+// between it and the page.
+class SunshineDocumentHandler
+    : public sunshine::document::mojom::DocumentHost {
+ public:
+  explicit SunshineDocumentHandler(const base::FilePath& profile_path);
+
+  SunshineDocumentHandler(const SunshineDocumentHandler&) = delete;
+  SunshineDocumentHandler& operator=(const SunshineDocumentHandler&) = delete;
+
+  ~SunshineDocumentHandler() override;
+
+  // Binds the page's end of the interface. The receiver is reset first so that
+  // a reused WebUI -- content/browser/webui/web_ui_impl.h says
+  // SetUpMojoInterfaceBroker() "may be called multiple times if the WebUI is
+  // reused" -- rebinds rather than CHECK-failing on an already-bound receiver.
+  void Bind(
+      mojo::PendingReceiver<sunshine::document::mojom::DocumentHost> receiver);
+
+  // sunshine::document::mojom::DocumentHost:
+  void Load(LoadCallback callback) override;
+  void CreateProject(const std::string& title,
+                     CreateProjectCallback callback) override;
+  void CreateNode(const std::string& project_id,
+                  const std::string& parent_id,
+                  const std::string& title,
+                  CreateNodeCallback callback) override;
+  void DeleteProject(const std::string& project_id,
+                     DeleteProjectCallback callback) override;
+  void ReadDocument(const std::string& project_id,
+                    const std::string& node_id,
+                    ReadDocumentCallback callback) override;
+  void WriteDocument(const std::string& project_id,
+                     const std::string& node_id,
+                     const std::string& body,
+                     WriteDocumentCallback callback) override;
+
+ private:
+  void OnStoreLoaded(LoadCallback callback);
+
+  // The structure of every project: identifiers, titles, and the reading
+  // order. No document body is ever part of this -- DOC-1 forbids project
+  // content in the privileged document, so the shell is told what exists and
+  // never what it says.
+  sunshine::document::mojom::DocumentStructurePtr Structure() const;
+
+  std::unique_ptr<sunshine::document::ProjectStore> store_;
+
+  mojo::Receiver<sunshine::document::mojom::DocumentHost> receiver_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.cc b/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.cc
new file mode 100644
index 0000000..29ca52d
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h"
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+
+SunshineDocumentUI::SunshineDocumentUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+
+  // The store lives under the profile directory and nowhere else (DOC-3). The
+  // path is composed once, here, from the profile's own directory; the handler
+  // and the data layer never receive one from the page, and no method of the
+  // page's interface can carry one.
+  handler_ = std::make_unique<SunshineDocumentHandler>(profile->GetPath());
+
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineDocumentHost);
+
+  // Every Sunshine surface is built into one resource bundle; this asks for the
+  // "document/" part of it. The untrusted frame's assets are under
+  // "document_content/", which this prefix does not match, so the privileged
+  // page cannot serve them and the two halves stay two halves.
+  // chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h.
+  //
+  // The generated Mojo bindings are part of that "document/" set:
+  // chrome/browser/resources/sunshine/BUILD.gn copies them into the bundle
+  // under the surface's own directory, so they are served from this page and
+  // from no other.
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("document"),
+                              IDR_SUNSHINE_DOCUMENT_APP_HTML);
+
+  // A WebUI data source forbids every frame by default -- URLDataSource's own
+  // GetContentSecurityPolicy() returns "child-src 'none';" -- so the one origin
+  // this page is allowed to embed has to be named. It is named exactly once and
+  // it is a chrome-untrusted:// origin, which is Chromium's scheme and not one
+  // Sunshine registers (SEC-13, ADR 0003).
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ChildSrc,
+      base::StrCat({"child-src ", chrome::kChromeUISunshineDocumentContentURL,
+                    ";"}));
+}
+
+SunshineDocumentUI::~SunshineDocumentUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SunshineDocumentUI)
+
+void SunshineDocumentUI::BindInterface(
+    mojo::PendingReceiver<sunshine::document::mojom::DocumentHost> receiver) {
+  handler_->Bind(std::move(receiver));
+}
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.h b/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.h
new file mode 100644
index 0000000..d57ccb2
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.h
@@ -0,0 +1,91 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
+
+#include <memory>
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "ui/webui/mojo_web_ui_controller.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineDocumentHandler;
+class SunshineDocumentUI;
+
+// The privileged half of the document surface, at chrome://sunshine-document.
+//
+// Registered through content's WebUI config map, like every Sunshine surface;
+// docs/decisions/0003-internal-scheme.md records why Sunshine registers no
+// scheme of its own.
+class SunshineDocumentUIConfig
+    : public content::DefaultWebUIConfig<SunshineDocumentUI> {
+ public:
+  SunshineDocumentUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineDocumentHost) {}
+};
+
+// Lists projects, shows the hierarchy as a table of contents in reading order,
+// and lets a person create a project, add a node, and author or paste the HTML
+// of a node's document.
+//
+// It renders none of that HTML. docs/DOCUMENT_SURFACE_CONTRACT.md section 1 is
+// the one structural decision the rest of the surface follows from: project
+// content is authored by a person, a WebUI page runs at a privilege no website
+// has, and rendering the first inside the second is the failure
+// docs/SECURITY_ARCHITECTURE_CONTRACT.md exists to prevent. The content goes to
+// chrome-untrusted://sunshine-document-content, in an iframe, by postMessage.
+//
+// The content security policy set in the constructor is the browser-side half
+// of that arrangement: this page may embed exactly one origin, and it is
+// Chromium's own untrusted scheme rather than anything Sunshine registered.
+//
+// **ui::MojoWebUIController, and what it takes away.** The base class exists to
+// grant one binding and, by default, to withhold another:
+// ui/webui/mojo_web_ui_controller.cc puts kMojoWebUi into this page's
+// content::BindingsPolicySet and adds kWebUi only when `enable_chrome_send` is
+// passed. It is not passed here. The page therefore has Mojo and does not have
+// chrome.send at all -- the mechanism this surface used to be written against
+// is not merely unused, it is absent -- which is the browser-side counterpart
+// of the eslint rule that refuses `chrome.send` and `//resources/js/cr.js` in
+// any new WebUI's TypeScript.
+//
+// The single interface the page may ask for is declared in
+// sunshine_document.mojom and bound below. The binder is registered in
+// chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h, beside the config
+// registrations, so a surface that speaks Mojo still costs no upstream file.
+class SunshineDocumentUI : public ui::MojoWebUIController {
+ public:
+  explicit SunshineDocumentUI(content::WebUI* web_ui);
+
+  SunshineDocumentUI(const SunshineDocumentUI&) = delete;
+  SunshineDocumentUI& operator=(const SunshineDocumentUI&) = delete;
+
+  ~SunshineDocumentUI() override;
+
+  // The one interface this page is offered. Everything the shell may ask of
+  // the browser arrives through it, per
+  // docs/decisions/0013-module-data-portability.md section 2.5.
+  void BindInterface(
+      mojo::PendingReceiver<sunshine::document::mojom::DocumentHost> receiver);
+
+ private:
+  std::unique_ptr<SunshineDocumentHandler> handler_;
+
+  // Gives this controller the identity that
+  // content::WebUIBrowserInterfaceBrokerRegistry registers a binder against,
+  // and that content::WebUIController::GetAs() downcasts by. Without it the
+  // registration in sunshine_webui_registry.h has nothing to name.
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
diff --git a/chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h b/chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h
index adaf8ce..b04bb4d 100644
--- a/chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h
+++ b/chrome/browser/ui/webui/sunshine/sunshine_webui_registry.h
@@ -13,13 +13,91 @@
 
 #include <memory>
 
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom.h"
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h"
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_ui.h"
 #include "chrome/browser/ui/webui/sunshine/security/sunshine_security_ui.h"
+#include "content/public/browser/web_ui_browser_interface_broker_registry.h"
 #include "content/public/browser/webui_config_map.h"
 
 namespace sunshine {
 
+// The second half of the seam: which Mojo interface each Sunshine surface may
+// ask the browser for.
+//
+// **Why this is here and not where Chromium's own surfaces do it.** Chrome
+// registers its WebUI interface brokers from
+// chrome/browser/chrome_browser_interface_binders_webui.cc, through
+// ChromeContentBrowserClient::RegisterTrustedWebUIInterfaceBrokers(). That is
+// an upstream file this patch stack does not touch, and touching it would make
+// a thirteenth -- the exact cost that
+// docs/decisions/0007-module-contribution-seam.md built this seam to avoid, and
+// the same cost the seam already avoided for config registration.
+//
+// **Why registering from here works, read from the pinned sources rather than
+// assumed.** content/browser/web_ui_browser_interface_broker_registry.cc holds
+// the trusted registry in a `base::NoDestructor` behind the public static
+// WebUIBrowserInterfaceBrokerRegistry::GetTrustedRegistry(), and its own header
+// documents the call shape used below:
+//
+//     registry.ForWebUI<ControllerType>
+//        .Add<Interface1>()
+//        .Add<Interface2>();
+//
+// The registry is read, not copied, at the moment a broker is needed:
+// CreateInterfaceBroker() looks its controller type up in
+// `binder_initializers_` each time it is called, and
+// content/browser/webui/web_ui_impl.cc calls it from
+// WebUIImpl::SetUpMojoInterfaceBroker(), once per WebUI navigation. Everything
+// below therefore has to happen before the first navigation to a Sunshine
+// surface, and it does: RegisterWebUIConfigs() is called from
+// RegisterChromeWebUIConfigs(), which chrome/browser/chrome_browser_main.cc
+// calls inside PreMainMessageLoopRunImpl(), immediately after PreProfileInit()
+// and before the first profile exists -- long before any tab has navigated
+// anywhere.
+//
+// The one visible difference from upstream's arrangement is that touching the
+// registry here forces its lazy construction slightly earlier than the first
+// WebUI navigation would. That construction runs chrome's own
+// RegisterTrustedWebUIInterfaceBrokers(), which reads feature state; the
+// feature list is initialised during early startup, well before
+// PreMainMessageLoopRunImpl(), so it reads the same values either way.
+inline void RegisterWebUIInterfaceBrokers() {
+  // The document shell's single named host interface, and the whole of what the
+  // page may ask for -- docs/decisions/0013-module-data-portability.md section
+  // 2.5. It is declared once, in
+  // chrome/browser/ui/webui/sunshine/document/sunshine_document.mojom.
+  //
+  // Note which controller is named, and which is not. SunshineDocumentUI is
+  // the privileged shell at chrome://sunshine-document.
+  // SunshineDocumentContentUI -- the untrusted frame that renders project HTML
+  // -- is deliberately absent from this function, declares no BindInterface,
+  // and carries no
+  // WEB_UI_CONTROLLER_TYPE_DECL, so
+  // WebUIBrowserInterfaceBrokerRegistry::CreateInterfaceBroker() finds nothing
+  // for it and returns nullptr, and no broker is ever handed to that renderer.
+  // The frame receives a document body by postMessage and nothing else. That is
+  // DOC-2 -- "the frame receives content, never capability" -- expressed as an
+  // absence rather than as a filter, and giving that frame a pipe is the one
+  // thing this design forbids.
+  content::WebUIBrowserInterfaceBrokerRegistry::GetTrustedRegistry()
+      .ForWebUI<SunshineDocumentUI>()
+      .Add<::sunshine::document::mojom::DocumentHost>();
+}
+
 inline void RegisterWebUIConfigs(content::WebUIConfigMap& map) {
+  map.AddWebUIConfig(std::make_unique<SunshineDocumentUIConfig>());
   map.AddWebUIConfig(std::make_unique<SunshineSecurityUIConfig>());
+
+  // The document surface's unprivileged half. It is the same singleton and the
+  // same function: content/public/browser/webui_config_map.h declares
+  // AddUntrustedWebUIConfig() beside AddWebUIConfig() and each CHECKs the
+  // scheme of its argument, so a chrome-untrusted:// surface costs no fifth
+  // upstream file and no second registration point.
+  map.AddUntrustedWebUIConfig(
+      std::make_unique<SunshineDocumentContentUIConfig>());
+
+  RegisterWebUIInterfaceBrokers();
 }
 
 }  // namespace sunshine
diff --git a/chrome/common/sunshine/sunshine_webui_hosts.h b/chrome/common/sunshine/sunshine_webui_hosts.h
