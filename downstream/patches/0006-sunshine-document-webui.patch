+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h"
+
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+SunshineDocumentContentUI::SunshineDocumentContentUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // A chrome-untrusted:// data source is named by its whole URL rather than by
+  // a bare host; content/public/browser/web_ui_data_source.h states the two
+  // forms and the origin each produces.
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(),
+      chrome::kChromeUISunshineDocumentContentURL);
+
+  webui::SetupWebUIDataSource(
+      source, sunshine::SurfaceResources("document_content"),
+      IDR_SUNSHINE_DOCUMENT_CONTENT_APP_HTML);
+
+  // Embeddable by the shell and by nothing else. Without this the default
+  // "frame-ancestors 'none';" would refuse the iframe outright;
+  // content::WebUIDataSourceImpl::AddFrameAncestor() CHECKs that the argument
+  // is a chrome:// or chrome-untrusted:// origin, so this cannot be widened to
+  // a website by mistake.
+  source->AddFrameAncestor(GURL(chrome::kChromeUISunshineDocumentURL));
+
+  // DOC-5, stated rather than inherited. "default-src 'self';" already blocks
+  // each of these, but a directive that is only implied is a directive the
+  // next edit can lose without anyone noticing.
+  //
+  // 'self' rather than 'none' for images and media: a document may reference
+  // its own origin, and a data: URL is inline content, not a fetch. Anything
+  // remote is refused, which is what DOCA-4 asks for -- the image shows as
+  // absent and no request leaves the browser.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc, "connect-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc, "img-src 'self' data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::MediaSrc, "media-src 'self' data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FontSrc, "font-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ObjectSrc, "object-src 'none';");
+  // The frame embeds nothing of its own, so a document carrying an iframe gets
+  // an empty box rather than a second renderer with a different policy.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ChildSrc, "child-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FormAction, "form-action 'none';");
+}
+
+SunshineDocumentContentUI::~SunshineDocumentContentUI() = default;
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h
new file mode 100644
index 0000000..b91abfc
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineDocumentContentUI;
+
+// The unprivileged half of the document surface, at
+// chrome-untrusted://sunshine-document-content.
+//
+// `chrome-untrusted` is **Chromium's** scheme, not one Sunshine registers, so
+// SEC-13 and docs/decisions/0003-internal-scheme.md are untouched; the scheme
+// is already in ALLOWED_SCHEMES in scripts/verify_first_party_surfaces.py for
+// that reason. content/public/browser/webui_config_map.h distinguishes the two
+// schemes explicitly -- AddWebUIConfig() CHECKs that its argument is a
+// chrome:// config and AddUntrustedWebUIConfig() CHECKs the opposite -- which
+// is what makes this a supported arrangement rather than a workaround, and
+// what lets both registrations sit in the seam's existing
+// RegisterWebUIConfigs() with no upstream file touched.
+//
+// content::DefaultWebUIConfig, not DefaultTopChromeWebUIConfig: the latter is
+// the helper for bubble-hosted surfaces, and this frame is hosted in an iframe
+// inside an ordinary tab.
+class SunshineDocumentContentUIConfig
+    : public content::DefaultWebUIConfig<SunshineDocumentContentUI> {
+ public:
+  SunshineDocumentContentUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIUntrustedScheme,
+                           chrome::kChromeUISunshineDocumentContentHost) {}
+};
+
+// Renders one document, and can reach nothing.
+//
+// It receives that document from chrome://sunshine-document by postMessage and
+// has no other way to obtain one: it holds no reference to the store, is given
+// no identifier it could ask about, and cannot name a project, a node, or a
+// document at all. That is DOC-2 -- "the frame receives content, never
+// capability" -- expressed as an absence rather than as a filter.
+//
+// DOC-5 says the frame reaches no network. The policy below states it
+// directly, on top of the "default-src 'self';" that
+// content::URLDataSource::GetContentSecurityPolicy() already returns for every
+// chrome-untrusted:// data source: a document referencing a remote image shows
+// it as absent because the load is refused, not because anything here
+// rewrote the document.
+class SunshineDocumentContentUI : public content::WebUIController {
+ public:
+  explicit SunshineDocumentContentUI(content::WebUI* web_ui);
+
+  SunshineDocumentContentUI(const SunshineDocumentContentUI&) = delete;
+  SunshineDocumentContentUI& operator=(const SunshineDocumentContentUI&) =
+      delete;
+
+  ~SunshineDocumentContentUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_CONTENT_UI_H_
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc
new file mode 100644
index 0000000..38cb8bb
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.cc
@@ -0,0 +1,197 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+#include "components/sunshine/document/document_model.h"
+
+namespace {
+
+// The six requests the page may make. They are named here and in
+// chrome/browser/resources/sunshine/document/host.ts, and nowhere else.
+constexpr char kLoad[] = "sunshine.document.load";
+constexpr char kCreateProject[] = "sunshine.document.createProject";
+constexpr char kCreateNode[] = "sunshine.document.createNode";
+constexpr char kDeleteProject[] = "sunshine.document.deleteProject";
+constexpr char kReadDocument[] = "sunshine.document.readDocument";
+constexpr char kWriteDocument[] = "sunshine.document.writeDocument";
+
+const std::string* StringAt(const base::ListValue& args, size_t index) {
+  if (index >= args.size()) {
+    return nullptr;
+  }
+  return args[index].GetIfString();
+}
+
+base::Uuid UuidAt(const base::ListValue& args, size_t index) {
+  const std::string* text = StringAt(args, index);
+  return text ? base::Uuid::ParseLowercase(*text) : base::Uuid();
+}
+
+}  // namespace
+
+SunshineDocumentHandler::SunshineDocumentHandler(
+    const base::FilePath& profile_path)
+    : store_(std::make_unique<sunshine::document::ProjectStore>(profile_path)) {
+}
+
+SunshineDocumentHandler::~SunshineDocumentHandler() = default;
+
+void SunshineDocumentHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      kLoad, base::BindRepeating(&SunshineDocumentHandler::HandleLoad,
+                                 base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      kCreateProject,
+      base::BindRepeating(&SunshineDocumentHandler::HandleCreateProject,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      kCreateNode,
+      base::BindRepeating(&SunshineDocumentHandler::HandleCreateNode,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      kDeleteProject,
+      base::BindRepeating(&SunshineDocumentHandler::HandleDeleteProject,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      kReadDocument,
+      base::BindRepeating(&SunshineDocumentHandler::HandleReadDocument,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      kWriteDocument,
+      base::BindRepeating(&SunshineDocumentHandler::HandleWriteDocument,
+                          base::Unretained(this)));
+}
+
+void SunshineDocumentHandler::HandleLoad(const base::ListValue& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+  base::Value callback_id = args[0].Clone();
+  if (store_->loaded()) {
+    OnStoreLoaded(std::move(callback_id));
+    return;
+  }
+  store_->Load(base::BindOnce(&SunshineDocumentHandler::OnStoreLoaded,
+                              base::Unretained(this), std::move(callback_id)));
+}
+
+void SunshineDocumentHandler::OnStoreLoaded(base::Value callback_id) {
+  ResolveJavascriptCallback(callback_id, Structure());
+}
+
+void SunshineDocumentHandler::HandleCreateProject(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string* title = StringAt(args, 1);
+  if (args.empty() || !title) {
+    return;
+  }
+  store_->CreateProject(*title);
+  ResolveJavascriptCallback(args[0], Structure());
+}
+
+void SunshineDocumentHandler::HandleCreateNode(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string* title = StringAt(args, 3);
+  if (args.empty() || !title) {
+    return;
+  }
+  // An absent or unparsable parent is a root node, which is what the page
+  // means when it asks for a top-level entry.
+  store_->CreateNode(UuidAt(args, 1), UuidAt(args, 2), *title);
+  ResolveJavascriptCallback(args[0], Structure());
+}
+
+void SunshineDocumentHandler::HandleDeleteProject(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+  store_->DeleteProject(UuidAt(args, 1));
+  ResolveJavascriptCallback(args[0], Structure());
+}
+
+void SunshineDocumentHandler::HandleReadDocument(const base::ListValue& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+  const std::optional<std::string> body =
+      store_->GetDocumentBody(UuidAt(args, 1), UuidAt(args, 2));
+  // The body travels to the page so the page can hand it to the untrusted
+  // frame, which is the only place it is ever rendered (DOC-1). It is returned
+  // byte for byte as it was stored; nothing here paginates it (DOC-4).
+  ResolveJavascriptCallback(args[0], base::Value(body.value_or(std::string())));
+}
+
+void SunshineDocumentHandler::HandleWriteDocument(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string* body = StringAt(args, 3);
+  if (args.empty() || !body) {
+    return;
+  }
+  const bool stored =
+      store_->SetDocumentBody(UuidAt(args, 1), UuidAt(args, 2), *body);
+  ResolveJavascriptCallback(args[0], base::Value(stored));
+}
+
+base::DictValue SunshineDocumentHandler::Structure() const {
+  base::ListValue projects;
+  for (const sunshine::document::Project& project : store_->projects()) {
+    // Depth is derived here rather than stored, because a stored depth is a
+    // second statement of the same fact that a move has to remember to update.
+    std::map<std::string, std::string> parents;
+    for (const sunshine::document::Node& node : project.nodes) {
+      parents[node.id.AsLowercaseString()] =
+          node.parent.is_valid() ? node.parent.AsLowercaseString()
+                                 : std::string();
+    }
+
+    base::ListValue nodes;
+    // Depth-first, siblings in order key order: the reading order the contract
+    // fixes in section 3, computed once in the data layer so the shell cannot
+    // invent a different one.
+    for (const sunshine::document::Node* node :
+         sunshine::document::ReadingOrder(project)) {
+      int depth = 0;
+      std::string walk = node->parent.is_valid()
+                             ? node->parent.AsLowercaseString()
+                             : std::string();
+      while (!walk.empty() && depth < static_cast<int>(project.nodes.size())) {
+        ++depth;
+        const auto found = parents.find(walk);
+        walk = found == parents.end() ? std::string() : found->second;
+      }
+
+      base::DictValue entry;
+      entry.Set("id", node->id.AsLowercaseString());
+      entry.Set("title", node->title);
+      entry.Set("depth", depth);
+      entry.Set("hasDocument", node->document.is_valid());
+      nodes.Append(std::move(entry));
+    }
+
+    base::DictValue stored;
+    stored.Set("id", project.id.AsLowercaseString());
+    stored.Set("title", project.title);
+    stored.Set("nodes", std::move(nodes));
+    projects.Append(std::move(stored));
+  }
+
+  base::DictValue structure;
+  structure.Set("projects", std::move(projects));
+  return structure;
+}
diff --git a/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h b/chrome/browser/ui/webui/sunshine/document/sunshine_document_handler.h
