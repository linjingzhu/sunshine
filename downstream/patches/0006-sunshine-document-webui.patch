+#ifndef COMPONENTS_SUNSHINE_DOCUMENT_PROJECT_STORE_H_
+#define COMPONENTS_SUNSHINE_DOCUMENT_PROJECT_STORE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/uuid.h"
+#include "components/sunshine/document/document_model.h"
+
+namespace sunshine::document {
+
+// Every project in one profile, and the only thing that knows where they are
+// kept.
+//
+// **Where.** DOC-3: "A project is profile-scoped data Sunshine owns. No path
+// outside the profile directory is read or written." The constructor takes the
+// profile directory and derives one file inside it; nothing else in Sunshine
+// composes a path, and no caller passes one in.
+//
+// **How.** base::ImportantFileWriter, whose header
+// (base/files/important_file_writer.h) states what it buys: writing "to ensure
+// that it won't be corrupted by *application* crash during write (implemented
+// as create, flush, rename)". The same header is equally clear about what it
+// does not buy -- it "can be *really* slow" and is "not a valid substitute for
+// file integrity checks and recovery codepaths for malformed files" -- so the
+// reader here treats an unreadable or malformed file as an empty store rather
+// than as a reason to fail, and every project that survives parsing is kept.
+// One JSON file holds the hierarchy and the document bodies together, which is
+// what makes DOC-7 ("deleting a project deletes its documents") a property of
+// the format rather than a cleanup pass that can be forgotten.
+//
+// **Not the network.** Section 2.4 of
+// docs/decisions/0013-module-data-portability.md: this layer has no network
+// code, no client, no endpoint, and no knowledge that a second device could
+// exist. A later, separately reviewed component may read it.
+//
+// **Threading.** Reads and writes happen on a blocking sequence; the model
+// itself lives on the sequence that constructed the store, and every method
+// below is called there.
+class ProjectStore {
+ public:
+  // `profile_path` is the profile directory. The store keeps one file inside
+  // it and never looks above it.
+  explicit ProjectStore(const base::FilePath& profile_path);
+
+  ProjectStore(const ProjectStore&) = delete;
+  ProjectStore& operator=(const ProjectStore&) = delete;
+
+  ~ProjectStore();
+
+  // Reads the store from disk and runs `loaded` when the model is ready. A
+  // missing or unreadable file is an empty store, not an error: a profile that
+  // has never opened this surface has no file, and that is the ordinary case
+  // rather than a failure to report.
+  void Load(base::OnceClosure loaded);
+
+  bool loaded() const;
+
+  const std::vector<Project>& projects() const;
+
+  // The project with `id`, or null.
+  const Project* FindProject(const base::Uuid& id) const;
+
+  // Creates a project and returns its identifier.
+  base::Uuid CreateProject(const std::string& title);
+
+  // Creates a node under `parent` -- invalid for a root -- as the last of its
+  // siblings, and returns its identifier. Returns an invalid Uuid if the
+  // project or the parent is unknown.
+  base::Uuid CreateNode(const base::Uuid& project,
+                        const base::Uuid& parent,
+                        const std::string& title);
+
+  // Replaces the body of the document `node` names, creating the document if
+  // the node had none. The bytes are stored as given; see DOC-4.
+  bool SetDocumentBody(const base::Uuid& project,
+                       const base::Uuid& node,
+                       const std::string& body);
+
+  // The body of the document `node` names, or nullopt when it names none.
+  std::optional<std::string> GetDocumentBody(const base::Uuid& project,
+                                             const base::Uuid& node) const;
+
+  // Deletes a project and, with it, every document it owned (DOC-7).
+  bool DeleteProject(const base::Uuid& project);
+
+ private:
+  void OnRead(base::OnceClosure loaded, std::optional<std::string> contents);
+  void Save();
+  Project* FindProjectMutable(const base::Uuid& id);
+
+  const base::FilePath path_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  std::vector<Project> projects_;
+  bool loaded_ = false;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<ProjectStore> weak_factory_{this};
+};
+
+}  // namespace sunshine::document
+
+#endif  // COMPONENTS_SUNSHINE_DOCUMENT_PROJECT_STORE_H_
