@@ -0,0 +1,64 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+#include "components/sunshine/document/project_store.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+// The browser half of the document shell's one host interface.
+//
+// docs/decisions/0013-module-data-portability.md section 2.5 requires that a
+// module's web assets talk to whatever hosts them "through a single, named,
+// explicitly-declared interface, and through nothing else". The page half of
+// that interface is chrome/browser/resources/sunshine/document/host.ts, whose
+// header comment lists the same six requests declared here and states the same
+// contract. Everything the page can ask the browser is in these two files; a
+// seventh request is added to both or to neither.
+//
+// The requests carry identifiers and text. None of them names a file, a
+// directory, or anything else the page could turn into a location: DOC-6 keeps
+// paths out of the model, and this interface is where that would otherwise
+// leak back in.
+//
+// This class holds no project state of its own. The model lives in
+// components/sunshine/document/, per section 2.1, and this handler translates
+// between it and the page.
+class SunshineDocumentHandler : public content::WebUIMessageHandler {
+ public:
+  explicit SunshineDocumentHandler(const base::FilePath& profile_path);
+
+  SunshineDocumentHandler(const SunshineDocumentHandler&) = delete;
+  SunshineDocumentHandler& operator=(const SunshineDocumentHandler&) = delete;
+
+  ~SunshineDocumentHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  void HandleLoad(const base::ListValue& args);
+  void HandleCreateProject(const base::ListValue& args);
+  void HandleCreateNode(const base::ListValue& args);
+  void HandleDeleteProject(const base::ListValue& args);
+  void HandleReadDocument(const base::ListValue& args);
+  void HandleWriteDocument(const base::ListValue& args);
+
+  void OnStoreLoaded(base::Value callback_id);
+
+  // The structure of every project: identifiers, titles, and the reading
+  // order. No document body is ever part of this -- DOC-1 forbids project
+  // content in the privileged document, so the shell is told what exists and
+  // never what it says.
+  base::DictValue Structure() const;
+
+  std::unique_ptr<sunshine::document::ProjectStore> store_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_HANDLER_H_
