+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+
+SunshineDocumentUI::SunshineDocumentUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+
+  // The store lives under the profile directory and nowhere else (DOC-3). The
+  // path is composed once, here, from the profile's own directory; the handler
+  // and the data layer never receive one from the page.
+  web_ui->AddMessageHandler(
+      std::make_unique<SunshineDocumentHandler>(profile->GetPath()));
+
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineDocumentHost);
+
+  // Every Sunshine surface is built into one resource bundle; this asks for the
+  // "document/" part of it. The untrusted frame's assets are under
+  // "document_content/", which this prefix does not match, so the privileged
+  // page cannot serve them and the two halves stay two halves.
+  // chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h.
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("document"),
+                              IDR_SUNSHINE_DOCUMENT_APP_HTML);
+
+  // A WebUI data source forbids every frame by default -- URLDataSource's own
+  // GetContentSecurityPolicy() returns "child-src 'none';" -- so the one origin
+  // this page is allowed to embed has to be named. It is named exactly once and
+  // it is a chrome-untrusted:// origin, which is Chromium's scheme and not one
+  // Sunshine registers (SEC-13, ADR 0003).
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ChildSrc,
+      base::StrCat({"child-src ", chrome::kChromeUISunshineDocumentContentURL,
+                    ";"}));
+}
+
+SunshineDocumentUI::~SunshineDocumentUI() = default;
