+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sunshine/document/order_key.h"
+
+#include <stddef.h>
+
+namespace sunshine::document {
+
+namespace {
+
+// ASCII order, so lexicographic comparison of two keys is comparison of the
+// digit sequences they denote.
+constexpr std::string_view kDigits =
+    "0123456789"
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+    "abcdefghijklmnopqrstuvwxyz";
+
+// The position of `digit` in kDigits, or kDigits.size() if it is not a digit.
+// `find` rather than arithmetic on a pointer: Chromium compiles this tree with
+// -Wunsafe-buffer-usage promoted to an error, and pointer arithmetic on a
+// character buffer is exactly what that rejects.
+size_t IndexOf(char digit) {
+  const size_t position = kDigits.find(digit);
+  return position == std::string_view::npos ? kDigits.size() : position;
+}
+
+}  // namespace
+
+std::string OrderKeyBetween(std::string_view before, std::string_view after) {
+  std::string key;
+  for (size_t index = 0;; ++index) {
+    // `before` runs out into the lowest digit; `after` runs out into one past
+    // the highest, which is why an empty `after` yields a key above every
+    // existing one rather than a key equal to the last.
+    const size_t lower = index < before.size() ? IndexOf(before[index]) : 0;
+    const size_t upper =
+        index < after.size() ? IndexOf(after[index]) : kDigits.size();
+
+    // `lower + 1` rather than `upper - lower`: on a malformed stored key the
+    // subtraction can wrap, and a wrapped size_t compares greater than 1.
+    if (upper > lower + 1) {
+      // The midpoint is at least lower + 1, so the last character is never the
+      // lowest digit. That is the invariant the header describes.
+      key.push_back(kDigits[lower + (upper - lower) / 2]);
+      return key;
+    }
+
+    // Nothing fits between the two digits at this position, so copy this
+    // position and decide at the next one. The loop always terminates: once
+    // `index` passes both inputs, lower is 0 and upper is kDigits.size().
+    key.push_back(index < before.size() ? before[index] : kDigits.front());
+  }
+}
+
+bool IsWellFormedOrderKey(std::string_view key) {
+  if (key.empty()) {
+    return false;
+  }
+  for (const char digit : key) {
+    if (IndexOf(digit) == kDigits.size()) {
+      return false;
+    }
+  }
+  return key.back() != kDigits.front();
+}
+
+}  // namespace sunshine::document
diff --git a/components/sunshine/document/order_key.h b/components/sunshine/document/order_key.h
new file mode 100644
index 0000000..f83ffc7
--- /dev/null
+++ b/components/sunshine/document/order_key.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
+#define COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
+
+#include <string>
+#include <string_view>
+
+namespace sunshine::document {
+
+// An explicit order key for one node among its siblings.
+//
+// docs/decisions/0013-module-data-portability.md section 2.3 rules out
+// "ordering that depends on insertion sequence alone": a dense 0, 1, 2 index
+// has to renumber every later sibling on each insert, which turns one user
+// action into an edit of every neighbour and a merge into a conflict on nodes
+// nobody touched. A key that can be assigned *between* two existing
+// neighbours without disturbing either is the alternative, and the ADR is
+// explicit that it is "a choice about the field's type, made once".
+//
+// The type is a string ordered lexicographically over the 62 characters
+// '0'-'9', 'A'-'Z', 'a'-'z', in that order -- which is plain ASCII order, so
+// std::string's own comparison is the ordering and no comparator has to
+// travel with the data.
+//
+// One invariant makes the type dense: a key returned here never ends in the
+// lowest digit '0'. Without it there is no key between "V" and "V0", because
+// anything between must begin "V" and continue with a digit below '0'. With
+// it, a key strictly between any two keys this function produced always
+// exists. `ProjectStore` re-keys any stored value that violates the invariant
+// when it loads, so a hand-edited file cannot get the tree stuck.
+//
+// `before` empty means "before every sibling"; `after` empty means "after
+// every sibling". Both empty asks for the first key in an empty list.
+std::string OrderKeyBetween(std::string_view before, std::string_view after);
+
+// Whether `key` is one this file could have produced: non-empty, drawn from
+// the 62 digits, and not ending in the lowest one.
+bool IsWellFormedOrderKey(std::string_view key);
+
+}  // namespace sunshine::document
+
+#endif  // COMPONENTS_SUNSHINE_DOCUMENT_ORDER_KEY_H_
diff --git a/components/sunshine/document/project_store.cc b/components/sunshine/document/project_store.cc
new file mode 100644
index 0000000..f134a28
--- /dev/null
+++ b/components/sunshine/document/project_store.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sunshine/document/project_store.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "components/sunshine/document/order_key.h"
+
+namespace sunshine::document {
+
+namespace {
+
+// One file, inside the profile directory, named for what it holds and not for
+// any project in it. DOC-3 is the reason there is exactly one place this
+// string appears.
+constexpr base::FilePath::CharType kStoreFileName[] =
+    FILE_PATH_LITERAL("Sunshine Document Projects");
+
+constexpr char kProjects[] = "projects";
+
+// A malformed file must not be able to make the browser read an arbitrary
+// amount into memory. The contract makes no claim about a document larger than
+// memory (docs/DOCUMENT_SURFACE_CONTRACT.md section 6) and this bound is not
+// that claim -- it is the refusal to try.
+constexpr size_t kMaximumStoreBytes = 64u * 1024u * 1024u;
+
+std::optional<std::string> ReadStoreFile(const base::FilePath& path) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents,
+                                         kMaximumStoreBytes)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+}  // namespace
+
+ProjectStore::ProjectStore(const base::FilePath& profile_path)
+    : path_(profile_path.Append(kStoreFileName).AddExtensionASCII("json")) {
+  writer_ = std::make_unique<base::ImportantFileWriter>(
+      path_, base::ThreadPool::CreateSequencedTaskRunner(
+                 {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+                  base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+}
+
+ProjectStore::~ProjectStore() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void ProjectStore::Load(base::OnceClosure loaded) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadStoreFile, path_),
+      base::BindOnce(&ProjectStore::OnRead, weak_factory_.GetWeakPtr(),
+                     std::move(loaded)));
+}
+
+void ProjectStore::OnRead(base::OnceClosure loaded,
+                          std::optional<std::string> contents) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  loaded_ = true;
+  if (contents.has_value()) {
+    std::optional<base::DictValue> stored =
+        base::JSONReader::ReadDict(*contents, base::JSON_PARSE_RFC);
+    if (stored.has_value()) {
+      if (const base::ListValue* projects = stored->FindList(kProjects)) {
+        for (const base::Value& entry : *projects) {
+          const base::DictValue* value = entry.GetIfDict();
+          if (!value) {
+            continue;
+          }
+          std::optional<Project> project = FromValue(*value);
+          if (project.has_value()) {
+            projects_.push_back(std::move(*project));
+          }
+        }
+      }
+    }
+  }
+  std::move(loaded).Run();
+}
+
+bool ProjectStore::loaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return loaded_;
+}
+
+const std::vector<Project>& ProjectStore::projects() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return projects_;
+}
+
+const Project* ProjectStore::FindProject(const base::Uuid& id) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (const Project& project : projects_) {
+    if (project.id == id) {
+      return &project;
+    }
+  }
+  return nullptr;
+}
+
+Project* ProjectStore::FindProjectMutable(const base::Uuid& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (Project& project : projects_) {
+    if (project.id == id) {
+      return &project;
+    }
+  }
+  return nullptr;
+}
+
+base::Uuid ProjectStore::CreateProject(const std::string& title) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Project project;
+  // Random, not sequential. Section 2.3 of ADR 0013 rules out an
+  // auto-increment counter as identity precisely because a per-device sequence
+  // produces the same value on two devices for different objects.
+  project.id = base::Uuid::GenerateRandomV4();
+  project.title = title;
+  project.title_modified = base::Time::Now();
+  const base::Uuid id = project.id;
+  projects_.push_back(std::move(project));
+  Save();
+  return id;
+}
+
+base::Uuid ProjectStore::CreateNode(const base::Uuid& project_id,
+                                    const base::Uuid& parent,
+                                    const std::string& title) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Project* project = FindProjectMutable(project_id);
+  if (!project) {
+    return base::Uuid();
+  }
+  if (parent.is_valid() && !FindNode(*project, parent)) {
+    return base::Uuid();
+  }
+
+  // The new node goes after the last of its siblings, which means one key is
+  // assigned and no neighbour is touched. That is the whole point of the
+  // explicit key: an insert is an edit of one node, so a later merge has no
+  // conflict on nodes nobody moved.
+  std::string last;
+  for (const Node& sibling : project->nodes) {
+    if (sibling.parent == parent && sibling.order_key > last) {
+      last = sibling.order_key;
+    }
+  }
+
+  Node node;
+  node.id = base::Uuid::GenerateRandomV4();
+  node.parent = parent;
+  node.title = title;
+  node.order_key = OrderKeyBetween(last, std::string_view());
+  node.title_modified = base::Time::Now();
+  node.order_modified = node.title_modified;
+  const base::Uuid id = node.id;
+  project->nodes.push_back(std::move(node));
+  Save();
+  return id;
+}
+
+bool ProjectStore::SetDocumentBody(const base::Uuid& project_id,
+                                   const base::Uuid& node_id,
+                                   const std::string& body) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Project* project = FindProjectMutable(project_id);
+  if (!project) {
+    return false;
+  }
+  Node* target = nullptr;
+  for (Node& node : project->nodes) {
+    if (node.id == node_id) {
+      target = &node;
+      break;
+    }
+  }
+  if (!target) {
+    return false;
+  }
+
+  if (!target->document.is_valid()) {
+    // The document gets its own identity, distinct from the node's, so that a
+    // node moved in the hierarchy carries the same document rather than a copy
+    // of it (section 2.2).
+    Document document;
+    document.id = base::Uuid::GenerateRandomV4();
+    target->document = document.id;
+    project->documents.push_back(std::move(document));
+  }
+  for (Document& document : project->documents) {
+    if (document.id == target->document) {
+      // Stored exactly as handed over. Nothing here paginates, normalises, or
+      // rewrites the bytes (DOC-4).
+      document.body = body;
+      document.body_modified = base::Time::Now();
+      break;
+    }
+  }
+  Save();
+  return true;
+}
+
+std::optional<std::string> ProjectStore::GetDocumentBody(
+    const base::Uuid& project_id,
+    const base::Uuid& node_id) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const Project* project = FindProject(project_id);
+  if (!project) {
+    return std::nullopt;
+  }
+  const Node* node = FindNode(*project, node_id);
+  if (!node) {
+    return std::nullopt;
+  }
+  const Document* document = FindDocumentFor(*project, *node);
+  if (!document) {
+    return std::nullopt;
+  }
+  return document->body;
+}
+
+bool ProjectStore::DeleteProject(const base::Uuid& project_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto project = projects_.begin(); project != projects_.end();
+       ++project) {
+    if (project->id == project_id) {
+      // The documents are inside the project, so removing the project removes
+      // them. DOC-7 is a property of the layout rather than a sweep that could
+      // miss one.
+      projects_.erase(project);
+      Save();
+      return true;
+    }
+  }
+  return false;
+}
+
+void ProjectStore::Save() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::ListValue projects;
+  for (const Project& project : projects_) {
+    projects.Append(ToValue(project));
+  }
+  base::DictValue root;
+  root.Set(kProjects, std::move(projects));
+
+  std::optional<std::string> serialised = base::WriteJson(root);
+  if (!serialised.has_value()) {
+    // Refusing to write is the right failure: a partial store would be read
+    // back as a store with things missing from it.
+    return;
+  }
+  writer_->WriteNow(std::move(*serialised));
+}
+
+}  // namespace sunshine::document
