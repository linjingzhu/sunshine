@@ -0,0 +1,75 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * The unprivileged reading frame.
+ *
+ * It renders one document and can do nothing else. It has no host interface,
+ * because it needs none: it is handed content and never asks for any. That is
+ * DOC-2 from the receiving side -- "the frame receives content, never
+ * capability" -- and it is why this file contains no `chrome.send`, no
+ * identifier, and no way to name a project, a node, or a document.
+ *
+ * It answers nothing either. There is no `postMessage` call in this file: the
+ * shell learns the frame is ready from the iframe's own `load` event, so the
+ * frame never has to say anything back, and "the frame sends back nothing that
+ * can name a resource, a path, or an operation" is satisfied by the frame
+ * sending back nothing at all.
+ *
+ * It reaches no network (DOC-5). That is enforced by the content security
+ * policy in
+ * chrome/browser/ui/webui/sunshine/document/sunshine_document_content_ui.cc,
+ * not by anything here: a document referencing a remote image shows the image
+ * as absent because the load is refused, and nothing in this file inspects or
+ * rewrites the document to make that true.
+ */
+
+/** The only origin whose messages are read. */
+const SHELL_ORIGIN = 'chrome://sunshine-document';
+
+/**
+ * Replaces the rendered document.
+ *
+ * `DOMParser` rather than an assignment to `innerHTML`. The two differ in a
+ * way that matters here: a script element produced by `DOMParser` is marked
+ * "already started" by the HTML fragment parsing rules, so it never runs when
+ * it is adopted into this document, and no string on this page is ever handed
+ * to the HTML parser of the live document. It also keeps this file within
+ * SEC-14 and within Chromium's Trusted Types policy for WebUI, which is what
+ * scripts/verify_web_asset_security.py checks for at review time.
+ *
+ * Only the parsed body is adopted. A document's own <head> -- its title, its
+ * meta elements, its links -- is not this frame's to apply.
+ */
+function render(html: string) {
+  const target = document.body.querySelector<HTMLElement>('#content');
+  const placeholder = document.body.querySelector<HTMLElement>('#placeholder');
+  if (!target || !placeholder) {
+    return;
+  }
+
+  target.replaceChildren();
+  placeholder.toggleAttribute('hidden', html !== '');
+  if (html === '') {
+    return;
+  }
+
+  const parsed = new DOMParser().parseFromString(html, 'text/html');
+  const adopted = document.importNode(parsed.body, true);
+  target.append(...Array.from(adopted.childNodes));
+}
+
+window.addEventListener('message', (event: MessageEvent) => {
+  // The origin is checked before the payload is looked at, and the payload is
+  // required to be a string. A message is a document and nothing else: there is
+  // no field beside it that could carry a name, so there is nothing to
+  // validate past its type.
+  if (event.origin !== SHELL_ORIGIN) {
+    return;
+  }
+  if (typeof event.data !== 'string') {
+    return;
+  }
+  render(event.data);
+});
