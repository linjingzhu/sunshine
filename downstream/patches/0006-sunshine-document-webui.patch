+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineDocumentUI;
+
+// The privileged half of the document surface, at chrome://sunshine-document.
+//
+// Registered through content's WebUI config map, like every Sunshine surface;
+// docs/decisions/0003-internal-scheme.md records why Sunshine registers no
+// scheme of its own.
+class SunshineDocumentUIConfig
+    : public content::DefaultWebUIConfig<SunshineDocumentUI> {
+ public:
+  SunshineDocumentUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineDocumentHost) {}
+};
+
+// Lists projects, shows the hierarchy as a table of contents in reading order,
+// and lets a person create a project, add a node, and author or paste the HTML
+// of a node's document.
+//
+// It renders none of that HTML. docs/DOCUMENT_SURFACE_CONTRACT.md section 1 is
+// the one structural decision the rest of the surface follows from: project
+// content is authored by a person, a WebUI page runs at a privilege no website
+// has, and rendering the first inside the second is the failure
+// docs/SECURITY_ARCHITECTURE_CONTRACT.md exists to prevent. The content goes to
+// chrome-untrusted://sunshine-document-content, in an iframe, by postMessage.
+//
+// The content security policy set below is the browser-side half of that
+// arrangement: this page may embed exactly one origin, and it is Chromium's
+// own untrusted scheme rather than anything Sunshine registered.
+class SunshineDocumentUI : public content::WebUIController {
+ public:
+  explicit SunshineDocumentUI(content::WebUI* web_ui);
+
+  SunshineDocumentUI(const SunshineDocumentUI&) = delete;
+  SunshineDocumentUI& operator=(const SunshineDocumentUI&) = delete;
+
+  ~SunshineDocumentUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DOCUMENT_SUNSHINE_DOCUMENT_UI_H_
