+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SUNSHINE_SPLIT_LINK_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_UI_SUNSHINE_SPLIT_LINK_NAVIGATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace sunshine {
+
+// Sends an ordinary link click in a split's anchor tab to the other half.
+//
+// **A throttle, and it has to be.** An `<a href>` followed in the same frame
+// never reaches the `WebContentsDelegate` hook that opens a URL from a tab --
+// that hook sees the navigations asking for a different target, which is why
+// the context menu's "Open link in split view" can be written as a menu item
+// while this cannot. The only place the browser is asked about a same-frame
+// link before it commits is the navigation throttle list.
+//
+// The conditions in `MaybeCreateAndAdd()` are the whole security argument for
+// the feature; see the comment there.
+class SplitLinkNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit SplitLinkNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  SplitLinkNavigationThrottle(const SplitLinkNavigationThrottle&) = delete;
+  SplitLinkNavigationThrottle& operator=(const SplitLinkNavigationThrottle&) =
+      delete;
+  ~SplitLinkNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace sunshine
+
+#endif  // CHROME_BROWSER_UI_SUNSHINE_SPLIT_LINK_NAVIGATION_THROTTLE_H_
