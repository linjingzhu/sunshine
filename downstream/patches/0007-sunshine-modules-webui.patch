+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_MODULES_SUNSHINE_MODULES_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_MODULES_SUNSHINE_MODULES_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineModulesUI;
+
+// The Sunshine module home, at chrome://sunshine-modules.
+//
+// Registered through content's WebUI config map rather than through a Sunshine
+// URL scheme; docs/decisions/0003-internal-scheme.md records why Sunshine
+// registers no scheme of its own.
+class SunshineModulesUIConfig
+    : public content::DefaultWebUIConfig<SunshineModulesUI> {
+ public:
+  SunshineModulesUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUISunshineModulesHost) {}
+};
+
+// Lists the first-party modules built into this browser and what each one
+// declares. It is a report, not a control panel: nothing on this page installs,
+// removes, enables, or reorders anything, because there is nothing to install
+// -- the registry is fixed when the browser is built.
+//
+// A plain content::WebUIController, not ui::MojoWebUIController: the page needs
+// one string that is known before it loads, so it arrives through the data
+// source and there is no interface to grant. A surface with no host interface
+// should not have the machinery for one.
+class SunshineModulesUI : public content::WebUIController {
+ public:
+  explicit SunshineModulesUI(content::WebUI* web_ui);
+
+  SunshineModulesUI(const SunshineModulesUI&) = delete;
+  SunshineModulesUI& operator=(const SunshineModulesUI&) = delete;
+
+  ~SunshineModulesUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_MODULES_SUNSHINE_MODULES_UI_H_
