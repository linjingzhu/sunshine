+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/modules/sunshine_modules_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/sunshine/modules/sunshine_module_registry.h"
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+SunshineModulesUI::SunshineModulesUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineModulesHost);
+
+  // The registry, handed over as the JSON text it already is rather than
+  // unpacked into a pile of AddString calls. Two reasons, and neither is
+  // convenience: the manifest schema is defined in `first_party/`, so a C++
+  // projection of it here would be a second schema to keep in step; and the
+  // guard that keeps this copy honest --
+  // `scripts/verify_module_registry_sync.py` -- can only compare bytes if
+  // there are bytes to compare.
+  //
+  // The page parses it with JSON.parse. That is data, not code: SEC-14 forbids
+  // eval and dynamically generated code in a Sunshine web asset, and nothing
+  // here generates any.
+  source->AddString("moduleRegistry", sunshine::kSunshineModuleRegistryJson);
+
+  // Every Sunshine surface is built into one resource bundle; this asks for
+  // the "modules/" part of it, served from the root of this host.
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("modules"),
+                              IDR_SUNSHINE_MODULES_APP_HTML);
+}
+
+SunshineModulesUI::~SunshineModulesUI() = default;
