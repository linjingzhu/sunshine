+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_MODULES_SUNSHINE_MODULE_REGISTRY_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_MODULES_SUNSHINE_MODULE_REGISTRY_H_
+
+namespace sunshine {
+
+// The first-party module registry, as chrome://sunshine-modules is served it.
+//
+// GENERATED CONTENT -- DO NOT EDIT BY HAND. This is a copy of the manifests in
+// `first_party/`, which is the Sunshine repository and not something a Chromium
+// build can read: the manifests are a directory of JSON files on the other side
+// of the patch stack, and nothing carries them across. So the registry is baked
+// in here, and `scripts/verify_module_registry_sync.py` recomputes this exact
+// string from `first_party/` and fails the guard job when the two disagree.
+//
+// The canonical form is defined once, in `scripts/module_registry_payload.py`:
+// `json.dumps(..., indent=2, sort_keys=True)` over the whole manifests, in the
+// order `first_party/registry.json` lists them. Regenerate rather than edit --
+// the guard compares bytes, so a hand-edit that is merely equivalent still
+// fails, which is the point.
+//
+// Whole manifests, not a projection of the fields the page happens to show. A
+// projection is a second schema: it would need keeping in step with the first,
+// and the drift it allowed would be invisible in exactly the surface whose job
+// is to say what is installed.
+inline constexpr char kSunshineModuleRegistryJson[] = R"json(
+{
+  "modules": [
+    {
+      "capabilities": [],
+      "data": [
+        {
+          "access": "write",
+          "owner": "sunshine",
+          "retention": "persistent",
+          "scope": "profile"
+        }
+      ],
+      "display_name": "Sunshine Documents",
+      "entrypoints": [
+        {
+          "target": "chrome://sunshine-document",
+          "type": "chromium_webui"
+        }
+      ],
+      "id": "sunshine.document",
+      "kind": "surface",
+      "lifecycle": "profile",
+      "owner": "sunshine",
+      "schema_version": 2,
+      "security": {
+        "credentials": {
+          "direct_access": false
+        },
+        "filesystem": {
+          "access": "none"
+        },
+        "network": {
+          "access": "deny",
+          "allow": []
+        },
+        "profile_modes": [
+          "regular"
+        ],
+        "remote_content": false,
+        "requires_user_activation": true
+      },
+      "status": "prepared",
+      "verification": {
+        "native_build": "pending",
+        "runtime": "pending",
+        "visual": "pending"
+      }
+    },
+    {
+      "capabilities": [],
+      "data": [
+        {
+          "access": "read",
+          "owner": "sunshine",
+          "retention": "none",
+          "scope": "profile"
+        }
+      ],
+      "display_name": "Sunshine Modules",
+      "entrypoints": [
+        {
+          "target": "chrome://sunshine-modules",
+          "type": "chromium_webui"
+        }
+      ],
+      "id": "sunshine.modules",
+      "kind": "surface",
+      "lifecycle": "profile",
+      "owner": "sunshine",
+      "schema_version": 2,
+      "security": {
+        "credentials": {
+          "direct_access": false
+        },
+        "filesystem": {
+          "access": "none"
+        },
+        "network": {
+          "access": "deny",
+          "allow": []
+        },
+        "profile_modes": [
+          "regular"
+        ],
+        "remote_content": false,
+        "requires_user_activation": false
+      },
