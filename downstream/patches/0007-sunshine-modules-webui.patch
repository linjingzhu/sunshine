diff --git a/chrome/browser/resources/sunshine/modules/app.css b/chrome/browser/resources/sunshine/modules/app.css
new file mode 100644
index 0000000..4c6864f
--- /dev/null
+++ b/chrome/browser/resources/sunshine/modules/app.css
@@ -0,0 +1,266 @@
+/* Copyright 2026 The Sunshine OS contributors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ *
+ * Every colour is read from Chromium's colour pipeline through
+ * chrome://theme/colors.css, per docs/DESIGN_SYSTEM_CONTRACT.md sections 2.1
+ * and 2.3: Sunshine declares no colour of its own and no fallback, so a token
+ * that stops existing fails visibly instead of silently escaping the theme.
+ * The five roles used here are the five the rest of the stack already uses;
+ * this surface introduces none. */
+
+body {
+  background-color: var(--color-dialog-background);
+  color: var(--color-primary-foreground);
+  margin: 0;
+}
+
+#page {
+  display: grid;
+  grid-template-columns: 236px 1fr;
+  height: 100vh;
+}
+
+/* The left column ------------------------------------------------------- */
+
+#nav {
+  border-inline-end: 1px solid var(--color-midground);
+  overflow-y: auto;
+  padding: 1.5rem 0.75rem;
+}
+
+.navsec {
+  align-items: center;
+  color: var(--color-secondary-foreground);
+  display: flex;
+  font-size: 0.75rem;
+  font-weight: 600;
+  gap: 0.5rem;
+  letter-spacing: 0.04em;
+  padding: 0 0.75rem 0.5rem;
+  text-transform: uppercase;
+}
+
+.count {
+  font-weight: 400;
+}
+
+#navList {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.navitem {
+  align-items: center;
+  border: 0;
+  background: none;
+  border-radius: 0.5rem;
+  color: inherit;
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  gap: 0.625rem;
+  padding: 0.5rem 0.75rem;
+  text-align: start;
+  width: 100%;
+}
+
+.navitem:hover {
+  background-color: var(--color-midground);
+}
+
+/* The current item is marked by aria-current, so the highlight and the
+ * accessible state cannot disagree -- there is only one of them. */
+.navitem[aria-current='true'] {
+  background-color: var(--color-midground);
+  font-weight: 500;
+}
+
+.tile {
+  block-size: 1.25rem;
+  border: 1px solid var(--color-secondary-foreground);
+  border-radius: 0.25rem;
+  flex: 0 0 auto;
+  inline-size: 1.25rem;
+}
+
+.navtext {
+  min-width: 0;
+}
+
+.navname {
+  display: block;
+  font-size: 0.875rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.navid {
+  color: var(--color-secondary-foreground);
+  display: block;
+  font-size: 0.75rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* The right column ------------------------------------------------------ */
+
+#main {
+  overflow-y: auto;
+  padding: 1.5rem 2rem 3rem;
+}
+
+.crumb {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+  margin: 0 0 0.5rem;
+}
+
+h1 {
+  font-size: 1.5rem;
+  font-weight: 500;
+  margin: 0;
+}
+
+h2 {
+  font-size: 1rem;
+  font-weight: 600;
+  margin: 2rem 0 0.5rem;
+}
+
+.lede {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+  line-height: 1.6;
+  margin: 0.5rem 0 1.5rem;
+  max-width: 44rem;
+}
+
+/* MH-7. The paragraph and the one control that switches it, side by side --
+ * the control is next to the text it acts on rather than in a toolbar, which
+ * is the only place it means anything. It wraps below on a narrow pane
+ * because the paragraph is the content and the switch is not. */
+#descriptionRow {
+  align-items: start;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1rem;
+  justify-content: space-between;
+  margin-bottom: 1.5rem;
+  max-width: 44rem;
+}
+
+#descriptionRow .lede {
+  flex: 1 1 22rem;
+  margin-bottom: 0;
+}
+
+#languageSwitch {
+  display: flex;
+  flex: 0 0 auto;
+  gap: 0.25rem;
+}
+
+.lang {
+  background: none;
+  border: 1px solid var(--color-midground);
+  border-radius: 0.25rem;
+  color: var(--color-secondary-foreground);
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.75rem;
+  padding: 0.25rem 0.625rem;
+}
+
+/* aria-pressed is the state and the highlight at once, as aria-current is in
+ * the nav. Two ways to say the same thing is two ways to disagree. */
+.lang[aria-pressed='true'] {
+  background-color: var(--color-midground);
+  color: var(--color-primary-foreground);
+  font-weight: 500;
+}
+
+table {
+  border-collapse: collapse;
+  font-size: 0.875rem;
+  width: 100%;
+}
+
+th,
+td {
+  border-bottom: 1px solid var(--color-midground);
+  padding: 0.75rem 0.5rem;
+  text-align: start;
+  vertical-align: top;
+}
+
+th {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.rowname {
+  font-weight: 500;
+}
+
+.rowid {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+}
+
+/* A permission that is held reads as a warning, because on this page the
+ * unusual value is the one worth finding. "deny" and "none" are the ordinary
+ * state and get no colour at all. */
+.granted {
+  color: var(--color-alert-high-severity);
+  font-weight: 500;
+}
+
+.facts {
+  margin: 0;
+}
+
+.fact {
+  border-top: 1px solid var(--color-midground);
+  display: flex;
+  gap: 1rem;
+  justify-content: space-between;
+  padding: 0.75rem 0;
+}
+
+.fact dt {
+  color: var(--color-secondary-foreground);
+  font-size: 0.875rem;
+}
+
+.fact dd {
+  font-size: 0.875rem;
+  font-weight: 500;
+  margin: 0;
+  text-align: end;
+}
+
+.plain {
+  font-size: 0.875rem;
+  line-height: 1.7;
+  margin: 0;
+  padding-inline-start: 1.25rem;
+}
+
+.mono {
+  font-family: monospace;
+}
+
+.note {
+  color: var(--color-secondary-foreground);
+  font-size: 0.75rem;
+  line-height: 1.6;
+  margin: 1.5rem 0 0;
+  max-width: 44rem;
+}
diff --git a/chrome/browser/resources/sunshine/modules/app.html b/chrome/browser/resources/sunshine/modules/app.html
new file mode 100644
index 0000000..dce4a99
--- /dev/null
+++ b/chrome/browser/resources/sunshine/modules/app.html
@@ -0,0 +1,94 @@
+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine Modules</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <!-- Two columns, permanently. The left one is the module list; the right one
+       is either the overview table or one module's detail. Both are built by
+       app.ts from the registry the browser hands the page, so neither is
+       written out here: markup that named a module would be a third place a
+       module is declared, after first_party/ and the baked copy. -->
+  <div id="page">
+    <nav id="nav" aria-label="Modules">
+      <div class="navsec">
+        <span>Modules</span><span id="moduleCount" class="count"></span>
+      </div>
+      <ul id="navList"></ul>
+    </nav>
+
+    <main id="main">
+      <p id="crumb" class="crumb"></p>
+      <h1 id="title"></h1>
+      <p id="lede" class="lede"></p>
+
+      <section id="overview">
+        <table id="overviewTable">
+          <thead>
+            <tr>
+              <th scope="col">Module</th>
+              <th scope="col">Kind</th>
+              <th scope="col">Status</th>
+              <th scope="col">Network</th>
+              <th scope="col">Filesystem</th>
+              <th scope="col">Verified</th>
+            </tr>
+          </thead>
+          <tbody id="overviewBody"></tbody>
+        </table>
+        <p class="note">
+          The table stays even though the list on the left names the same
+          modules, because a list answers &ldquo;where do I go&rdquo; and a
+          table answers &ldquo;which of these holds a permission&rdquo;. With
+          three modules those look alike; they stop looking alike at ten.
+        </p>
+      </section>
+
+      <section id="detail" hidden>
+        <!-- MH-7. One control for the page, not one per module: a reader
+             picks a language, not a language per row. It lives beside the
+             text it switches and is absent from the overview, where there is
+             nothing to switch. The choice is held in memory only -- this page
+             writes nothing, anywhere, and a remembered preference would be
+             the first thing it wrote. -->
+        <div id="descriptionRow">
+          <p id="description" class="lede"></p>
+          <div id="languageSwitch" role="group"
+              aria-label="Description language">
+            <button type="button" class="lang" data-lang="ko">한국어</button>
+            <button type="button" class="lang" data-lang="en">English</button>
+          </div>
+        </div>
+
+        <dl id="detailFacts" class="facts"></dl>
+
+        <h2>Entry points</h2>
+        <ul id="detailEntrypoints" class="plain"></ul>
+
+        <h2>Capabilities</h2>
+        <ul id="detailCapabilities" class="plain"></ul>
+        <p id="noCapabilities" class="note" hidden>
+          This module asks Chromium for nothing.
+        </p>
+
+        <h2>Data</h2>
+        <ul id="detailData" class="plain"></ul>
+
+        <h2>Verification</h2>
+        <dl id="detailVerification" class="facts"></dl>
+        <p class="note">
+          <strong>Pending</strong> means nobody has run the gate, not that it
+          failed. docs/RUNTIME_VERIFICATION.md holds the gates and their state;
+          this page reports what the manifest claims and does not decide it.
+        </p>
+      </section>
+    </main>
+  </div>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/sunshine/modules/app.ts b/chrome/browser/resources/sunshine/modules/app.ts
new file mode 100644
index 0000000..9ec65b8
--- /dev/null
+++ b/chrome/browser/resources/sunshine/modules/app.ts
@@ -0,0 +1,326 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {loadTimeData} from '//resources/js/load_time_data.js';
+
+/**
+ * The module home.
+ *
+ * Every node below is built with createElement and textContent. Nothing here
+ * assigns markup, and that is a rule rather than a style: the registry is
+ * first-party build-time data today, but this is a privileged page, and the
+ * moment a module id could come from anywhere else an innerHTML here would be
+ * the whole vulnerability. Writing it the safe way while the data is trusted
+ * costs nothing; retrofitting it after the data changes costs an audit.
+ */
+
+interface Entrypoint {
+  type: string;
+  target: string;
+}
+
+interface Capability {
+  name: string;
+  access: string;
+}
+
+interface DataDeclaration {
+  owner: string;
+  scope: string;
+  access: string;
+  retention: string;
+}
+
+interface Security {
+  remote_content: boolean;
+  requires_user_activation: boolean;
+  profile_modes: string[];
+  network: {access: string, allow: string[]};
+  filesystem: {access: string};
+  credentials: {direct_access: boolean};
+}
+
+interface Verification {
+  native_build: string;
+  runtime: string;
+  visual: string;
+}
+
+// MH-7. Both languages are required by
+// `scripts/validate_first_party_modules.py`, so neither is optional here and
+// there is no fallback to write. A `string|undefined` would be a fallback
+// waiting to be added.
+interface Description {
+  ko: string;
+  en: string;
+}
+
+type Language = keyof Description;
+
+interface Module {
+  schema_version: number;
+  id: string;
+  display_name: string;
+  description: Description;
+  owner: string;
+  kind: string;
+  lifecycle: string;
+  status: string;
+  entrypoints: Entrypoint[];
+  capabilities: Capability[];
+  data: DataDeclaration[];
+  security: Security;
+  verification: Verification;
+}
+
+interface Registry {
+  schema_version: number;
+  modules: Module[];
+}
+
+function element<T extends HTMLElement>(id: string): T {
+  const found = document.getElementById(id);
+  if (!found) {
+    throw new Error(`sunshine-modules: #${id} is missing from app.html`);
+  }
+  return found as T;
+}
+
+function text(tag: string, value: string, className?: string): HTMLElement {
+  const node = document.createElement(tag);
+  node.textContent = value;
+  if (className) {
+    node.className = className;
+  }
+  return node;
+}
+
+function fact(list: HTMLElement, label: string, value: string): void {
+  const row = document.createElement('div');
+  row.className = 'fact';
+  row.append(text('dt', label), text('dd', value));
+  list.append(row);
+}
+
+/**
+ * Whether a declared permission is more than the ordinary none. Used only to
+ * decide emphasis: the value shown is always the manifest's own word, never a
+ * verdict this page invented.
+ */
+function isGranted(value: string): boolean {
+  return value !== 'deny' && value !== 'none';
+}
+
+function permissionCell(value: string): HTMLElement {
+  return text('td', value, isGranted(value) ? 'granted' : '');
+}
+
+function verifiedSummary(verification: Verification): string {
+  const states = [
+    verification.native_build,
+    verification.runtime,
+    verification.visual,
+  ];
+  const passed = states.filter(state => state === 'passed').length;
+  return `${passed} of ${states.length}`;
+}
+
+class ModuleHome {
+  private readonly modules: Module[];
+  private readonly navList = element<HTMLUListElement>('navList');
+  private readonly overview = element('overview');
+  private readonly detail = element('detail');
+  private readonly crumb = element('crumb');
+  private readonly title = element('title');
+  private readonly lede = element('lede');
+  private readonly description = element('description');
+  // The module whose detail is on screen, or null on the overview. The
+  // language switch needs it to redraw one paragraph without rebuilding the
+  // pane around it.
+  private shown: Module|null = null;
+  private language: Language = 'ko';
+
+  constructor(registry: Registry) {
+    this.modules = registry.modules;
+    element('moduleCount').textContent = String(this.modules.length);
+    this.buildNav();
+    this.buildLanguageSwitch();
+    this.showOverview();
+  }
+
+  private buildLanguageSwitch(): void {
+    for (const button of element('languageSwitch')
+             .querySelectorAll<HTMLButtonElement>('button.lang')) {
+      // dataset rather than the label: the label is the language's own name
+      // and belongs to the reader, the key belongs to the manifest, and
+      // deriving one from the other would tie them together for no reason.
+      const language = button.dataset['lang'] as Language;
+      button.addEventListener('click', () => {
+        this.language = language;
+        this.drawDescription();
+      });
+    }
+    this.drawDescription();
+  }
+
+  private drawDescription(): void {
+    for (const button of element('languageSwitch')
+             .querySelectorAll<HTMLButtonElement>('button.lang')) {
+      button.setAttribute(
+          'aria-pressed', String(button.dataset['lang'] === this.language));
+    }
+    // textContent, like every other manifest value on this page. MH-4.
+    this.description.textContent =
+        this.shown ? this.shown.description[this.language] : '';
+  }
+
+  private buildNav(): void {
+    this.navList.append(this.navItem('All modules', 'overview', null));
+    for (const module of this.modules) {
+      this.navList.append(
+          this.navItem(module.display_name, module.id, module));
+    }
+  }
+
+  private navItem(name: string, id: string, module: Module|null): HTMLLIElement {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.className = 'navitem';
+    button.type = 'button';
+    button.dataset['key'] = id;
+
+    const tile = document.createElement('span');
+    tile.className = 'tile';
+
+    const label = document.createElement('span');
+    label.className = 'navtext';
+    label.append(text('span', name, 'navname'));
+    label.append(text('span', module ? module.id : 'overview', 'navid'));
+
+    button.append(tile, label);
+    button.addEventListener('click', () => {
+      if (module) {
+        this.showModule(module);
+      } else {
+        this.showOverview();
+      }
+    });
+    item.append(button);
+    return item;
+  }
+
+  private markCurrent(key: string): void {
+    for (const button of this.navList.querySelectorAll('button.navitem')) {
+      const current = (button as HTMLElement).dataset['key'] === key;
+      // Set rather than toggled: aria-current is both the highlight and the
+      // announced state, so there is no second place for them to disagree.
+      button.setAttribute('aria-current', String(current));
+    }
+  }
+
+  private showOverview(): void {
+    this.shown = null;
+    this.markCurrent('overview');
+    this.crumb.textContent = 'Sunshine';
+    this.title.textContent = 'All modules';
+    this.lede.textContent =
+        'Modules built into this browser. This list is fixed at build time: ' +
+        'nothing here can be installed, removed, or reordered from the ' +
+        'running browser.';
+    this.overview.hidden = false;
+    this.detail.hidden = true;
+
+    const body = element('overviewBody');
+    body.replaceChildren();
+    for (const module of this.modules) {
+      const row = document.createElement('tr');
+
+      const name = document.createElement('td');
+      name.append(text('div', module.display_name, 'rowname'));
+      name.append(text('div', module.id, 'rowid'));
+
+      row.append(
+          name,
+          text('td', module.kind),
+          text('td', module.status),
+          permissionCell(module.security.network.access),
+          permissionCell(module.security.filesystem.access),
+          text('td', verifiedSummary(module.verification)));
+      body.append(row);
+    }
+  }
+
+  private showModule(module: Module): void {
+    this.shown = module;
+    this.markCurrent(module.id);
+    this.crumb.textContent = `Sunshine / ${module.id}`;
+    this.title.textContent = module.display_name;
+    this.lede.textContent =
+        `A ${module.kind} module owned by ${module.owner}, living for the ` +
+        `lifetime of a ${module.lifecycle}.`;
+    this.overview.hidden = true;
+    this.detail.hidden = false;
+    this.drawDescription();
+
+    const facts = element('detailFacts');
+    facts.replaceChildren();
+    fact(facts, 'Identifier', module.id);
+    fact(facts, 'Status', module.status);
+    fact(facts, 'Network', module.security.network.access);
+    fact(facts, 'Filesystem', module.security.filesystem.access);
+    fact(
+        facts, 'Remote content',
+        module.security.remote_content ? 'allowed' : 'no');
+    fact(
+        facts, 'Direct credential access',
+        module.security.credentials.direct_access ? 'allowed' : 'no');
+    fact(facts, 'Profiles', module.security.profile_modes.join(', '));
+
+    const entrypoints = element('detailEntrypoints');
+    entrypoints.replaceChildren();
+    for (const entrypoint of module.entrypoints) {
+      const item = document.createElement('li');
+      item.append(text('span', entrypoint.target, 'mono'));
+      item.append(text('span', ` — ${entrypoint.type}`));
+      entrypoints.append(item);
+    }
+
+    const capabilities = element('detailCapabilities');
+    capabilities.replaceChildren();
+    for (const capability of module.capabilities) {
+      const item = document.createElement('li');
+      item.append(text('span', capability.name, 'mono'));
+      item.append(text('span', ` — ${capability.access}`));
+      capabilities.append(item);
+    }
+    const empty = module.capabilities.length === 0;
+    capabilities.hidden = empty;
+    element('noCapabilities').hidden = !empty;
+
+    const data = element('detailData');
+    data.replaceChildren();
+    for (const declaration of module.data) {
+      data.append(text(
+          'li',
+          `${declaration.owner} data, ${declaration.scope} scope, ` +
+              `${declaration.access}, retained ${declaration.retention}`));
+    }
+
+    const verification = element('detailVerification');
+    verification.replaceChildren();
+    fact(verification, 'Native build', module.verification.native_build);
+    fact(verification, 'Runtime', module.verification.runtime);
+    fact(verification, 'Visual', module.verification.visual);
+  }
+}
+
+document.addEventListener('DOMContentLoaded', function() {
+  // JSON.parse, not eval and not a generated module: SEC-14 forbids dynamic
+  // code in a Sunshine web asset, and the registry is data.
+  const registry = JSON.parse(loadTimeData.getString('moduleRegistry')) as
+      Registry;
+  new ModuleHome(registry);
+});
