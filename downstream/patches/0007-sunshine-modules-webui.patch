diff --git a/chrome/browser/ui/webui/sunshine/modules/sunshine_module_registry.h b/chrome/browser/ui/webui/sunshine/modules/sunshine_module_registry.h
new file mode 100644
index 0000000..9ccd297
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/modules/sunshine_module_registry.h
@@ -0,0 +1,377 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
