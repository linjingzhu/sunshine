@@ -1628,6 +1658,13 @@ void BookmarkBarView::Init() {
 
   // Child views are traversed in the order they are added. Make sure the order
   // they are added matches the visual order.
+  //
+  // The Sunshine module home is added first because it is drawn first, and the
+  // comment above is the reason that matters: this list is also the focus
+  // order, so a button drawn at the leading edge but added last would be
+  // reached last by the keyboard.
+  sunshine_module_home_ = AddChildView(CreateSunshineModuleHomeButton());
+
   apps_page_shortcut_ = AddChildView(CreateAppsPageShortcutButton());
 
