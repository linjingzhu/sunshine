 }
 
+std::unique_ptr<views::LabelButton>
+BookmarkBarView::CreateSunshineModuleHomeButton() {
+  // A ShortcutButton like the apps page shortcut, and for the same reason: it
+  // opens a page rather than dropping a menu, so it must not look like the
+  // folder buttons that do.
+  //
+  // The strings are literals rather than IDS_ constants. Adding one would mean
+  // owning chrome/app/generated_resources.grd, which is among the files that
+  // churn hardest upstream, for two strings -- and this stack rebases onto a
+  // new Chromium tag by hand. That is a real cost accepted knowingly: it means
+  // this button does not translate.
+  // docs/decisions/0014-bookmark-bar-contribution-point.md section 4.
+  auto button = std::make_unique<ShortcutButton>(
+      base::BindRepeating(&BookmarkBarView::SunshineModuleHomePressed,
+                          base::Unretained(this)),
+      std::u16string());
+  button->SetTooltipText(u"Sunshine modules");
+  button->GetViewAccessibility().SetName(u"Sunshine modules");
+  // Deliberately not VIEW_ID_BOOKMARK_BAR_ELEMENT. That id marks a view this
+  // bar treats as one of its bookmark elements -- for its context menu and its
+  // drag handling -- and this button is neither. Borrowing the id to look
+  // native would enlist it in behaviour it cannot honour.
+
+  // No text, so no label to size. The icon itself is set in
+  // UpdateAppearanceForTheme(), which is the only place a colour is available.
+  return button;
+}
+
 void BookmarkBarView::ConfigureButton(const BookmarkNode* node,
                                       views::LabelButton* button) {
   button->SetText(node->GetTitle());
@@ -2221,6 +2286,33 @@ void BookmarkBarView::UpdateAppearanceForTheme() {
 
   apps_page_shortcut_->SetEnabledTextColors(color);
 
+  {
+    // Same colour role, same 16dp, and the same SkColor overload as the
+    // overflow button below, so the one button Sunshine adds to this bar
+    // carries the same weight as Chromium's own rather than sitting on it as a
+    // foreign object.
+    //
+    // kWebAssetIcon is borrowed, not designed. Chromium has no glyph meaning
+    // "the parts this browser is made of", and the nearest one -- kGridViewIcon
+    // -- is what the saved tab group button immediately to the right already
+    // uses, so it was rejected: two adjacent buttons sharing a glyph is worse
+    // than a glyph that means little. kWebAssetIcon appears nowhere on the
+    // browser frame (its one use is the app menu's "Name window" item), so
+    // nothing here collides.
+    // docs/decisions/0014-bookmark-bar-contribution-point.md section 5 records
+    // what a Sunshine-owned icon would cost and why it is not this patch.
+    const SkColor modules_color =
+        color_provider->GetColor(kColorBookmarkButtonIcon);
+    ui::ImageModel modules_icon =
+        ui::ImageModel::FromVectorIcon(kWebAssetIcon, modules_color, 16);
+    sunshine_module_home_->SetImageModel(views::Button::STATE_NORMAL,
+                                         modules_icon);
+    sunshine_module_home_->SetImageModel(
+        views::Button::STATE_DISABLED,
+        ui::GetDefaultDisabledIconFromImageModel(modules_icon,
+                                                 color_provider));
+  }
+
   const SkColor overflow_color =
       color_provider->GetColor(kColorBookmarkButtonIcon);
   const int overflow_size = 16;
