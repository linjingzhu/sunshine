+void BookmarkBarView::SunshineModuleHomePressed(const ui::Event& event) {
+  // `page_navigator_` is set by SetPageNavigator() after construction, and this
+  // button exists from Init(), so a press before that is reachable in a way it
+  // is not for the buttons around it -- those are hidden behind preferences
+  // that are off by default. Dropping the press is the correct response: there
+  // is no window to open into yet.
+  if (!page_navigator_) {
+    return;
+  }
+  content::OpenURLParams params(GURL(chrome::kChromeUISunshineModulesURL),
+                                content::Referrer(),
+                                ui::DispositionFromEventFlags(event.flags()),
+                                ui::PAGE_TRANSITION_AUTO_BOOKMARK, false);
+  page_navigator_->OpenURL(params, /*navigation_handle_callback=*/{});
+}
