+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/sunshine/newtab_background.h"
+
+#include <map>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/synchronization/lock.h"
+#include "base/task/thread_pool.h"
+
+namespace sunshine::background {
+
+namespace {
+
+// The signatures the owner's rule admits, and nothing else.
+//
+// A GIF (`GIF87a`/`GIF89a`) and an AVIF (`....ftypavif`) are absent on
+// purpose, and both are formats Blink would decode perfectly well if they
+// were allowed to reach the decoder. The refusal is a product rule rather
+// than a capability limit, which is exactly why it has to be written down
+// somewhere a reader can find it.
+constexpr uint8_t kPngSignature[] = {0x89, 0x50, 0x4E, 0x47,
+                                     0x0D, 0x0A, 0x1A, 0x0A};
+
+// JPEG has no fixed-length header the way PNG does. Every JPEG begins
+// SOI (`FF D8`) followed by the first marker's `FF`; the byte after that
+// varies by encoder, so three bytes is the whole of what is common.
+constexpr uint8_t kJpegSignature[] = {0xFF, 0xD8, 0xFF};
+
+// **WebP's identity is not a prefix, and treating it as one is a real bug
+// rather than a sloppy one.**
+//
+// `RIFF` is a container tag, not a format: WAV and AVI open with the same
+// four bytes. What says WebP is the `WEBP` tag at offset 8, after the
+// container's 32-bit length field. A check that accepted anything beginning
+// `RIFF` would accept a renamed WAV as a New Tab background -- and would look,
+// in the source, exactly like a signature check.
+//
+// Both tags are required, at both offsets. That is what
+// `scripts/verify_newtab_background.py` holds: declaring `kRiffTag` without
+// `kWebpTag` is refused, because the first alone is the bug.
+constexpr uint8_t kRiffTag[] = {0x52, 0x49, 0x46, 0x46};   // "RIFF"
+constexpr uint8_t kWebpTag[] = {0x57, 0x45, 0x42, 0x50};   // "WEBP"
+constexpr size_t kWebpTagOffset = 8;
+
+constexpr const base::FilePath::CharType* const kAssetFileNames[] = {
+    FILE_PATH_LITERAL("newtab-background.png"),
+    FILE_PATH_LITERAL("newtab-background.jpg"),
+    FILE_PATH_LITERAL("newtab-background.webp"),
+};
+
+// One answer per profile.
+//
+// This was a single `std::atomic<int>` for the process, which was right while
+// the only place a background could live was beside `chrome.exe` -- a property
+// of the machine, the same for every profile in it. The profile location made
+// it a property of a profile, and a process-wide answer would have told the
+// second profile that a background exists because the first one has one. It
+// would then create a frame for a file that is not there, which is the exact
+// shape of the defect this cache was introduced to avoid.
+//
+// A map and a lock rather than an atomic, because the key arrives at run time.
+// Read on the UI thread and written from a pool thread, and it is small: one
+// entry per profile that has opened a window, never one per tab.
+enum class Probe { kRunning, kAbsent, kPresent };
+
+base::Lock& CacheLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+
+std::map<base::FilePath, Probe>& Cache() {
+  static base::NoDestructor<std::map<base::FilePath, Probe>> cache;
+  return *cache;
+}
+
+void StoreAvailability(base::FilePath profile_path, bool available) {
+  base::AutoLock hold(CacheLock());
+  Cache()[profile_path] = available ? Probe::kPresent : Probe::kAbsent;
+}
+
+bool ProbeAvailability(base::FilePath profile_path) {
+  return !ReadInstalledBackground(profile_path).empty();
+}
+
+bool MatchesAt(base::span<const uint8_t> head,
+               size_t offset,
+               base::span<const uint8_t> tag) {
+  if (head.size() < offset + tag.size()) {
+    return false;
+  }
+  return head.subspan(offset, tag.size()) == tag;
+}
+
+}  // namespace
+
+Format DetectFormat(base::span<const uint8_t> head) {
+  if (MatchesAt(head, 0, kPngSignature)) {
+    return Format::kPng;
+  }
+  if (MatchesAt(head, 0, kJpegSignature)) {
+    return Format::kJpeg;
+  }
+  if (MatchesAt(head, 0, kRiffTag) &&
+      MatchesAt(head, kWebpTagOffset, kWebpTag)) {
+    return Format::kWebp;
+  }
+  return Format::kNone;
+}
+
+base::span<const base::FilePath::CharType* const> AssetFileNames() {
+  return kAssetFileNames;
+}
+
+base::FilePath InstallDirectory() {
+  base::FilePath directory;
+  if (!base::PathService::Get(base::DIR_EXE, &directory)) {
+    return base::FilePath();
+  }
+  return directory;
+}
+
+base::FilePath ProfileDirectory(const base::FilePath& profile_path) {
+  if (profile_path.empty()) {
+    return base::FilePath();
+  }
+  // A subdirectory rather than the profile root. The profile root is
+  // Chromium's, full of files it owns, and a Sunshine asset dropped among them
+  // is a name collision waiting for an upstream release to happen.
+  return profile_path.Append(FILE_PATH_LITERAL("Sunshine"));
+}
+
+void WarmAvailability(const base::FilePath& profile_path) {
+  {
+    base::AutoLock hold(CacheLock());
+    // Claim the probe exactly once **per profile**. A second window on the same
+    // profile does nothing; a window on a different profile probes its own.
+    if (!Cache().emplace(profile_path, Probe::kRunning).second) {
+      return;
+    }
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&ProbeAvailability, profile_path),
+      base::BindOnce(&StoreAvailability, profile_path));
+}
+
+bool AvailableFromCache(const base::FilePath& profile_path) {
+  base::AutoLock hold(CacheLock());
+  const auto found = Cache().find(profile_path);
+  // Absent or still running are both `false`, which is the same answer the
+  // single-atomic version gave and the same race §5 already records: a New Tab
+  // created before the probe returns shows no background, and the next one
+  // shows the truth.
+  return found != Cache().end() && found->second == Probe::kPresent;
+}
+
+// One directory's worth of the search. Split out because the search now runs
+// over two of them and a loop inside a loop reads worse than a named step.
+std::string ReadFromDirectory(const base::FilePath& directory) {
+  if (directory.empty()) {
+    return std::string();
+  }
+  for (const base::FilePath::CharType* const name : kAssetFileNames) {
+    std::string contents;
+    // Refuses an oversized file rather than truncating one: this returns
+    // false when the file is larger than the cap, and `contents` is then a
+    // prefix of an image, which is a worse thing to serve than nothing.
+    if (!base::ReadFileToStringWithMaxSize(directory.Append(name), &contents,
+                                           kMaxAssetBytes)) {
+      continue;
+    }
+    if (contents.size() < kSignatureBytes) {
+      continue;
+    }
+    if (DetectFormat(base::as_byte_span(contents).first(kSignatureBytes)) ==
+        Format::kNone) {
+      continue;
+    }
+    return contents;
+  }
+  return std::string();
+}
+
+std::string ReadInstalledBackground(const base::FilePath& profile_path) {
+  // Profile first. §3's table is the order, and the reason is that the picker
+  // can only write the profile: a per-machine install puts the install
+  // directory under %ProgramFiles%, and asking for administrator rights to set
+  // a wallpaper is answering a decoration request with an elevation prompt.
+  //
+  // A profile that has never chosen one falls through to the install
+  // directory, so replacing the file there still reaches it -- which is the
+  // property §3 rejected the copy-at-first-run design to keep.
+  std::string chosen = ReadFromDirectory(ProfileDirectory(profile_path));
+  if (!chosen.empty()) {
+    return chosen;
+  }
+  return ReadFromDirectory(InstallDirectory());
+}
+
+}  // namespace sunshine::background
