+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SUNSHINE_NEWTAB_BACKGROUND_H_
+#define CHROME_BROWSER_UI_SUNSHINE_NEWTAB_BACKGROUND_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace sunshine::background {
+
+// What a New Tab background may be.
+//
+// PNG, JPEG and WebP, and nothing else.
+//
+// **Neither animated form gets an entry of its own, and that is not an
+// oversight.** An APNG *is* a PNG -- the same eight-byte signature, the same
+// `.png` name, the animation carried in ancillary chunks a decoder either
+// understands or skips -- and an animated WebP *is* a WebP, animation living
+// in the same RIFF container as a still one. A build that accepts the still
+// format accepts the animated one without being told about it. Adding `kApng`
+// or `kAnimatedWebp` here would mean claiming to distinguish two things that
+// are one thing, and would then have to answer what to do when the claim was
+// wrong.
+//
+// The still fallback falls out of the same fact: a decoder that does not know
+// APNG shows its first frame, which is a valid standalone PNG.
+enum class Format {
+  kNone,
+  kPng,
+  kJpeg,
+  kWebp,
+};
+
+// Enough bytes to reach the furthest tag any signature below inspects.
+//
+// Twelve rather than eight because of WebP: its identity is not a prefix. See
+// the comment on `kWebpTag` in the implementation -- the four bytes that say
+// "WebP" sit at offset 8, after a length field, and a check that stopped at
+// eight bytes would be reading the container and calling it the format.
+inline constexpr size_t kSignatureBytes = 12;
+
+// What the file says it is, read from the file's own first bytes.
+//
+// **Never from the name.** A `.png` that begins with `GIF89a` is a GIF, and
+// the owner's rule is that a background may be PNG or JPEG -- a rule about
+// the bytes, not about what someone typed after the dot. Deciding by
+// extension would accept exactly the files this is meant to refuse, and
+// Chromium would then happily decode the GIF because Blink sniffs the same
+// bytes this function does.
+//
+// `head` shorter than a signature is `kNone`, not a guess.
+Format DetectFormat(base::span<const uint8_t> head);
+
+// The names a background may have, beside `chrome.exe`.
+//
+// One per permitted format, because asking the owner to rename a JPEG to
+// `.png` would be asking them to write down something untrue. The extension
+// selects which file is *looked for*; it never decides what the file *is*,
+// which is `DetectFormat`'s job alone.
+base::span<const base::FilePath::CharType* const> AssetFileNames();
+
+// The install directory -- where `chrome.exe` is, not the versioned directory
+// beside it.
+//
+// That distinction is the whole point of the choice. An update replaces the
+// versioned directory wholesale, so a background left there would vanish the
+// first time Sunshine updated itself, silently and with nothing to point at.
+// The install root survives, which is what makes "replace the file" a durable
+// instruction rather than one that works until Tuesday.
+//
+// Empty if the path service cannot answer.
+base::FilePath InstallDirectory();
+
+}  // namespace sunshine::background
+
+#endif  // CHROME_BROWSER_UI_SUNSHINE_NEWTAB_BACKGROUND_H_
