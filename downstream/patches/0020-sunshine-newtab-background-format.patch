+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/sunshine/newtab_background.h"
+
+#include <atomic>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+
+namespace sunshine::background {
+
+namespace {
+
+// The signatures the owner's rule admits, and nothing else.
+//
+// A GIF (`GIF87a`/`GIF89a`) and an AVIF (`....ftypavif`) are absent on
+// purpose, and both are formats Blink would decode perfectly well if they
+// were allowed to reach the decoder. The refusal is a product rule rather
+// than a capability limit, which is exactly why it has to be written down
+// somewhere a reader can find it.
+constexpr uint8_t kPngSignature[] = {0x89, 0x50, 0x4E, 0x47,
+                                     0x0D, 0x0A, 0x1A, 0x0A};
+
+// JPEG has no fixed-length header the way PNG does. Every JPEG begins
+// SOI (`FF D8`) followed by the first marker's `FF`; the byte after that
+// varies by encoder, so three bytes is the whole of what is common.
+constexpr uint8_t kJpegSignature[] = {0xFF, 0xD8, 0xFF};
+
+// **WebP's identity is not a prefix, and treating it as one is a real bug
+// rather than a sloppy one.**
+//
+// `RIFF` is a container tag, not a format: WAV and AVI open with the same
+// four bytes. What says WebP is the `WEBP` tag at offset 8, after the
+// container's 32-bit length field. A check that accepted anything beginning
+// `RIFF` would accept a renamed WAV as a New Tab background -- and would look,
+// in the source, exactly like a signature check.
+//
+// Both tags are required, at both offsets. That is what
+// `scripts/verify_newtab_background.py` holds: declaring `kRiffTag` without
+// `kWebpTag` is refused, because the first alone is the bug.
+constexpr uint8_t kRiffTag[] = {0x52, 0x49, 0x46, 0x46};   // "RIFF"
+constexpr uint8_t kWebpTag[] = {0x57, 0x45, 0x42, 0x50};   // "WEBP"
+constexpr size_t kWebpTagOffset = 8;
+
+constexpr const base::FilePath::CharType* const kAssetFileNames[] = {
+    FILE_PATH_LITERAL("newtab-background.png"),
+    FILE_PATH_LITERAL("newtab-background.jpg"),
+    FILE_PATH_LITERAL("newtab-background.webp"),
+};
+
+// -1 not probed, 0 absent, 1 present. Written once on a pool thread and read
+// on the UI thread, so it is atomic; `relaxed` is enough because nothing else
+// is ordered against it.
+std::atomic<int> g_available{-1};
+
+void StoreAvailability(bool available) {
+  g_available.store(available ? 1 : 0, std::memory_order_relaxed);
+}
+
+bool ProbeAvailability() {
+  return !ReadInstalledBackground().empty();
+}
+
+bool MatchesAt(base::span<const uint8_t> head,
+               size_t offset,
+               base::span<const uint8_t> tag) {
+  if (head.size() < offset + tag.size()) {
+    return false;
+  }
+  return head.subspan(offset, tag.size()) == tag;
+}
+
+}  // namespace
+
+Format DetectFormat(base::span<const uint8_t> head) {
+  if (MatchesAt(head, 0, kPngSignature)) {
+    return Format::kPng;
+  }
+  if (MatchesAt(head, 0, kJpegSignature)) {
+    return Format::kJpeg;
+  }
+  if (MatchesAt(head, 0, kRiffTag) &&
+      MatchesAt(head, kWebpTagOffset, kWebpTag)) {
+    return Format::kWebp;
+  }
+  return Format::kNone;
+}
+
+base::span<const base::FilePath::CharType* const> AssetFileNames() {
+  return kAssetFileNames;
+}
+
+base::FilePath InstallDirectory() {
+  base::FilePath directory;
+  if (!base::PathService::Get(base::DIR_EXE, &directory)) {
+    return base::FilePath();
+  }
+  return directory;
+}
+
+void WarmAvailability() {
+  int expected = -1;
+  // Claim the probe exactly once. A second window opening while the first
+  // probe is in flight must not start another.
+  if (!g_available.compare_exchange_strong(expected, -2,
+                                           std::memory_order_relaxed)) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&ProbeAvailability), base::BindOnce(&StoreAvailability));
+}
+
+bool AvailableFromCache() {
+  return g_available.load(std::memory_order_relaxed) == 1;
+}
+
+std::string ReadInstalledBackground() {
+  const base::FilePath directory = InstallDirectory();
+  if (directory.empty()) {
+    return std::string();
+  }
+
+  for (const base::FilePath::CharType* const name : kAssetFileNames) {
+    std::string contents;
+    // Refuses an oversized file rather than truncating one: this returns
+    // false when the file is larger than the cap, and `contents` is then a
+    // prefix of an image, which is a worse thing to serve than nothing.
+    if (!base::ReadFileToStringWithMaxSize(directory.Append(name), &contents,
+                                           kMaxAssetBytes)) {
+      continue;
+    }
+    if (contents.size() < kSignatureBytes) {
+      continue;
+    }
+    if (DetectFormat(base::as_byte_span(contents).first(kSignatureBytes)) ==
+        Format::kNone) {
+      continue;
+    }
+    return contents;
+  }
+  return std::string();
+}
+
+}  // namespace sunshine::background
