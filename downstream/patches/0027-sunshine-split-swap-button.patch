+void MultiContentsResizeArea::OnSunshineSwapPressed() {
+  // `OnSwap()` CHECKs that a split is open. The button only exists inside the
+  // resize area, and the resize area is only visible in a split -- but the
+  // CHECK is upstream's and a button that can be clicked one frame after the
+  // split closed is not worth arguing with.
+  if (multi_contents_view_->IsInSplitView()) {
+    multi_contents_view_->OnSwap();
+  }
+}
