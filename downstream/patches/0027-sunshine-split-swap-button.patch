+void MultiContentsResizeArea::UpdateSunshineSwapButton() {
+  // Which way the *active* pane would travel, which is what the icon shows and
+  // what `SplitTabMenuModel::GetReversePositionIcon` shows for the same action.
+  // `GetActiveIndex()` is 0 for the start pane -- left when side by side, top
+  // when stacked -- so the active pane always moves away from its own side.
+  const bool active_is_start = multi_contents_view_->GetActiveIndex() == 0;
+  const gfx::VectorIcon* icon = nullptr;
+  if (axis() == Axis::kHorizontal) {
+    icon = active_is_start
+               ? &(features::IsRoundedIconsEnabled() ? kSplitSceneRightIcon
+                                                     : kSplitSceneRightOldIcon)
+               : &(features::IsRoundedIconsEnabled() ? kSplitSceneLeftIcon
+                                                     : kSplitSceneLeftOldIcon);
+  } else {
+    icon = active_is_start
+               ? &(features::IsRoundedIconsEnabled() ? kSplitSceneDownIcon
+                                                     : kSplitSceneDownOldIcon)
+               : &(features::IsRoundedIconsEnabled() ? kSplitSceneUpIcon
+                                                     : kSplitSceneUpOldIcon);
+  }
+  views::SetImageFromVectorIconWithColor(
+      sunshine_swap_button_, *icon, kSunshineSwapIconSize,
+      views::IconColors(kColorSidePanelHoverResizeAreaHandle,
