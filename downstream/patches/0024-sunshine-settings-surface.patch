@@ -0,0 +1,155 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {BackgroundOutcome, SettingsHost} from '../mojom/sunshine_settings.mojom-webui.js';
+import type {BackgroundChoice, SettingsHostRemote} from '../mojom/sunshine_settings.mojom-webui.js';
+
+/**
+ * Sunshine settings.
+ *
+ * The page holds no state of its own beyond what it has just been told. Every
+ * question it can ask is answered by the browser, which is the only party that
+ * has read anything from disk -- so after any action that could have changed
+ * the answer it asks again rather than predicting.
+ *
+ * **The bindings are imported directly rather than through a host.ts.** The
+ * document surface has one because ADR 0013 section 2.5 requires a *module's*
+ * assets to be portable to a second container. This is browser chrome: it will
+ * never run anywhere but this browser, and an indirection whose only purpose
+ * is portability that cannot happen would be a file to keep in agreement for
+ * nothing.
+ *
+ * **`textContent`, never markup.** The sentences below carry numbers that
+ * arrived from the browser over Mojo, and this page runs at a privilege no
+ * website has.
+ */
+
+// Bound on first use rather than at import time.
+let remote: SettingsHostRemote|null = null;
+
+function host(): SettingsHostRemote {
+  if (remote === null) {
+    remote = SettingsHost.getRemote();
+  }
+  return remote;
+}
+
+function required(id: string): HTMLElement {
+  const found = document.querySelector<HTMLElement>(`#${id}`);
+  if (!found) {
+    throw new Error(`missing element: ${id}`);
+  }
+  return found;
+}
+
+/**
+ * A byte count as a person would say it.
+ *
+ * Whole megabytes, because the two numbers this ever formats are a file the
+ * person chose and a cap set to a round 100 MB, and "112 MB" answers the
+ * question that "117,440,512 bytes" does not. Rounded up, so a file over the
+ * limit never reads as being exactly at it.
+ *
+ * `Number` rather than BigInt arithmetic: mojom's int64 arrives as a bigint,
+ * and every value this formats is bounded by that cap, which a double holds
+ * exactly many times over.
+ */
+function megabytes(bytes: bigint): string {
+  return `${Math.ceil(Number(bytes) / (1024 * 1024))} MB`;
+}
+
+function refusal(choice: BackgroundChoice): string {
+  switch (choice.outcome) {
+    case BackgroundOutcome.kTooLarge:
+      // Both numbers were measured by the browser. NTB-11 asks for the reason,
+      // and for this refusal the reason is arithmetic.
+      return `That file is ${megabytes(choice.size)} and the limit is ` +
+          `${megabytes(choice.limit)}. Nothing was changed.`;
+    case BackgroundOutcome.kUnsupportedFormat:
+      // Deliberately does not name what the file turned out to be. Saying
+      // "that is a GIF" would mean this build declaring a GIF signature, and
+      // NTB-2 forbids declaring any excluded format's signature -- a table of
+      // refused formats is one edit away from being a table of accepted ones.
+      // So the sentence says what is allowed and that this is not it.
+      return 'A background has to be a PNG, JPEG or WebP, and the contents ' +
+          'of that file are none of those. Its name was not what decided ' +
+          'that. Nothing was changed.';
+    case BackgroundOutcome.kUnreadable:
+      return 'That file could not be read. Nothing was changed.';
+    case BackgroundOutcome.kWriteFailed:
+      return 'The file was fine, but it could not be copied into this ' +
+          'profile. Nothing was changed.';
+    case BackgroundOutcome.kPickerBusy:
+      return 'A file dialog is already open.';
+    default:
+      return '';
+  }
+}
+
+function showOutcome(text: string, refused: boolean): void {
+  const outcome = required('outcome');
+  outcome.textContent = text;
+  outcome.hidden = text === '';
+  if (refused) {
+    outcome.dataset['refused'] = '';
+  } else {
+    delete outcome.dataset['refused'];
+  }
+}
+
+function showState(profileBackground: boolean): void {
+  required('state').textContent = profileBackground ?
+      'This profile has its own background.' :
+      'This profile has no background of its own. It shows whichever image ' +
+          'is installed alongside Sunshine, if there is one.';
+  required('remove').hidden = !profileBackground;
+}
+
+function refresh(): void {
+  void host().getBackgroundState().then(
+      (response) => showState(response.profileBackground));
+}
+
+function onChoice(choice: BackgroundChoice): void {
+  if (choice.outcome === BackgroundOutcome.kInstalled) {
+    showOutcome('Done. New tabs will show it.', false);
+  } else if (choice.outcome !== BackgroundOutcome.kCancelled) {
+    // Cancelling is not a failure and says nothing. Closing a file dialog
+    // without choosing is the most ordinary thing a person does with one.
+    showOutcome(refusal(choice), true);
+  }
+  refresh();
+}
+
+function attach(): void {
+  const choose = required('choose') as HTMLButtonElement;
+  const remove = required('remove') as HTMLButtonElement;
+
+  choose.addEventListener('click', () => {
+    // Disabled for the whole round trip, which includes the time a person
+    // spends in the file dialog. The browser refuses a second dialog anyway
+    // and says so; this is so that the ordinary case never has to produce that
+    // sentence.
+    choose.disabled = true;
+    showOutcome('', false);
+    void host().chooseBackground().then((response) => {
+      choose.disabled = false;
+      onChoice(response.choice);
+    });
+  });
+
+  remove.addEventListener('click', () => {
+    remove.disabled = true;
+    showOutcome('', false);
+    void host().removeBackground().then(() => {
+      remove.disabled = false;
+      refresh();
+    });
+  });
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  attach();
+  refresh();
+});
