@@ -0,0 +1,99 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_SETTINGS_SUNSHINE_SETTINGS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_SETTINGS_SUNSHINE_SETTINGS_HANDLER_H_
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/sunshine/newtab_background.h"
+#include "chrome/browser/ui/webui/sunshine/settings/sunshine_settings.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+
+namespace content {
+class WebContents;
+}
+
+// The browser half of the settings surface's one host interface.
+//
+// **This class is where the New Tab background stops being read-only.** Until
+// it existed, the only way to put a background in front of a person was to
+// place a file beside `chrome.exe` by hand, and the only thing the browser
+// could say about a file it refused was nothing at all --
+// `docs/NEWTAB_BACKGROUND_CONTRACT.md` §5 records that a rejected asset and an
+// absent one are indistinguishable on screen. This handler holds the bytes,
+// the rule and the person at the same moment, which is the whole reason NTB-11
+// asks for a reason to be shown.
+//
+// **The page never sees a path and never sends one.** `ChooseBackground()`
+// takes no argument: the dialog is opened here, the chosen file is measured,
+// read and copied here, and what crosses back is an outcome and two byte
+// counts. A privileged page that could name a file would be a page that could
+// ask the browser to copy anything on the disk into the profile.
+//
+// **`ui::SelectFileDialog::Listener` lifetime.** The dialog holds a raw
+// pointer to its listener and may call back after `SelectFile()` returns, so
+// the destructor tells any live dialog that its listener is gone. Upstream's
+// `CustomizeChromePageHandler` does exactly this, and the comment on
+// `ui::SelectFileDialog::Create()` is explicit that the listener must outlive
+// the dialog.
+class SunshineSettingsHandler
+    : public sunshine::settings::mojom::SettingsHost,
+      public ui::SelectFileDialog::Listener {
+ public:
+  SunshineSettingsHandler(content::WebContents* web_contents,
+                          const base::FilePath& profile_path);
+
+  SunshineSettingsHandler(const SunshineSettingsHandler&) = delete;
+  SunshineSettingsHandler& operator=(const SunshineSettingsHandler&) = delete;
+
+  ~SunshineSettingsHandler() override;
+
+  // Binds the page's end of the interface. The receiver is reset first, for
+  // the same reason the document surface's is: content/browser/webui/
+  // web_ui_impl.h says SetUpMojoInterfaceBroker() "may be called multiple
+  // times if the WebUI is reused", and a second bind of a live receiver
+  // CHECK-fails.
+  void Bind(
+      mojo::PendingReceiver<sunshine::settings::mojom::SettingsHost> receiver);
+
+  // sunshine::settings::mojom::SettingsHost:
+  void GetBackgroundState(GetBackgroundStateCallback callback) override;
+  void ChooseBackground(ChooseBackgroundCallback callback) override;
+  void RemoveBackground(RemoveBackgroundCallback callback) override;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+ private:
+  // Called on the UI thread with the result of the blocking install.
+  void OnInstalled(sunshine::background::InstallOutcome outcome);
+
+  // Answers the pending ChooseBackground() request, if there is one, and
+  // forgets the dialog. Every path out of a pick goes through here so that a
+  // caller can never be left waiting on a promise nothing will resolve.
+  void FinishChoice(sunshine::settings::mojom::BackgroundOutcome outcome,
+                    int64_t size);
+
+  // The window the dialog is modal to, and the policy that can refuse to show
+  // one at all. Owned by the WebUI, which outlives this handler.
+  raw_ptr<content::WebContents> web_contents_;
+
+  // Composed once, here, from the profile's own directory. No method of the
+  // page's interface can carry one.
+  const base::FilePath profile_path_;
+
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  ChooseBackgroundCallback choose_callback_;
+
+  mojo::Receiver<sunshine::settings::mojom::SettingsHost> receiver_{this};
+
+  base::WeakPtrFactory<SunshineSettingsHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_SETTINGS_SUNSHINE_SETTINGS_HANDLER_H_
