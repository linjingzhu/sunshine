@@ -0,0 +1,53 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/settings/sunshine_settings_ui.h"
+
+#include <memory>
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/sunshine/settings/sunshine_settings_handler.h"
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+SunshineSettingsUI::SunshineSettingsUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+
+  // The profile path is composed once, here. Nothing the page can send carries
+  // a location, so this is the only way the handler learns where it may write.
+  handler_ = std::make_unique<SunshineSettingsHandler>(web_ui->GetWebContents(),
+                                                       profile->GetPath());
+
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUISunshineSettingsHost);
+
+  // The "settings/" part of Sunshine's one resource bundle, plus this
+  // surface's own generated Mojo bindings by name.
+  //
+  // The second argument is why it is by name. Bindings do not land in the
+  // surface directory that owns them: build_webui() copies every mojo file
+  // into one `mojo_base_path` directory by basename, so a prefix filter alone
+  // would either serve a page nothing or serve every page every surface's
+  // bindings. Naming one file serves exactly the interface this page is also
+  // granted in sunshine_webui_registry.h, and no other.
+  webui::SetupWebUIDataSource(
+      source,
+      sunshine::SurfaceResources("settings",
+                                 "mojom/sunshine_settings.mojom-webui.js"),
+      IDR_SUNSHINE_SETTINGS_APP_HTML);
+}
+
+SunshineSettingsUI::~SunshineSettingsUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SunshineSettingsUI)
+
+void SunshineSettingsUI::BindInterface(
+    mojo::PendingReceiver<sunshine::settings::mojom::SettingsHost> receiver) {
+  handler_->Bind(std::move(receiver));
+}
