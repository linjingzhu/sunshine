+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Sunshine Settings</title>
+  <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+  <link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <!-- Written out rather than built by app.ts, for the same reason the account
+       surface's is: everything on this page except the two lines that describe
+       the current state is the product of a decision and is identical in every
+       build. A page assembled at run time is a page whose text a reviewer has
+       to reconstruct. -->
+  <main id="page">
+    <h1>Sunshine settings</h1>
+
+    <section class="panel">
+      <h2>New tab background</h2>
+
+      <p>A PNG, JPEG or WebP shown behind the new tab page. Animated PNG and
+         animated WebP play; nothing else is accepted.</p>
+
+      <!-- The one sentence that changes, and the one that reports a refusal.
+           Both are filled by app.ts with textContent and never with markup:
+           #outcome carries numbers that came from the browser, and this is a
+           privileged page. -->
+      <p id="state" class="state"></p>
+
+      <div class="actions">
+        <button id="choose" type="button">Choose a file&hellip;</button>
+        <button id="remove" type="button" hidden>Remove</button>
+      </div>
+
+      <p id="outcome" class="outcome" role="status" hidden></p>
+
+      <p class="note">The file is copied into this profile, exactly as it is.
+         It is not re-encoded, so an animation stays an animation. Removing it
+         brings back whatever image is installed alongside Sunshine itself, if
+         there is one.</p>
+    </section>
+  </main>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
