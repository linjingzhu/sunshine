diff --git a/chrome/browser/ui/webui/sunshine/settings/sunshine_settings.mojom b/chrome/browser/ui/webui/sunshine/settings/sunshine_settings.mojom
new file mode 100644
index 0000000..5f7678b
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/settings/sunshine_settings.mojom
@@ -0,0 +1,79 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Sunshine settings surface's one interface to the browser.
+//
+// **Why this surface exists at all, and why the New Tab does not own it.**
+// `docs/NEWTAB_BACKGROUND_CONTRACT.md` §3d put a choice to the owner: the New
+// Tab's background button could call a Mojo method on upstream's own New Tab
+// handler, which would take ownership of `new_tab_page.mojom` and
+// `new_tab_page_handler.h/.cc` -- three upstream files, on the page this stack
+// already patches most heavily and re-applies at every roll -- or it could
+// navigate to a Sunshine surface that owns the method instead. The owner chose
+// the second on 2026-08-27. This file is where that method landed, and the
+// three upstream files stay unowned.
+//
+// **Nothing here names a location.** No method takes or returns a path, a file
+// name, or a directory. The page asks for a picker to be opened; the browser
+// opens it, and the browser alone ever sees what was chosen. That is not
+// politeness -- a privileged page that could hand the browser a path would be
+// a privileged page that could ask it to copy anything on the disk into the
+// profile, and the file dialog is precisely the thing that makes the choice a
+// person's rather than the page's.
+
+module sunshine.settings.mojom;
+
+// What happened to the file a person chose.
+//
+// `kCancelled` is not a failure and must not be reported as one: closing a
+// file dialog without choosing is the most ordinary thing a person does with
+// it.
+enum BackgroundOutcome {
+  kInstalled,
+  kCancelled,
+  // A dialog is already open. Upstream's own picker answers the same way
+  // rather than opening a second one.
+  kPickerBusy,
+  kUnreadable,
+  kTooLarge,
+  kUnsupportedFormat,
+  kWriteFailed,
+};
+
+// The outcome, with the two numbers a refusal needs to be specific.
+//
+// **Both are measured by the browser, and neither is composed into a
+// sentence here.** The browser is the only party that read the file, so it is
+// the only one that can say how large it was; the page is what a person reads,
+// so it is where the wording lives. Sending a finished sentence would put
+// product copy in a Mojo response, and sending only an enum would leave the
+// page inventing a number it never measured.
+struct BackgroundChoice {
+  BackgroundOutcome outcome;
+  // The chosen file's size in bytes, or -1 when it could not be measured.
+  int64 size;
+  // The largest file this build will accept, in bytes. Constant for the life
+  // of the process; carried here so that the refusal and the limit it cites
+  // come from the same place at the same moment.
+  int64 limit;
+};
+
+// What the settings surface may ask of the browser, and the whole of it.
+interface SettingsHost {
+  // Whether this profile has a background of its own, as opposed to seeing
+  // the one in the install directory. This is the narrower question, and it is
+  // the one the surface needs: "Remove" can only act on the profile's own.
+  GetBackgroundState() => (bool profile_background);
+
+  // Open the OS file picker and, if the chosen file passes, install it.
+  //
+  // The whole operation is one request. An interface that opened the dialog
+  // and reported the choice separately would let the page decide what to do
+  // with the answer, and the answer is a path.
+  ChooseBackground() => (BackgroundChoice choice);
+
+  // Give up this profile's own background. The install directory's, if there
+  // is one, becomes visible again.
+  RemoveBackground() => (bool removed);
+};
diff --git a/chrome/browser/ui/webui/sunshine/settings/sunshine_settings_handler.cc b/chrome/browser/ui/webui/sunshine/settings/sunshine_settings_handler.cc
new file mode 100644
index 0000000..a0ae491
--- /dev/null
+++ b/chrome/browser/ui/webui/sunshine/settings/sunshine_settings_handler.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/settings/sunshine_settings_handler.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace {
+
+using sunshine::settings::mojom::BackgroundChoice;
+using sunshine::settings::mojom::BackgroundOutcome;
+
+// One outcome per refusal the browser can distinguish, and no collapsing.
+//
+// The temptation is to map everything that is not `kInstalled` to one "that
+// did not work" and let the page say so once. NTB-11 is the reason not to:
+// the sentence a person needs is *why*, and the browser is the only party
+// that knows.
+BackgroundOutcome Translate(sunshine::background::InstallResult result) {
+  switch (result) {
+    case sunshine::background::InstallResult::kInstalled:
+      return BackgroundOutcome::kInstalled;
+    case sunshine::background::InstallResult::kUnreadable:
+      return BackgroundOutcome::kUnreadable;
+    case sunshine::background::InstallResult::kTooLarge:
+      return BackgroundOutcome::kTooLarge;
+    case sunshine::background::InstallResult::kUnsupportedFormat:
+      return BackgroundOutcome::kUnsupportedFormat;
+    case sunshine::background::InstallResult::kWriteFailed:
+      return BackgroundOutcome::kWriteFailed;
+  }
+}
+
+}  // namespace
+
+SunshineSettingsHandler::SunshineSettingsHandler(
+    content::WebContents* web_contents,
+    const base::FilePath& profile_path)
+    : web_contents_(web_contents), profile_path_(profile_path) {}
+
+SunshineSettingsHandler::~SunshineSettingsHandler() {
+  // The dialog holds a raw pointer to this object and may still call back.
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
+
+void SunshineSettingsHandler::Bind(
+    mojo::PendingReceiver<sunshine::settings::mojom::SettingsHost> receiver) {
+  receiver_.reset();
+  receiver_.Bind(std::move(receiver));
+}
+
+void SunshineSettingsHandler::GetBackgroundState(
+    GetBackgroundStateCallback callback) {
+  // Off the UI thread: this reads the profile's directory, and the thread that
+  // draws does not open files. PB-4.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&sunshine::background::HasProfileBackground,
+                     profile_path_),
+      std::move(callback));
+}
+
+void SunshineSettingsHandler::ChooseBackground(
+    ChooseBackgroundCallback callback) {
+  if (select_file_dialog_ || !choose_callback_.is_null()) {
+    // A dialog is already up. Answering rather than opening a second one is
+    // what upstream's own picker does, and the page needs the answer: a
+    // request that never resolved would leave its button disabled forever.
+    std::move(callback).Run(BackgroundChoice::New(
+        BackgroundOutcome::kPickerBusy, -1,
+        static_cast<int64_t>(sunshine::background::kMaxAssetBytes)));
+    return;
+  }
+
+  choose_callback_ = std::move(callback);
+
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents_));
+
+  // The extensions the dialog offers, which are a convenience and never the
+  // decision. NTB-2: what a file *is* comes from its first bytes, checked
+  // after the dialog closes and before anything is written. A person who types
+  // a name the filter does not list still gets their file examined; they just
+  // get told what it turned out to be.
+  ui::SelectFileDialog::FileTypeInfo file_types;
+  file_types.allowed_paths = ui::SelectFileDialog::FileTypeInfo::NATIVE_PATH;
+  file_types.extensions.resize(1);
+  for (const base::FilePath::CharType* const extension :
+       sunshine::background::AssetExtensions()) {
+    file_types.extensions[0].push_back(extension);
+  }
+  // **All files, as well.** The filter is a convenience and the extension is
+  // never the decision -- a JPEG named `.jpeg`, or named nothing at all, is
+  // still a JPEG, and a filter that hid it would be the extension deciding
+  // what a file is by deciding whether it can be chosen. NTB-2 in the one
+  // place it could still have got in.
+  file_types.include_all_files = true;
+
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+      base::FilePath(), &file_types, 0, base::FilePath::StringType(),
+      web_contents_->GetTopLevelNativeWindow(), nullptr);
+}
+
+void SunshineSettingsHandler::RemoveBackground(
+    RemoveBackgroundCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&sunshine::background::RemoveBackground, profile_path_),
+      std::move(callback));
+}
+
+void SunshineSettingsHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                           int index) {
+  select_file_dialog_ = nullptr;
+  if (choose_callback_.is_null()) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+      base::BindOnce(&sunshine::background::InstallBackground, file.path(),
+                     profile_path_),
+      base::BindOnce(&SunshineSettingsHandler::OnInstalled,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SunshineSettingsHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  // Not a failure. Closing a file dialog without choosing is the most ordinary
+  // thing a person does with one, and the page says nothing about it.
+  FinishChoice(BackgroundOutcome::kCancelled, -1);
+}
+
+void SunshineSettingsHandler::OnInstalled(
+    sunshine::background::InstallOutcome outcome) {
+  FinishChoice(Translate(outcome.result), outcome.size);
+}
+
+void SunshineSettingsHandler::FinishChoice(BackgroundOutcome outcome,
+                                           int64_t size) {
+  if (choose_callback_.is_null()) {
+    return;
+  }
+  std::move(choose_callback_)
+      .Run(BackgroundChoice::New(
+          outcome, size,
+          static_cast<int64_t>(sunshine::background::kMaxAssetBytes)));
+}
