+/* Copyright 2026 The Sunshine OS contributors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+body {
+  background: var(--color-dialog-background);
+  color: var(--color-primary-foreground);
+  margin: 0;
+}
+
+#page {
+  margin: 0 auto;
+  max-width: 720px;
+  padding: 32px 24px 48px;
+}
+
+h1 {
+  font-size: 1.5rem;
+  font-weight: 500;
+  margin: 0 0 16px;
+}
+
+h2 {
+  font-size: 0.875rem;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+  margin: 0 0 8px;
+  text-transform: uppercase;
+}
+
+.panel {
+  border-top: 1px solid var(--color-midground);
+  margin: 0;
+  padding: 24px 0 0;
+}
+
+p {
+  margin: 0 0 8px;
+}
+
+.state {
+  border-inline-start: 3px solid var(--color-secondary-foreground);
+  margin: 16px 0;
+  padding-inline-start: 12px;
+}
+
+.actions {
+  display: flex;
+  gap: 8px;
+  margin: 16px 0 0;
+}
+
+button {
+  background: var(--color-midground);
+  border: 0;
+  border-radius: 4px;
+  color: var(--color-primary-foreground);
+  cursor: pointer;
+  font: inherit;
+  padding: 8px 16px;
+}
+
+button:disabled {
+  cursor: default;
+  opacity: 0.5;
+}
+
+.outcome {
+  margin: 16px 0 0;
+}
+
+/* A refusal is a fact about a file, not an alarm. It is marked so that it can
+   be found and so that a reader can tell it apart from the state line above,
+   and it is not coloured red: nothing went wrong with the browser. */
+.outcome[data-refused] {
+  border-inline-start: 3px solid var(--color-secondary-foreground);
+  padding-inline-start: 12px;
+}
+
+.note {
+  color: var(--color-secondary-foreground);
+  margin: 24px 0 0;
+}
