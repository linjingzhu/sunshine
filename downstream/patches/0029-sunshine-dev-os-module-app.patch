@@ -40,6 +40,16 @@ inline constexpr char kChromeUISunshineAccountURL[] =
 // section 1 is why they are two, and `chrome-untrusted` is Chromium's own
 // scheme -- content/public/common/url_constants.h declares
 // kChromeUIUntrustedScheme -- so ADR 0003 and SEC-13 are untouched.
+// The first mountable module app. It is a chrome-untrusted:// host for the
+// same reason the document frame is: module content is authored elsewhere, and
+// docs/MODULE_MOUNT_CONTRACT.md section 1 turns on the module renderer never
+// holding browser privilege. It is absent from kSunshineWebUIHosts below --
+// nothing navigates here by name, and a module app that could be opened as a
+// top-level page would be a page with no shell to answer its describe.
+inline constexpr char kChromeUISunshineDevOsAppHost[] = "sunshine-dev-os-app";
+inline constexpr char kChromeUISunshineDevOsAppURL[] =
+    "chrome-untrusted://sunshine-dev-os-app/";
+
 inline constexpr char kChromeUISunshineDocumentHost[] = "sunshine-document";
 inline constexpr char kChromeUISunshineDocumentURL[] =
