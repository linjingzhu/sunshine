+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_DEV_OS_APP_SUNSHINE_DEV_OS_APP_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_DEV_OS_APP_SUNSHINE_DEV_OS_APP_UI_H_
+
+#include "chrome/common/sunshine/sunshine_webui_hosts.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+namespace content {
+class WebUI;
+}
+
+class SunshineDevOsAppUI;
+
+// The first mounted module app, at chrome-untrusted://sunshine-dev-os-app.
+//
+// **What this is for.** docs/MODULE_MOUNT_CONTRACT.md section 9 said, until
+// this file existed, that "the socket is built; nothing is plugged into it" --
+// every message in sections 3 and 4 was unexchanged and RV-35 and RV-36 could
+// not be run at all, because no module declared a mount that resolved to
+// anything. first_party/modules/sunshine-dev-os/module.json declared the URL;
+// nothing served it, so mounting it would have shown an empty frame. This is
+// the other half of that declaration.
+//
+// It is deliberately the *smallest* app that exercises the port rather than a
+// port of Dev OS: it speaks mount, describe, activate, select and action, and
+// it draws no data, because docs/DEV_OS_PORT_PLAN.md is a separate piece of
+// work and a surface that drew placeholder numbers would be the thing that
+// document forbids -- "what it could not read is reported as unread rather
+// than drawn as zero".
+//
+// Everything structural is copied from SunshineDocumentContentUIConfig, which
+// is the proven untrusted surface in this tree: a plain WebUIController rather
+// than a ui::MojoWebUIController, no BindInterface overload, no
+// WEB_UI_CONTROLLER_TYPE_DECL, and absent from RegisterWebUIInterfaceBrokers()
+// -- four independent absences, any one of which is enough to keep this
+// renderer without a Mojo pipe. A module app reaches the browser through the
+// mount port and through nothing else.
+class SunshineDevOsAppUIConfig
+    : public content::DefaultWebUIConfig<SunshineDevOsAppUI> {
+ public:
+  SunshineDevOsAppUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIUntrustedScheme,
+                           chrome::kChromeUISunshineDevOsAppHost) {}
+};
+
+class SunshineDevOsAppUI : public content::WebUIController {
+ public:
+  explicit SunshineDevOsAppUI(content::WebUI* web_ui);
+  SunshineDevOsAppUI(const SunshineDevOsAppUI&) = delete;
+  SunshineDevOsAppUI& operator=(const SunshineDevOsAppUI&) = delete;
+  ~SunshineDevOsAppUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_DEV_OS_APP_SUNSHINE_DEV_OS_APP_UI_H_
