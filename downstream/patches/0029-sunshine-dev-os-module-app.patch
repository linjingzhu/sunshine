+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/sunshine/dev_os_app/sunshine_dev_os_app_ui.h"
+
+#include "chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h"
+#include "chrome/grit/sunshine_resources.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+SunshineDevOsAppUI::SunshineDevOsAppUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // Named by the whole URL rather than a bare host, which is what
+  // content/public/browser/web_ui_data_source.h requires for a
+  // chrome-untrusted:// source.
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(),
+      chrome::kChromeUISunshineDevOsAppURL);
+
+  webui::SetupWebUIDataSource(source, sunshine::SurfaceResources("dev_os_app"),
+                              IDR_SUNSHINE_DEV_OS_APP_APP_HTML);
+
+  // Embeddable by the module shell and by nothing else. Without this the
+  // default "frame-ancestors 'none';" refuses the iframe outright, which is
+  // the failure patch 0015 already found once from the other side -- the shell
+  // named no framable origin and its child-src would have blocked every mount.
+  source->AddFrameAncestor(GURL(chrome::kChromeUISunshineShellURL));
+
+  // The module.json this app belongs to declares network "deny" and filesystem
+  // "none". These directives are that declaration made true rather than
+  // described: "default-src 'self';" already implies each one, but a directive
+  // that is only implied is a directive the next edit can lose silently.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc, "connect-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc, "img-src 'self' data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::MediaSrc, "media-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FontSrc, "font-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ObjectSrc, "object-src 'none';");
+  // A module app embeds nothing of its own. Region E is the shell's, and a
+  // module that framed a second document would be a module deciding what E is.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ChildSrc, "child-src 'none';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FormAction, "form-action 'none';");
+}
+
+SunshineDevOsAppUI::~SunshineDevOsAppUI() = default;
