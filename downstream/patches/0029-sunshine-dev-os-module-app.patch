@@ -113,6 +114,14 @@ inline void RegisterWebUIConfigs(content::WebUIConfigMap& map) {
   map.AddUntrustedWebUIConfig(
       std::make_unique<SunshineDocumentContentUIConfig>());
 
+  // The first module app. Registered here rather than discovered from the
+  // module registry, because a module's content URL is compiled into the
+  // binary either way and a registration derived from a manifest would be a
+  // second place a host can come from -- docs/MODULE_MOUNT_CONTRACT.md section
+  // 1: "the one URL in the whole arrangement comes from the registry compiled
+  // into the binary".
+  map.AddUntrustedWebUIConfig(std::make_unique<SunshineDevOsAppUIConfig>());
+
   RegisterWebUIInterfaceBrokers();
 }
 
