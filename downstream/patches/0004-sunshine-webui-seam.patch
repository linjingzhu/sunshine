diff --git a/chrome/browser/resources/sunshine/BUILD.gn b/chrome/browser/resources/sunshine/BUILD.gn
new file mode 100644
index 0000000..c04adb0
--- /dev/null
+++ b/chrome/browser/resources/sunshine/BUILD.gn
@@ -0,0 +1,47 @@
+# Copyright 2026 The Sunshine OS contributors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Sunshine's one resource bundle. Every Sunshine WebUI surface's web assets are
+# built here, into a single grd, which is what lets
+# tools/gritsettings/resource_ids.spec and chrome/chrome_paks.gni carry one
+# Sunshine entry however many surfaces exist. See
+# docs/decisions/0007-module-contribution-seam.md, which measured the
+# alternative: a per-surface grd needs a new id range and a new pak line per
+# surface, in the two files of the seven that churn most upstream.
+#
+# A surface owns the subdirectory named after it and appends its files to the
+# lists below. That is the whole of a surface's claim on this half of the seam;
+# no upstream file is touched. build_webui() derives each resource's name from
+# grd_prefix and the file's path here, uppercased with the separators replaced
+# -- ui/webui/resources/tools/generate_grd.py, _generate_include_row -- so
+# "security/app.html" is IDR_SUNSHINE_SECURITY_APP_HTML and its resource path
+# is "security/app.html".
+#
+# A surface does not serve the bundle whole. Every surface's assets are in one
+# resource map, and a privileged page has no business serving another page's
+# files, so chrome/browser/ui/webui/sunshine/sunshine_webui_resources.h hands
+# each surface only the entries under its own directory, with that directory
+# prefix removed.
+#
+# webui_context_type is "relative" so that one bundle can hold both chrome://
+# and chrome-untrusted:// surfaces. tools/typescript/path_mappings.py adds the
+# scheme-relative "//resources/..." mapping for every context type and a
+# scheme-qualified one only for "trusted" and "untrusted"; choosing either of
+# those would bind every surface in this bundle to that one scheme. Sunshine
+# surfaces therefore import shared WebUI resources as "//resources/...".
+
+import("//ui/webui/resources/tools/build_webui.gni")
+
+build_webui("build") {
+  grd_prefix = "sunshine"
+
+  # Extended by each surface patch.
+  static_files = [
+  ]
+  ts_files = [
+  ]
+
+  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
+  webui_context_type = "relative"
+}
