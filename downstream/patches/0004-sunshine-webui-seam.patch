-  return base::span(kChromeURLHosts);
+  // Sunshine's own hosts are appended once here rather than by editing
+  // this array per surface; see
+  // chrome/common/sunshine/sunshine_webui_hosts.h and
+  // docs/decisions/0007-module-contribution-seam.md.
+  static const base::NoDestructor<std::vector<base::cstring_view>> kAllHosts(
+      [] {
+        std::vector<base::cstring_view> hosts(kChromeURLHosts.begin(),
+                                               kChromeURLHosts.end());
+        hosts.insert(hosts.end(), kSunshineWebUIHosts.begin(),
+                     kSunshineWebUIHosts.end());
+        return hosts;
+      }());
+  return base::span(*kAllHosts);
 }
 
