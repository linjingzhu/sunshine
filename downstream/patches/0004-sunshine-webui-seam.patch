@@ -0,0 +1,35 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SUNSHINE_SUNSHINE_WEBUI_RESOURCES_H_
+#define CHROME_BROWSER_UI_WEBUI_SUNSHINE_SUNSHINE_WEBUI_RESOURCES_H_
+
+#include <string_view>
+#include <vector>
+
+#include "ui/base/webui/resource_path.h"
+
+namespace sunshine {
+
+// The part of Sunshine's one resource bundle that belongs to |surface|, with
+// the "<surface>/" directory prefix removed.
+//
+// Every Sunshine surface is built into a single grd -- see
+// chrome/browser/resources/sunshine/BUILD.gn and
+// docs/decisions/0007-module-contribution-seam.md -- so the generated map holds
+// every surface's files under paths like "security/app.html", and passing it
+// whole to webui::SetupWebUIDataSource() would let each surface serve every
+// other surface's assets. Filtering by prefix keeps a privileged page's data
+// source to the files that page owns, and dropping the prefix keeps its URLs
+// the same as they would be if it had a grd to itself.
+//
+// webui::ResourcePath holds `const char* const path`
+// (ui/base/webui/resource_path.h), so the shortened path is a pointer into the
+// same string literal the generated map already holds: nothing is copied, and
+// the returned entries stay valid for the life of the process.
+std::vector<webui::ResourcePath> SurfaceResources(std::string_view surface);
+
+}  // namespace sunshine
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SUNSHINE_SUNSHINE_WEBUI_RESOURCES_H_
