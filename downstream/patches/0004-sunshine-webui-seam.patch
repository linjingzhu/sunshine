diff --git a/chrome/common/sunshine/sunshine_webui_hosts.h b/chrome/common/sunshine/sunshine_webui_hosts.h
new file mode 100644
index 0000000..c2ba0df
--- /dev/null
+++ b/chrome/common/sunshine/sunshine_webui_hosts.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The Sunshine OS contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Sunshine's own chrome:// WebUI hosts. docs/decisions/0007-module-contribution-seam.md
+// records why these live here instead of directly in
+// chrome/common/webui_url_constants.h: a second surface's host constant
+// collided with the first's on all seven upstream files a naive WebUI
+// contribution point touches. Each Sunshine surface's own patch appends its
+// host constant(s) below and adds them to kSunshineWebUIHosts, so
+// chrome/common/webui_url_constants.h and .cc are touched exactly once, by
+// the seam patch that created this file.
+
+#ifndef CHROME_COMMON_SUNSHINE_SUNSHINE_WEBUI_HOSTS_H_
+#define CHROME_COMMON_SUNSHINE_SUNSHINE_WEBUI_HOSTS_H_
+
+#include <array>
+
+#include "base/strings/cstring_view.h"
+
+namespace chrome {
+
+// Every Sunshine WebUI host, offered to the omnibox's built-in provider
+// through the loop in ChromeURLHosts(). Empty until the first surface patch
+// appends to it.
+inline constexpr auto kSunshineWebUIHosts = std::to_array<base::cstring_view>({
+});
+
+}  // namespace chrome
+
+#endif  // CHROME_COMMON_SUNSHINE_SUNSHINE_WEBUI_HOSTS_H_
