+  // Sunshine's own New Tab background, from the install directory.
+  //
+  // Deliberately not routed through the profile path above. That one is the
+  // *user's* uploaded background, keyed per profile and validated against
+  // directory traversal because its name comes from a preference. This one
+  // takes no name from anywhere: `ReadInstalledBackground` looks only beside
+  // `chrome.exe`, only for names it holds itself, and returns nothing unless
+  // the file's own first bytes say it is a format
+  // `docs/NEWTAB_BACKGROUND_CONTRACT.md` permits. There is no path to
+  // traverse because there is no path from the request.
+  //
+  // Empty bytes are the normal answer: no file installed means no background,
+  // which is what makes the feature opt-in under PB-5a.
+  if (path == "sunshine-background.png") {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::TaskPriority::USER_VISIBLE, base::MayBlock()},
+        base::BindOnce(&sunshine::background::ReadInstalledBackground),
+        base::BindOnce(&ServeBackgroundImageData, std::move(callback)));
+    return;
+  }
   std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>());
 }
 
