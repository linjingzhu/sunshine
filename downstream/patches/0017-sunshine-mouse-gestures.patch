+bool Browser::HandleContextMenu(content::RenderFrameHost& render_frame_host,
+                                const content::ContextMenuParams& params) {
+  // The gesture's one dispatch point, and the only place in this feature that
+  // knows a Chromium command identifier. Recognition resolved a registered
+  // command name; mapping that name to an IDC and asking the command layer
+  // whether it is available is the browser's job, not the recogniser's --
+  // GESTURE contract invariants 5 and 7.
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(&render_frame_host);
+  sunshine::MouseGesture* gesture =
+      contents ? sunshine::MouseGesture::FromWebContents(contents) : nullptr;
+  if (!gesture) {
+    return false;
+  }
+  const sunshine::MouseGesture::Decision decision =
+      gesture->DecideContextMenu(params);
+  if (!decision.command.empty()) {
+    const int command = decision.command == sunshine::kBackCommand
+                            ? IDC_BACK
+                            : IDC_FORWARD;
+    // An unavailable command performs no action and raises no dialog. Asking
+    // first is also what keeps this off the DCHECK inside the command
+    // controller at the first entry of session history.
+    if (chrome::IsCommandEnabled(this, command)) {
+      chrome::ExecuteCommand(this, command);
+    }
+  }
+  return decision.suppress_menu;
+}
