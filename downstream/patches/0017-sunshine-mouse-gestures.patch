+# Copyright 2026 The Sunshine Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Deliberately depends on no part of //chrome/browser/ui. Recognition and
+# binding are two of the three stages the GESTURE contract separates, and the
+# third -- dispatch -- stays in Browser, where the command layer already is. A
+# target that could see Browser could navigate one, and section 1 forbids
+# exactly that.
+source_set("sunshine") {
+  public = [ "mouse_gesture.h" ]
+  sources = [ "mouse_gesture.cc" ]
+
+  deps = [
+    "//base",
+    "//components/pref_registry",
+    "//components/prefs",
+    "//components/user_prefs",
+    "//content/public/browser",
+    "//ui/base/mojom:ui_base_types",
+    "//ui/events",
+    "//ui/gfx/geometry",
+  ]
+}
diff --git a/chrome/browser/ui/sunshine/mouse_gesture.cc b/chrome/browser/ui/sunshine/mouse_gesture.cc
new file mode 100644
index 0000000..61c8848
--- /dev/null
+++ b/chrome/browser/ui/sunshine/mouse_gesture.cc
@@ -0,0 +1,176 @@
+// Copyright 2026 The Sunshine Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/sunshine/mouse_gesture.h"
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/context_menu/context_menu.mojom-shared.h"
+#include "ui/base/mojom/menu_source_type.mojom-shared.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+
+namespace sunshine {
+
+namespace {
+
+// GESTURE contract section 3.1, answered with Chromium's own hit test rather
+// than a second one. Every category the contract names as clear context-menu
+// intent has a field here, and a category with no field would be a category
+// this build cannot honour -- which is why the list is written out rather than
+// collapsed into "params has anything interesting".
+bool IsProtectedTarget(const content::ContextMenuParams& params) {
+  return params.link_url.is_valid() || params.unfiltered_link_url.is_valid() ||
+         params.src_url.is_valid() || params.has_image_contents ||
+         params.is_editable || params.form_control_type.has_value() ||
+         !params.selection_text.empty() ||
+         params.media_type != blink::mojom::ContextMenuDataMediaType::kNone;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(prefs::kGesturesEnabled, true);
+  registry->RegisterIntegerPref(prefs::kGesturesActivationDistance,
+                                kDefaultActivationDistance);
+  registry->RegisterBooleanPref(prefs::kGesturesBackEnabled, true);
+  registry->RegisterBooleanPref(prefs::kGesturesForwardEnabled, true);
+}
+
+int ClampActivationDistance(int distance) {
+  return std::clamp(distance, kMinimumActivationDistance,
+                    kMaximumActivationDistance);
+}
+
+MouseGesture::MouseGesture(content::WebContents* contents)
+    : content::WebContentsUserData<MouseGesture>(*contents),
+      prefs_(user_prefs::UserPrefs::Get(contents->GetBrowserContext())) {}
+
+MouseGesture::~MouseGesture() = default;
+
+bool MouseGesture::GesturesEnabled() const {
+  return prefs_ && prefs_->GetBoolean(prefs::kGesturesEnabled);
+}
+
+bool MouseGesture::BindingEnabled(std::string_view command) const {
+  if (!prefs_) {
+    return false;
+  }
+  return command == kBackCommand
+             ? prefs_->GetBoolean(prefs::kGesturesBackEnabled)
+             : prefs_->GetBoolean(prefs::kGesturesForwardEnabled);
+}
+
+int MouseGesture::ActivationDistance() const {
+  return ClampActivationDistance(
+      prefs_ ? prefs_->GetInteger(prefs::kGesturesActivationDistance)
+             : kDefaultActivationDistance);
+}
+
+void MouseGesture::Reset() {
+  state_ = State::kIdle;
+  command_ = std::string_view();
+}
+
+void MouseGesture::Track(const gfx::Point& location) {
+  const int dx = location.x() - origin_.x();
+  const int dy = location.y() - origin_.y();
+  if (std::abs(dx) < ActivationDistance()) {
+    return;
+  }
+  // Travel is sufficient from here on, so the press can no longer end in an
+  // ordinary context menu even if the direction never resolves. Section 3.3
+  // calls that `direction_ambiguous`: no navigation and no menu.
+  state_ = State::kAmbiguous;
+  if (std::abs(dx) < kDirectionRatio * std::abs(dy)) {
+    return;
+  }
+  const std::string_view command = dx < 0 ? kBackCommand : kForwardCommand;
+  if (!BindingEnabled(command)) {
+    // A disabled binding must leave the press behaving unusually in no way at
+    // all -- section 5 -- so this is not an ambiguous gesture, it is not a
+    // gesture.
+    Reset();
+    return;
+  }
+  command_ = command;
+  state_ = State::kRecognised;
+}
+
+void MouseGesture::OnMouseEvent(const ui::Event& event) {
+  if (!event.IsMouseEvent()) {
+    return;
+  }
+  const ui::MouseEvent& mouse = *event.AsMouseEvent();
+  switch (mouse.type()) {
+    case ui::EventType::kMousePressed:
+      // Any press ends whatever was pending. That is invariant 12 -- gesture
+      // state is transient -- and it is also what stops a recognition that
+      // never met a context menu from being applied to someone else's.
+      Reset();
+      if (GesturesEnabled() && mouse.IsOnlyRightMouseButton() &&
+          (mouse.changed_button_flags() & ui::EF_RIGHT_MOUSE_BUTTON)) {
+        origin_ = mouse.root_location();
+        state_ = State::kTracking;
+      }
+      break;
+    case ui::EventType::kMouseDragged:
+      if (state_ == State::kTracking) {
+        Track(mouse.root_location());
+      }
+      break;
+    case ui::EventType::kMouseReleased:
+      if (state_ == State::kTracking) {
+        // Released below the activation distance: the deferred context menu is
+        // the whole of what this press does.
+        Reset();
+      }
+      break;
+    case ui::EventType::kMouseCaptureChanged:
+    case ui::EventType::kMouseExited:
+      // Section 3.3 `focus_lost`, and the cancellation a native drag session
+      // produces, which reaches this class as capture moving elsewhere.
+      Reset();
+      break;
+    default:
+      break;
+  }
+}
+
+MouseGesture::Decision MouseGesture::DecideContextMenu(
+    const content::ContextMenuParams& params) {
+  const State state = state_;
+  const std::string_view command = command_;
+  Reset();
+
+  // A menu the keyboard asked for was never a gesture, and swallowing it would
+  // be this feature reaching a surface it has no business in.
+  if (params.source_type != ui::mojom::MenuSourceType::kMouse) {
+    return Decision();
+  }
+  if (state == State::kAmbiguous) {
+    return Decision{.suppress_menu = true, .command = std::string_view()};
+  }
+  if (state != State::kRecognised) {
+    return Decision();
+  }
+  // Section 3.1: where intent is ambiguous the context menu wins, and a press
+  // that landed on something with its own menu entries is not ambiguous at all.
+  if (IsProtectedTarget(params)) {
+    return Decision();
+  }
+  return Decision{.suppress_menu = true, .command = command};
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(MouseGesture);
+
+}  // namespace sunshine
