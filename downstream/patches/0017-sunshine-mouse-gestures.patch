@@ -0,0 +1,133 @@
+// Copyright 2026 The Sunshine Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SUNSHINE_MOUSE_GESTURE_H_
+#define CHROME_BROWSER_UI_SUNSHINE_MOUSE_GESTURE_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/geometry/point.h"
+
+namespace content {
+struct ContextMenuParams;
+}  // namespace content
+
+namespace ui {
+class Event;
+}  // namespace ui
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace sunshine {
+
+// The command identifiers this feature may resolve, spelled exactly as
+// `first_party/commands.json` registers them. GESTURE contract invariant 6
+// makes a binding to anything else a build failure rather than a special case,
+// and `scripts/verify_gesture_bindings.py` is what decides that offline.
+inline constexpr char kBackCommand[] = "browser.back";
+inline constexpr char kForwardCommand[] = "browser.forward";
+
+namespace prefs {
+inline constexpr char kGesturesEnabled[] = "sunshine.gestures.enabled";
+inline constexpr char kGesturesActivationDistance[] =
+    "sunshine.gestures.activation_distance";
+inline constexpr char kGesturesBackEnabled[] =
+    "sunshine.gestures.binding.back.enabled";
+inline constexpr char kGesturesForwardEnabled[] =
+    "sunshine.gestures.binding.forward.enabled";
+}  // namespace prefs
+
+// GESTURE contract section 3.2. The default is deliberately far larger than a
+// click can drift: a threshold that is too high wastes a deliberate movement,
+// while one that is too low steals a context menu, and only the second
+// silently does the wrong thing.
+inline constexpr int kDefaultActivationDistance = 200;
+inline constexpr int kMinimumActivationDistance = 20;
+inline constexpr int kMaximumActivationDistance = 600;
+
+// One axis must dominate the other by this much or the direction is
+// unresolvable. Section 3.2 states it is not tunable without amending the
+// contract, so it is a constant here and not a preference.
+inline constexpr int kDirectionRatio = 2;
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Section 3.2: out-of-range input is clamped to the nearest bound and never
+// refused, because a setting that rejects a number is a worse experience than
+// one that quietly honours the nearest legal value.
+int ClampActivationDistance(int distance);
+
+// Recognises the one pointer pattern this wave supports and resolves it to a
+// command identifier. It observes; it never consumes, rewrites, reorders or
+// synthesises an event, and the hook it is driven from -- Browser's
+// ContentsMouseEvent -- returns void, so that property is structural rather
+// than promised.
+//
+// The decision is taken when the context menu would be shown, not when the
+// button is released, and that is the design's whole point. On Windows the
+// menu is raised on mouse up (`context_menu_on_mouse_up` defaults to
+// BUILDFLAG(IS_WIN)), so by then Chromium has already hit-tested what is under
+// the pointer and reports it in ContextMenuParams. Asking that structure is
+// how the contract's "a gesture never fires on a link, an image, a media
+// element, an editable field or a selection" is honoured *using Chromium's own
+// answer*, rather than by re-implementing a hit test in the browser process.
+class MouseGesture : public content::WebContentsUserData<MouseGesture> {
+ public:
+  // What a context menu request should do. At most one command per press, and
+  // a press that dispatched one cannot also produce a menu -- invariant 9,
+  // expressed as a single value so the two cannot disagree.
+  struct Decision {
+    bool suppress_menu = false;
+    std::string_view command;
+  };
+
+  MouseGesture(const MouseGesture&) = delete;
+  MouseGesture& operator=(const MouseGesture&) = delete;
+  ~MouseGesture() override;
+
+  void OnMouseEvent(const ui::Event& event);
+
+  // Consumes the pending recognition, whatever it was. Called once per context
+  // menu request; the state does not survive it.
+  Decision DecideContextMenu(const content::ContextMenuParams& params);
+
+ private:
+  friend WebContentsUserData;
+
+  // Section 3. `kAmbiguous` is the state that carries "travel was sufficient
+  // but no axis dominated", which owes the user neither a navigation nor a
+  // menu.
+  enum class State { kIdle, kTracking, kRecognised, kAmbiguous };
+
+  explicit MouseGesture(content::WebContents* contents);
+
+  bool GesturesEnabled() const;
+  bool BindingEnabled(std::string_view command) const;
+  int ActivationDistance() const;
+  void Track(const gfx::Point& location);
+  void Reset();
+
+  // Read once. The browser context outlives the WebContents this is attached
+  // to, and the alternative -- looking the service up per event -- would have
+  // to be done from a const method on a const WebContents&, which cannot reach
+  // a non-const GetBrowserContext().
+  const raw_ptr<PrefService> prefs_;
+
+  State state_ = State::kIdle;
+  gfx::Point origin_;
+  std::string_view command_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace sunshine
+
+#endif  // CHROME_BROWSER_UI_SUNSHINE_MOUSE_GESTURE_H_
