@@ -20,6 +20,20 @@
         <span>Modules</span><span id="moduleCount" class="count"></span>
       </div>
       <ul id="navList"></ul>
+
+      <!-- The only route to the module shell that is not typing its address.
+           It sits below the list rather than in it because the shell is not a
+           module: it is what a module is mounted into, and putting it among
+           the modules would make the registry disagree with the page about how
+           many there are.
+
+           A written-out link, not a control app.ts builds. Nothing about it
+           comes from the registry, so it is outside MH-4 by construction, and
+           it mutates nothing, so it is outside MH-1 as well -- see
+           docs/MODULE_HOME_CONTRACT.md section 3. -->
+      <a id="shellLink" class="navlink" href="chrome://sunshine-shell/">
+        Open the module shell
+      </a>
     </nav>
 
     <main id="main">
