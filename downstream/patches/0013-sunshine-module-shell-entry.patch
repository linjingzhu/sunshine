+/* A link, drawn like the list items above it so that the column reads as one
+ * thing, and separated by a rule so that it is not mistaken for a module. */
+.navlink {
+  border-radius: 0.5rem;
+  color: var(--color-secondary-foreground);
+  display: block;
+  font-size: 0.875rem;
+  margin-block-start: 0.75rem;
+  padding: 0.5rem 0.75rem;
+  text-decoration: none;
+}
+
+.navlink:hover {
+  background-color: var(--color-midground);
+  color: inherit;
+}
+
 .tile {
   block-size: 1.25rem;
   border: 1px solid var(--color-secondary-foreground);
diff --git a/chrome/browser/resources/sunshine/modules/app.html b/chrome/browser/resources/sunshine/modules/app.html
